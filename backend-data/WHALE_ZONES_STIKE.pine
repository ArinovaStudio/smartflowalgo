// Stable displayed zone state.
var float mapBuyTop = na
var float mapBuyBot = na
var int mapBuyTime = na
var string mapBuyTF = "--"

var float mapSellTop = na
var float mapSellBot = na
var int mapSellTime = na
var string mapSellTF = "--"

bool mapBuyInvalid = not na(mapBuyBot) and barstate.isconfirmed and close < mapBuyBot
bool mapSellInvalid = not na(mapSellTop) and barstate.isconfirmed and close > mapSellTop

if barstate.isconfirmed
    float currentBuyScore = f_mapScore(mapBuyTop, mapBuyBot, mapBuyTime, mapBuyTF, false)
    float currentSellScore = f_mapScore(mapSellTop, mapSellBot, mapSellTime, mapSellTF, true)

    bool rawBuyDifferent = rawMapBuyTime != mapBuyTime or rawMapBuyTF != mapBuyTF or rawMapBuyTop != mapBuyTop or rawMapBuyBot != mapBuyBot
    bool rawSellDifferent = rawMapSellTime != mapSellTime or rawMapSellTF != mapSellTF or rawMapSellTop != mapSellTop or rawMapSellBot != mapSellBot

    // 0.25 ATR hysteresis prevents minor 1M/5M flips every candle.
    bool betterBuy = rawMapBuyScore + mapAtrNow * 0.25 < currentBuyScore
    bool betterSell = rawMapSellScore + mapAtrNow * 0.25 < currentSellScore

    bool replaceBuy = na(mapBuyTop) or mapBuyInvalid or (rawBuyDifferent and betterBuy)
    bool replaceSell = na(mapSellTop) or mapSellInvalid or (rawSellDifferent and betterSell)

    if replaceBuy and not na(rawMapBuyTop)
        mapBuyTop := rawMapBuyTop
        mapBuyBot := rawMapBuyBot
        mapBuyTime := rawMapBuyTime
        mapBuyTF := rawMapBuyTF

    if replaceSell and not na(rawMapSellTop)
        mapSellTop := rawMapSellTop
        mapSellBot := rawMapSellBot
        mapSellTime := rawMapSellTime
        mapSellTF := rawMapSellTF

bool priceInMapBuy = not na(mapBuyTop) and not na(mapBuyBot) and close <= mapBuyTop and close >= mapBuyBot
bool priceInMapSell = not na(mapSellTop) and not na(mapSellBot) and close <= mapSellTop and close >= mapSellBot
float mapBuyDistanceNow = f_mapEdgeDistance(mapBuyTop, mapBuyBot, false)
float mapSellDistanceNow = f_mapEdgeDistance(mapSellTop, mapSellBot, true)

//=============================================================================
// SFA 🐋 WHALE ZONES STIKE — SECOND BUY + SECOND SELL MAP
