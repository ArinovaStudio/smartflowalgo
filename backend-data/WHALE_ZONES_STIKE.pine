     chartModelIs15M ? m15BullA :
     chartModelIs30M ? m30BullA :
     chartModelIs1H ? h1BullA :
     chartModelIs4H ? h4BullA :
     chartModelIsD1 ? d1BullA : na

float chartBullC =
