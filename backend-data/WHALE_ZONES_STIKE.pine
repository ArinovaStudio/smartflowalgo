//-----------------------------------------------------------------------------
// OPTIONAL VOLUMETRIC / ORDER FLOW METRICS
// Dashboard-only: does NOT draw on candles, zones, BOS/CHoCH or labels.
// Buy/Sell volume is an intrabar-location estimate from TradingView bar volume.
// POC/Value Area are calculated from a price-bin volume approximation.
//-----------------------------------------------------------------------------
f_orderFlowMetrics(int len, int bins) =>
    float buyVol = 0.0
    float sellVol = 0.0
    float totalVol = 0.0

    float rangeHi = ta.highest(high, len)
    float rangeLo = ta.lowest(low, len)
    float priceRange = math.max(rangeHi - rangeLo, syminfo.mintick * bins)
    float step = priceRange / bins

    array<float> vp = array.new_float(bins, 0.0)

    for i = 0 to len - 1
        float barRange = math.max(high[i] - low[i], syminfo.mintick)
        float buyShare = math.max(0.0, math.min(1.0, (close[i] - low[i]) / barRange))
        float v = nz(volume[i], 0.0)
        buyVol += v * buyShare
        sellVol += v * (1.0 - buyShare)
        totalVol += v

        int idx = int(math.floor((hlc3[i] - rangeLo) / step))
        idx := math.max(0, math.min(bins - 1, idx))
        array.set(vp, idx, array.get(vp, idx) + v)

    int pocIdx = 0
    float maxBinVol = array.get(vp, 0)
    for i = 1 to bins - 1
        float bv = array.get(vp, i)
        if bv > maxBinVol
            maxBinVol := bv
            pocIdx := i

    // Approximate 70% value area expanded outward from POC.
    float targetVA = totalVol * 0.70
    float cumVA = array.get(vp, pocIdx)
    int vaLoIdx = pocIdx
    int vaHiIdx = pocIdx

    for k = 0 to bins - 2
        if cumVA >= targetVA
            break
        float leftVol = vaLoIdx > 0 ? array.get(vp, vaLoIdx - 1) : -1.0
        float rightVol = vaHiIdx < bins - 1 ? array.get(vp, vaHiIdx + 1) : -1.0

        if rightVol > leftVol and vaHiIdx < bins - 1
            vaHiIdx += 1
            cumVA += math.max(0.0, rightVol)
        else if vaLoIdx > 0
            vaLoIdx -= 1
            cumVA += math.max(0.0, leftVol)
        else if vaHiIdx < bins - 1
            vaHiIdx += 1
            cumVA += math.max(0.0, rightVol)

    float buyPct = totalVol > 0 ? buyVol / totalVol * 100.0 : 50.0
    float sellPct = totalVol > 0 ? sellVol / totalVol * 100.0 : 50.0
    float deltaPct = totalVol > 0 ? (buyVol - sellVol) / totalVol * 100.0 : 0.0
    float poc = rangeLo + (pocIdx + 0.5) * step
    float vaLow = rangeLo + vaLoIdx * step
    float vaHigh = rangeLo + (vaHiIdx + 1.0) * step

    [buyPct, sellPct, deltaPct, poc, vaLow, vaHigh]

