//=============================================================================
// SFA MODEL 1 — EXACT A-B-C / BOS / ZONE B / NEXT-CANDLE LOGIC
// Independent from Flight ✈ BUY/SELL.
//
// BULLISH MODEL
//  1) A = confirmed structure high.
//  2) B = subsequent confirmed swing low.
//     The last bearish candle around B defines ZONE B (Demand).
//  3) A clean CLOSED candle breaks above A = BOS.
//  4) C = first confirmed swing high after BOS.
//  5) Price returns to Point B / Zone B.
//  6) Retest candle may wick into B, but must CLOSE back above the invalid side.
//  7) ⚡ confirms on the NEXT source-timeframe candle.
//     Point B remains the official entry/reference; Point C is Target 1.
//
// BEARISH = exact opposite.
//
// CLOSED-CANDLE SAFETY
// A/B/C/BOS/retest are accepted only after their source candle has closed.
// The ⚡ event is then armed for the next source-timeframe candle, so it does
// not flash/repaint intrabar from an unfinished retest candle.
//=============================================================================
f_model1ABC() =>
    // Processes PREVIOUS source candle only -> closed-candle logic.
    var float lastSwingHighM = na
    var int lastSwingHighTimeM = na
    var float lastSwingLowM = na
    var int lastSwingLowTimeM = na

    var float bullA = na
    var float bullB = na
    var float bullC = na
    var float bullZoneTop = na
    var float bullZoneBot = na
    var int bullBTime = na
    var int bullBosTime = na
    var int bullCTime = na
    var int bullRetestTime = na
    var float bullRetestClose = na
    var int bullStage = 0

    var float bearA = na
    var float bearB = na
    var float bearC = na
    var float bearZoneTop = na
    var float bearZoneBot = na
    var int bearBTime = na
    var int bearBosTime = na
    var int bearCTime = na
    var int bearRetestTime = na
    var float bearRetestClose = na
    var int bearStage = 0

    bool canProcess = not na(time[1])

    if canProcess
        float cClose = close[1]
        float cOpen = open[1]
        float cHigh = high[1]
        float cLow = low[1]
        int cTime = time[1]

        float phM = ta.pivothigh(high, modelPivotLeft, modelPivotRight)[1]
        float plM = ta.pivotlow(low, modelPivotLeft, modelPivotRight)[1]
        int pivotOffset = modelPivotRight + 1
        int pTime = time[pivotOffset]

        // ------------------------------------------------------------
        // STAGE 4 -> IMMEDIATE NEXT CLOSED CANDLE CONFIRMATION
        // BUY  : red test candle -> immediate next GREEN candle.
        // SELL : green test candle -> immediate next RED candle.
        // If the immediate next candle does not confirm, go back to Stage 3
        // and wait for a NEW test at Zone B. No late/middle confirmation.
        // ------------------------------------------------------------
        if bullStage == 4 and not na(bullRetestTime) and cTime > bullRetestTime
            bool bullNextGreen = cClose > cOpen and cClose > bullRetestClose
            if bullNextGreen
                bullStage := 5
            else
                bullStage := 3
                bullRetestTime := na
                bullRetestClose := na

        if bearStage == 4 and not na(bearRetestTime) and cTime > bearRetestTime
            bool bearNextRed = cClose < cOpen and cClose < bearRetestClose
            if bearNextRed
                bearStage := 5
            else
                bearStage := 3
                bearRetestTime := na
                bearRetestClose := na

        // ------------------------------------------------------------
        // INVALIDATION — closed candle only
        // ------------------------------------------------------------
        if bullStage > 0 and not na(bullZoneBot) and cClose < bullZoneBot
            bullA := na
            bullB := na
            bullC := na
            bullZoneTop := na
            bullZoneBot := na
            bullBTime := na
            bullBosTime := na
            bullCTime := na
            bullRetestTime := na
            bullRetestClose := na
            bullStage := 0

        if bearStage > 0 and not na(bearZoneTop) and cClose > bearZoneTop
            bearA := na
            bearB := na
            bearC := na
            bearZoneTop := na
            bearZoneBot := na
            bearBTime := na
            bearBosTime := na
            bearCTime := na
            bearRetestTime := na
            bearRetestClose := na
            bearStage := 0

        // ------------------------------------------------------------
        // A-B STRUCTURE
        // ------------------------------------------------------------
        if not na(phM)
            // Bearish Model:
            // A = previous swing low, B = later swing high / SELL Zone B.
            if (bearStage == 0 or bearStage == 1) and
                 not na(lastSwingLowM) and not na(lastSwingLowTimeM) and
                 lastSwingLowTimeM < pTime
                int ob = close[pivotOffset] > open[pivotOffset] ? pivotOffset :
                     close[pivotOffset + 1] > open[pivotOffset + 1] ? pivotOffset + 1 :
                     pivotOffset
                bearA := lastSwingLowM
                bearB := phM
                bearZoneTop := phM
                bearZoneBot := math.min(open[ob], close[ob])
                bearBTime := pTime
                bearBosTime := na
                bearC := na
                bearCTime := na
                bearRetestTime := na
                bearRetestClose := na
                bearStage := 1

            lastSwingHighM := phM
            lastSwingHighTimeM := pTime

        if not na(plM)
            // Bullish Model:
            // A = previous swing high, B = later swing low / BUY Zone B.
            if (bullStage == 0 or bullStage == 1) and
                 not na(lastSwingHighM) and not na(lastSwingHighTimeM) and
                 lastSwingHighTimeM < pTime
                int ob = close[pivotOffset] < open[pivotOffset] ? pivotOffset :
                     close[pivotOffset + 1] < open[pivotOffset + 1] ? pivotOffset + 1 :
                     pivotOffset
                bullA := lastSwingHighM
                bullB := plM
                bullZoneTop := math.max(open[ob], close[ob])
                bullZoneBot := plM
                bullBTime := pTime
                bullBosTime := na
                bullC := na
                bullCTime := na
                bullRetestTime := na
                bullRetestClose := na
                bullStage := 1

            lastSwingLowM := plM
            lastSwingLowTimeM := pTime

        // ------------------------------------------------------------
        // CLOSED BOS
        // ------------------------------------------------------------
        if bullStage == 1 and not na(bullA) and not na(bullBTime) and
             cTime > bullBTime and cClose > bullA
            bullBosTime := cTime
            bullStage := 2

        if bearStage == 1 and not na(bearA) and not na(bearBTime) and
             cTime > bearBTime and cClose < bearA
            bearBosTime := cTime
            bearStage := 2

        // ------------------------------------------------------------
        // POINT C = first confirmed post-BOS expansion extreme.
        // It may extend while waiting for retest.
        // ------------------------------------------------------------
        if bullStage == 2 and not na(bullBosTime) and cTime > bullBosTime
            bullC := cHigh
            bullCTime := cTime
            bullStage := 3
        else if bullStage == 3 and not na(bullC) and cTime > bullBosTime and cHigh > bullC
            bullC := cHigh
            bullCTime := cTime

        if bearStage == 2 and not na(bearBosTime) and cTime > bearBosTime
            bearC := cLow
            bearCTime := cTime
            bearStage := 3
        else if bearStage == 3 and not na(bearC) and cTime > bearBosTime and cLow < bearC
            bearC := cLow
            bearCTime := cTime

        // ------------------------------------------------------------
        // EXACT ZONE-B TEST CANDLE
        //
        // BUY  Zone B: RED test candle, valid close above invalid side.
        // SELL Zone B: GREEN test candle, valid close below invalid side.
        //
        // This is the ONLY candle that can arm Stage 4.
        // ------------------------------------------------------------
        bool bullTouchesZoneB =
             bullStage == 3 and not na(bullCTime) and cTime > bullCTime and
             cLow <= bullZoneTop and cHigh >= bullZoneBot

        bool bearTouchesZoneB =
             bearStage == 3 and not na(bearCTime) and cTime > bearCTime and
             cHigh >= bearZoneBot and cLow <= bearZoneTop

        bool bullRedTest =
             bullTouchesZoneB and cClose < cOpen and cClose >= bullZoneBot

        bool bearGreenTest =
             bearTouchesZoneB and cClose > cOpen and cClose <= bearZoneTop

        if bullRedTest
            bullRetestTime := cTime
            bullRetestClose := cClose
            bullStage := 4

        if bearGreenTest
            bearRetestTime := cTime
            bearRetestClose := cClose
            bearStage := 4

    [bullZoneTop, bullZoneBot, bullA, bullC, bullStage, bullBTime,
     bearZoneTop, bearZoneBot, bearA, bearC, bearStage, bearBTime]

// Seven independent Model 1 engines.
[m1BullTop, m1BullBot, m1BullA, m1BullC, m1BullStage, m1BullBTime, m1BearTop, m1BearBot, m1BearA, m1BearC, m1BearStage, m1BearBTime] = request.security(syminfo.tickerid, "1", f_model1ABC(), barmerge.gaps_off, barmerge.lookahead_off)
[m5BullTopM, m5BullBotM, m5BullA, m5BullC, m5BullStage, m5BullBTime, m5BearTopM, m5BearBotM, m5BearA, m5BearC, m5BearStage, m5BearBTime] = request.security(syminfo.tickerid, "5", f_model1ABC(), barmerge.gaps_off, barmerge.lookahead_off)
[m15BullTopM, m15BullBotM, m15BullA, m15BullC, m15BullStage, m15BullBTime, m15BearTopM, m15BearBotM, m15BearA, m15BearC, m15BearStage, m15BearBTime] = request.security(syminfo.tickerid, "15", f_model1ABC(), barmerge.gaps_off, barmerge.lookahead_off)
[m30BullTop, m30BullBot, m30BullA, m30BullC, m30BullStage, m30BullBTime, m30BearTop, m30BearBot, m30BearA, m30BearC, m30BearStage, m30BearBTime] = request.security(syminfo.tickerid, "30", f_model1ABC(), barmerge.gaps_off, barmerge.lookahead_off)
[h1BullTopM, h1BullBotM, h1BullA, h1BullC, h1BullStage, h1BullBTime, h1BearTopM, h1BearBotM, h1BearA, h1BearC, h1BearStage, h1BearBTime] = request.security(syminfo.tickerid, "60", f_model1ABC(), barmerge.gaps_off, barmerge.lookahead_off)
[h4BullTopM, h4BullBotM, h4BullA, h4BullC, h4BullStage, h4BullBTime, h4BearTopM, h4BearBotM, h4BearA, h4BearC, h4BearStage, h4BearBTime] = request.security(syminfo.tickerid, "240", f_model1ABC(), barmerge.gaps_off, barmerge.lookahead_off)
[d1BullTop, d1BullBot, d1BullA, d1BullC, d1BullStage, d1BullBTime, d1BearTop, d1BearBot, d1BearA, d1BearC, d1BearStage, d1BearBTime] = request.security(syminfo.tickerid, "D", f_model1ABC(), barmerge.gaps_off, barmerge.lookahead_off)

//=============================================================================
// MAIN MODEL = CURRENT CHART TIMEFRAME ONLY
//
// IMPORTANT:
// • The 7 Model engines above continue to run for status/scanner context.
// • The large Model-1 dashboard, visible Model Zone B, ⚡ signal, Model P/L,
//   BE and Model alerts use ONLY the chart timeframe.
// • Therefore a 1M signal can NEVER appear as the main signal on a 15M chart.
//=============================================================================
bool chartModelIs1M  = timeframe.period == "1"
bool chartModelIs5M  = timeframe.period == "5"
bool chartModelIs15M = timeframe.period == "15"
bool chartModelIs30M = timeframe.period == "30"
bool chartModelIs1H  = timeframe.period == "60"
bool chartModelIs4H  = timeframe.period == "240"
bool chartModelIsD1  = timeframe.period == "D"
bool chartModelSupported = chartModelIs1M or chartModelIs5M or chartModelIs15M or
     chartModelIs30M or chartModelIs1H or chartModelIs4H or chartModelIsD1

string chartModelTF =
     chartModelIs1M ? "1M" :
     chartModelIs5M ? "5M" :
     chartModelIs15M ? "15M" :
     chartModelIs30M ? "30M" :
     chartModelIs1H ? "1H" :
     chartModelIs4H ? "4H" :
     chartModelIsD1 ? "D1" : "UNSUPPORTED"

float chartBullTop =
     chartModelIs1M ? m1BullTop :
     chartModelIs5M ? m5BullTopM :
     chartModelIs15M ? m15BullTopM :
     chartModelIs30M ? m30BullTop :
     chartModelIs1H ? h1BullTopM :
     chartModelIs4H ? h4BullTopM :
     chartModelIsD1 ? d1BullTop : na

float chartBullBot =
     chartModelIs1M ? m1BullBot :
     chartModelIs5M ? m5BullBotM :
     chartModelIs15M ? m15BullBotM :
     chartModelIs30M ? m30BullBot :
     chartModelIs1H ? h1BullBotM :
     chartModelIs4H ? h4BullBotM :
     chartModelIsD1 ? d1BullBot : na

float chartBullA =
     chartModelIs1M ? m1BullA :
