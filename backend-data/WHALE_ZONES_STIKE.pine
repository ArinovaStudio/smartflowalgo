//-----------------------------------------------------------------------------
// HELPERS
//-----------------------------------------------------------------------------
f_zoneData() =>
    float atrv = ta.atr(14)
    float ph = ta.pivothigh(high, pivotLeft, pivotRight)
    float pl = ta.pivotlow(low, pivotLeft, pivotRight)
    int pht = not na(ph) ? time[pivotRight] : na
    int plt = not na(pl) ? time[pivotRight] : na
    [ph, pl, atrv, pht, plt]

f_continuousZones() =>
    float atrv = ta.atr(14)
    float ph = ta.pivothigh(high, pivotLeft, pivotRight)
    float pl = ta.pivotlow(low, pivotLeft, pivotRight)

    var array<float> sellTops = array.new_float()
    var array<float> sellBots = array.new_float()
    var array<int> sellTimes = array.new_int()
    var array<float> buyTops = array.new_float()
    var array<float> buyBots = array.new_float()
    var array<int> buyTimes = array.new_int()

    if not na(ph)
        array.push(sellTops, ph)
        array.push(sellBots, ph - atrv * zoneAtrMult)
        array.push(sellTimes, time[pivotRight])

    if not na(pl)
        array.push(buyTops, pl + atrv * zoneAtrMult)
        array.push(buyBots, pl)
        array.push(buyTimes, time[pivotRight])

    while array.size(sellTops) > 60
        array.shift(sellTops)
        array.shift(sellBots)
        array.shift(sellTimes)

    while array.size(buyTops) > 60
        array.shift(buyTops)
        array.shift(buyBots)
        array.shift(buyTimes)

    if deleteBroken and array.size(sellTops) > 0
        int i = array.size(sellTops) - 1
        while i >= 0
            if close > array.get(sellTops, i)
                array.remove(sellTops, i)
                array.remove(sellBots, i)
                array.remove(sellTimes, i)
            i -= 1

    if deleteBroken and array.size(buyBots) > 0
        int i = array.size(buyBots) - 1
        while i >= 0
            if close < array.get(buyBots, i)
                array.remove(buyTops, i)
                array.remove(buyBots, i)
                array.remove(buyTimes, i)
            i -= 1

    float activeSellTop = na
    float activeSellBot = na
    int activeSellTime = na
    float bestSellDist = 1e20

    if array.size(sellTops) > 0
        for i = 0 to array.size(sellTops) - 1
            float sTop = array.get(sellTops, i)
            float sBot = array.get(sellBots, i)
            if close <= sTop
                float d = close >= sBot ? 0.0 : sBot - close
                if d < bestSellDist
                    bestSellDist := d
                    activeSellTop := sTop
                    activeSellBot := sBot
                    activeSellTime := array.get(sellTimes, i)

    float activeBuyTop = na
    float activeBuyBot = na
    int activeBuyTime = na
    float bestBuyDist = 1e20

    if array.size(buyTops) > 0
        for i = 0 to array.size(buyTops) - 1
            float bTop = array.get(buyTops, i)
            float bBot = array.get(buyBots, i)
            if close >= bBot
                float d = close <= bTop ? 0.0 : close - bTop
                if d < bestBuyDist
                    bestBuyDist := d
                    activeBuyTop := bTop
                    activeBuyBot := bBot
                    activeBuyTime := array.get(buyTimes, i)

    [activeSellTop, activeSellBot, activeSellTime, activeBuyTop, activeBuyBot, activeBuyTime]

f_trend(tf) =>
    float c = request.security(syminfo.tickerid, tf, close, barmerge.gaps_off, barmerge.lookahead_off)
    float e = request.security(syminfo.tickerid, tf, ta.ema(close, 200), barmerge.gaps_off, barmerge.lookahead_off)
    c >= e ? 1 : -1

f_adx5m() =>
    [plusDI, minusDI, adxVal] = ta.dmi(adxLen, adxLen)
    adxVal

f_dashSize() =>
    dashSizeOpt == "Tiny" ? size.tiny :
     dashSizeOpt == "Small" ? size.small :
     dashSizeOpt == "Large" ? size.large : size.normal

f_dashPos() =>
    dashPosOpt == "Top Left" ? position.top_left :
     dashPosOpt == "Bottom Right" ? position.bottom_right :
     dashPosOpt == "Bottom Left" ? position.bottom_left : position.top_right

f_confirmSize() =>
    confirmedSignalSize == "Tiny" ? size.tiny :
     confirmedSignalSize == "Small" ? size.small :
     confirmedSignalSize == "Large" ? size.large : size.normal


f_makeZone(box oldBox, int leftTime, float top, float bottom, bool isSell, string tfName) =>
    if not na(oldBox)
        box.delete(oldBox)
    box.new(left=leftTime, top=top, right=time, bottom=bottom,
      xloc=xloc.bar_time, extend=extend.right,
      bgcolor=isSell ? sellFill : buyFill,
      border_color=isSell ? sellBorder : buyBorder,
      border_width=2,
      text=isSell ? "↓ DOWN" : "↑ UP CONTINUE",
      text_color=color.black,
      text_size=size.normal,
      text_halign=text.align_left,
      text_valign=text.align_center)

//-----------------------------------------------------------------------------
// OPTIONAL EMA 50 / EMA 200
//-----------------------------------------------------------------------------
// Display only. These EMAs do not affect any private signal/trade logic.
ema50 = ta.ema(close, 50)
plot(showEMA50 ? ema50 : na, "EMA 50", color=ema50Color, linewidth=2)

ema200 = ta.ema(close, 200)
plot(showEMA200 ? ema200 : na, "EMA 200", color=ema200Color, linewidth=3)


//-----------------------------------------------------------------------------
// PREVIOUS DAY HIGH / LOW
//-----------------------------------------------------------------------------
pdh = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],  barmerge.gaps_off, barmerge.lookahead_on)

// Clean PDH/PDL: horizontal only. No purple vertical connector at day change.
newDay = ta.change(time("D")) != 0

var line pdhLine = na
var line pdlLine = na
var label pdhLabel = na
var label pdlLabel = na

if newDay or barstate.isfirst
    if not na(pdhLine)
        line.delete(pdhLine)
    if not na(pdlLine)
        line.delete(pdlLine)
    if not na(pdhLabel)
        label.delete(pdhLabel)
    if not na(pdlLabel)
        label.delete(pdlLabel)

    pdhLine := na
    pdlLine := na
    pdhLabel := na
    pdlLabel := na

if showPDH and not na(pdh)
    if na(pdhLine)
        pdhLine := line.new(bar_index, pdh, bar_index + 1, pdh,
          xloc=xloc.bar_index, extend=extend.right,
          color=color.blue, width=1, style=line.style_dashed)
    else
        line.set_y1(pdhLine, pdh)
        line.set_y2(pdhLine, pdh)

    if na(pdhLabel)
        pdhLabel := label.new(bar_index, pdh, "PREVIOUS DAY HIGH (PDH)",
          style=label.style_label_left,
          color=color.rgb(25, 80, 190),
          textcolor=color.white,
          size=size.tiny)
    else
        label.set_xy(pdhLabel, bar_index, pdh)
        label.set_text(pdhLabel, "PREVIOUS DAY HIGH (PDH)")

if showPDL and not na(pdl)
    if na(pdlLine)
        pdlLine := line.new(bar_index, pdl, bar_index + 1, pdl,
          xloc=xloc.bar_index, extend=extend.right,
          color=color.orange, width=1, style=line.style_dashed)
    else
        line.set_y1(pdlLine, pdl)
        line.set_y2(pdlLine, pdl)

    if na(pdlLabel)
        pdlLabel := label.new(bar_index, pdl, "PREVIOUS DAY LOW (PDL)",
          style=label.style_label_left,
          color=color.rgb(190, 95, 0),
          textcolor=color.white,
          size=size.tiny)
    else
        label.set_xy(pdlLabel, bar_index, pdl)
        label.set_text(pdlLabel, "PREVIOUS DAY LOW (PDL)")

//-----------------------------------------------------------------------------
// MTF ZONE DATA — CONTINUOUS ACTIVE BUY / SELL SUPPORT & RESISTANCE
// ALWAYS-ON MARKET ZONE MAP:
// 1M / 5M / 15M / 30M / 1H / 4H / D1
//
// IMPORTANT:
// These continuous zones are the ALWAYS-VISIBLE market map.
// The A-B-C Model 1 engine below is a SEPARATE confirmation layer.
//-----------------------------------------------------------------------------
[m1SellTopRaw, m1SellBotRaw, m1SellTimeRaw, m1BuyTopRaw, m1BuyBotRaw, m1BuyTimeRaw] = request.security(syminfo.tickerid, "1", f_continuousZones(), barmerge.gaps_off, barmerge.lookahead_off)
[m5SellTopRaw, m5SellBotRaw, m5SellTimeRaw, m5BuyTopRaw, m5BuyBotRaw, m5BuyTimeRaw] = request.security(syminfo.tickerid, "5", f_continuousZones(), barmerge.gaps_off, barmerge.lookahead_off)
[m15SellTopRaw, m15SellBotRaw, m15SellTimeRaw, m15BuyTopRaw, m15BuyBotRaw, m15BuyTimeRaw] = request.security(syminfo.tickerid, "15", f_continuousZones(), barmerge.gaps_off, barmerge.lookahead_off)
[m30SellTopRaw, m30SellBotRaw, m30SellTimeRaw, m30BuyTopRaw, m30BuyBotRaw, m30BuyTimeRaw] = request.security(syminfo.tickerid, "30", f_continuousZones(), barmerge.gaps_off, barmerge.lookahead_off)
[h1SellTopRaw, h1SellBotRaw, h1SellTimeRaw, h1BuyTopRaw, h1BuyBotRaw, h1BuyTimeRaw] = request.security(syminfo.tickerid, "60", f_continuousZones(), barmerge.gaps_off, barmerge.lookahead_off)
[h4SellTopRaw, h4SellBotRaw, h4SellTimeRaw, h4BuyTopRaw, h4BuyBotRaw, h4BuyTimeRaw] = request.security(syminfo.tickerid, "240", f_continuousZones(), barmerge.gaps_off, barmerge.lookahead_off)
[d1SellTopRaw, d1SellBotRaw, d1SellTimeRaw, d1BuyTopRaw, d1BuyBotRaw, d1BuyTimeRaw] = request.security(syminfo.tickerid, "D", f_continuousZones(), barmerge.gaps_off, barmerge.lookahead_off)

float m1SellTop = show1mZones ? m1SellTopRaw : na
float m1SellBot = show1mZones ? m1SellBotRaw : na
float m1BuyTop = show1mZones ? m1BuyTopRaw : na
float m1BuyBot = show1mZones ? m1BuyBotRaw : na

float m5SellTop = show5mZones ? m5SellTopRaw : na
float m5SellBot = show5mZones ? m5SellBotRaw : na
float m5BuyTop = show5mZones ? m5BuyTopRaw : na
float m5BuyBot = show5mZones ? m5BuyBotRaw : na

float m15SellTop = show15mZones ? m15SellTopRaw : na
float m15SellBot = show15mZones ? m15SellBotRaw : na
float m15BuyTop = show15mZones ? m15BuyTopRaw : na
float m15BuyBot = show15mZones ? m15BuyBotRaw : na

float m30SellTop = show30mZones ? m30SellTopRaw : na
float m30SellBot = show30mZones ? m30SellBotRaw : na
float m30BuyTop = show30mZones ? m30BuyTopRaw : na
float m30BuyBot = show30mZones ? m30BuyBotRaw : na

float h1SellTop = show1hZones ? h1SellTopRaw : na
float h1SellBot = show1hZones ? h1SellBotRaw : na
float h1BuyTop = show1hZones ? h1BuyTopRaw : na
float h1BuyBot = show1hZones ? h1BuyBotRaw : na

float h4SellTop = show4hZones ? h4SellTopRaw : na
float h4SellBot = show4hZones ? h4SellBotRaw : na
float h4BuyTop = show4hZones ? h4BuyTopRaw : na
float h4BuyBot = show4hZones ? h4BuyBotRaw : na

float d1SellTop = showD1Zones ? d1SellTopRaw : na
float d1SellBot = showD1Zones ? d1SellBotRaw : na
float d1BuyTop = showD1Zones ? d1BuyTopRaw : na
float d1BuyBot = showD1Zones ? d1BuyBotRaw : na

// Original hidden MTF boxes remain disabled. Flight still uses its preserved
// internal zone/control logic. The new visible map is drawn later.
var box b5S = na
var box b5D = na
var box b15S = na
var box b15D = na
var box b1hS = na
var box b1hD = na
var box b4hS = na
var box b4hD = na

f_syncZoneBox(box bx, bool enabled, int leftTime, float top, float bottom, bool isSell, string tfName) =>
    box result = bx
    bool valid = enabled and not na(leftTime) and not na(top) and not na(bottom)
    if valid
        bool recreate = na(result)
        if not recreate
            recreate := box.get_left(result) != leftTime or math.abs(box.get_top(result) - top) > syminfo.mintick or math.abs(box.get_bottom(result) - bottom) > syminfo.mintick
        if recreate
            if not na(result)
                box.delete(result)
            result := f_makeZone(na, leftTime, top, bottom, isSell, tfName)
    else
        if not na(result)
            box.delete(result)
            result := na
    result

b5S := f_syncZoneBox(b5S, drawOriginalMtfBoxes and show5mZones, m5SellTimeRaw, m5SellTop, m5SellBot, true, "5M")
b5D := f_syncZoneBox(b5D, drawOriginalMtfBoxes and show5mZones, m5BuyTimeRaw, m5BuyTop, m5BuyBot, false, "5M")
b15S := f_syncZoneBox(b15S, drawOriginalMtfBoxes and show15mZones, m15SellTimeRaw, m15SellTop, m15SellBot, true, "15M")
b15D := f_syncZoneBox(b15D, drawOriginalMtfBoxes and show15mZones, m15BuyTimeRaw, m15BuyTop, m15BuyBot, false, "15M")
b1hS := f_syncZoneBox(b1hS, drawOriginalMtfBoxes and show1hZones, h1SellTimeRaw, h1SellTop, h1SellBot, true, "1H")
b1hD := f_syncZoneBox(b1hD, drawOriginalMtfBoxes and show1hZones, h1BuyTimeRaw, h1BuyTop, h1BuyBot, false, "1H")
b4hS := f_syncZoneBox(b4hS, drawOriginalMtfBoxes and show4hZones, h4SellTimeRaw, h4SellTop, h4SellBot, true, "4H")
b4hD := f_syncZoneBox(b4hD, drawOriginalMtfBoxes and show4hZones, h4BuyTimeRaw, h4BuyTop, h4BuyBot, false, "4H")

//-----------------------------------------------------------------------------
// ORIGINAL REVERSAL ENTRY ZONES ENGINE — LOGIC PRESERVED
// Only label text/color is changed to AK branding. Reversal dashboard is omitted.
//-----------------------------------------------------------------------------
revPresetATR = revPreset == "Very Low" ? 3.5 : 2.8
revPresetPct = revPreset == "Very Low" ? 0.02 : 0.015
revAtrNow = ta.atr(revAtrLen)
revThreshold = math.max(close * revPresetPct / 100.0, math.max(revCustomAbs, revPresetATR * revAtrNow))

revHiBase = revCalcMode == "High/Low" ? high : ta.ema(high, revAvgLen)
revLoBase = revCalcMode == "High/Low" ? low  : ta.ema(low, revAvgLen)
revHiRef = revHiBase[revConfirmBars]
revLoRef = revLoBase[revConfirmBars]
revHiRawRef = high[revConfirmBars]
revLoRawRef = low[revConfirmBars]

var float revRunHigh = na
var float revRunLow = na
var float revRunHighRaw = na
var float revRunLowRaw = na
var int revRunHighBar = na
var int revRunLowBar = na
var int revSwingDir = 1

var float revConfirmedPivot = na
var float revConfirmedPivotRaw = na
var int revConfirmedPivotBar = na
var bool revConfirmedPivotIsHigh = false
bool revPivotReady = false

if not na(revHiRef) and not na(revLoRef)
    if na(revRunHigh) or na(revRunLow)
        revRunHigh := revHiRef
        revRunLow := revLoRef
        revRunHighRaw := revHiRawRef
        revRunLowRaw := revLoRawRef
        revRunHighBar := bar_index - revConfirmBars
        revRunLowBar := bar_index - revConfirmBars
        revSwingDir := 1

    if revSwingDir == 1
        if revHiRef > revRunHigh
            revRunHigh := revHiRef
            revRunHighRaw := revHiRawRef
            revRunHighBar := bar_index - revConfirmBars

        if revRunHigh - revLoRef >= revThreshold
            revConfirmedPivot := revRunHigh
            revConfirmedPivotRaw := revRunHighRaw
            revConfirmedPivotBar := revRunHighBar
            revConfirmedPivotIsHigh := true
            revPivotReady := true
            revSwingDir := -1
            revRunLow := revLoRef
            revRunLowRaw := revLoRawRef
            revRunLowBar := bar_index - revConfirmBars
    else
        if revLoRef < revRunLow
            revRunLow := revLoRef
            revRunLowRaw := revLoRawRef
            revRunLowBar := bar_index - revConfirmBars

        if revHiRef - revRunLow >= revThreshold
            revConfirmedPivot := revRunLow
            revConfirmedPivotRaw := revRunLowRaw
            revConfirmedPivotBar := revRunLowBar
            revConfirmedPivotIsHigh := false
            revPivotReady := true
            revSwingDir := 1
            revRunHigh := revHiRef
            revRunHighRaw := revHiRawRef
            revRunHighBar := bar_index - revConfirmBars

bool akBuySignal = revPivotReady and not revConfirmedPivotIsHigh
bool akSellSignal = revPivotReady and revConfirmedPivotIsHigh

var array<line> revLines = array.new<line>()
var array<line> revGlowLines = array.new<line>()
var array<box> revCoreBoxes = array.new<box>()
var array<box> revOuterBoxes = array.new<box>()
var array<box> revZoneBoxes = array.new<box>()
var array<label> revLabels = array.new<label>()

var int akLastDir = 0
var float akLastEntryPrice = na
var int akLastSignalBar = na

if revPivotReady
    bool revIsBull = not revConfirmedPivotIsHigh
    float revCenter = revConfirmedPivotRaw
    akLastDir := revIsBull ? 1 : -1
    akLastEntryPrice := close
    akLastSignalBar := bar_index

    float revCoreHalf = math.max(revAtrNow * 0.12, math.abs(revCenter) * 0.00015)
    float revOuterHalf = revCoreHalf * 2.15
    color revCol = revIsBull ? akBuyColor : akSellColor

    box revOuter = showAKGraphics ? box.new(revConfirmedPivotBar, revCenter + revOuterHalf,
         revConfirmedPivotBar + revLevelExtend, revCenter - revOuterHalf,
         xloc=xloc.bar_index, bgcolor=color.new(revCol, 94),
         border_color=color.new(revCol, 72), border_width=1) : na
    if not na(revOuter)
        array.push(revOuterBoxes, revOuter)

    box revCore = showAKGraphics ? box.new(revConfirmedPivotBar, revCenter + revCoreHalf,
         revConfirmedPivotBar + revLevelExtend, revCenter - revCoreHalf,
         xloc=xloc.bar_index, bgcolor=color.new(revCol, 84),
         border_color=color.new(revCol, 24), border_width=2) : na
    if not na(revCore)
        array.push(revCoreBoxes, revCore)

    // Requested replacement: bullish/bearish reversal wording -> AK only.
    label revLbl = showAKGraphics ? label.new(revConfirmedPivotBar,
         revIsBull ? revCenter - revOuterHalf : revCenter + revOuterHalf,
         "AK",
         style=revIsBull ? label.style_label_up : label.style_label_down,
         color=color.new(revCol, 4), textcolor=color.white, size=size.normal,
         xloc=xloc.bar_index,
         tooltip=revIsBull ? "AK bullish reversal origin / watch area" : "AK bearish reversal origin / watch area") : na
    if not na(revLbl)
        array.push(revLabels, revLbl)

    line revGlow = showAKGraphics ? line.new(revConfirmedPivotBar, revCenter,
         revConfirmedPivotBar + revLevelExtend, revCenter,
         xloc=xloc.bar_index, extend=extend.none,
         color=color.new(revCol, 84), width=8, style=line.style_solid) : na
    if not na(revGlow)
        array.push(revGlowLines, revGlow)

    line revMain = showAKGraphics ? line.new(revConfirmedPivotBar, revCenter,
         revConfirmedPivotBar + revLevelExtend, revCenter,
         xloc=xloc.bar_index, extend=extend.none,
         color=revCol, width=revLineWidth, style=line.style_solid) : na
    if not na(revMain)
        array.push(revLines, revMain)

    if revShowZones and showAKGraphics
        float revZoneHalf = (revCenter * revZoneThicknessPct / 100.0) / 2.0
        box revZone = box.new(revConfirmedPivotBar, revCenter + revZoneHalf,
             revConfirmedPivotBar + revZoneExtend, revCenter - revZoneHalf,
             xloc=xloc.bar_index, bgcolor=color.new(revCol, 89),
             border_color=color.new(revCol, 34), border_width=1)
        array.push(revZoneBoxes, revZone)

    // PRIVATE FIX: AK remains on reversal origin; BUY/SELL prints NOW on confirmation candle.
    if showPrivateConfirmedSignal
        float confirmPad = math.max(ta.atr(14) * 0.18, syminfo.mintick * 10)
        label.new(bar_index,
             revIsBull ? low - confirmPad : high + confirmPad,
             revIsBull ? "BUY" : "SELL",
             xloc=xloc.bar_index,
             style=revIsBull ? label.style_label_up : label.style_label_down,
             color=revIsBull ? color.lime : color.red,
             textcolor=color.white,
             size=f_confirmSize(),
             tooltip=revIsBull ? "Confirmed BUY - available on this candle" : "Confirmed SELL - available on this candle")

while array.size(revLines) > revMaxLevels
    line.delete(array.shift(revLines))
while array.size(revGlowLines) > revMaxLevels
    line.delete(array.shift(revGlowLines))
while array.size(revCoreBoxes) > revMaxLevels
    box.delete(array.shift(revCoreBoxes))
while array.size(revOuterBoxes) > revMaxLevels
    box.delete(array.shift(revOuterBoxes))
while array.size(revZoneBoxes) > revMaxZones
    box.delete(array.shift(revZoneBoxes))
while array.size(revLabels) > revMaxLevels
    label.delete(array.shift(revLabels))

// Simulated running profit from the latest AK reversal price at fixed 0.10 lot.
// V20.9 uses the shared instrument-aware money model.
float akRunningProfit = f_dashboardPl(akLastEntryPrice, akLastDir)
string akSignalText = akLastDir == 1 ? "BUY CONFIRMED" : akLastDir == -1 ? "SELL CONFIRMED" : "WAITING"
color akSignalColor = akLastDir == 1 ? akBuyColor : akLastDir == -1 ? akSellColor : neutralColor
string akProfitText = na(akRunningProfit) ? "--" : "$" + str.tostring(akRunningProfit, "#.00")
color akProfitColor = na(akRunningProfit) ? neutralColor : akRunningProfit >= 0 ? bullColor : bearColor

//-----------------------------------------------------------------------------
// MARKET STRUCTURE + SUPPORT / RESISTANCE
//-----------------------------------------------------------------------------
phStruct = ta.pivothigh(high, structureLeft, structureRight)
plStruct = ta.pivotlow(low, structureLeft, structureRight)

var float lastSwingHigh = na
var float prevSwingHigh = na
var int lastSwingHighBar = na
var float lastSwingLow = na
var float prevSwingLow = na
var int lastSwingLowBar = na

var bool highBroken = false
var bool lowBroken = false
var int structureDir = 0  // 1 bullish, -1 bearish, 0 unknown
var string lastBreakText = "NONE"

// Premium internal confirmation state.
//  1 = latest confirmed CHoCH bullish
// -1 = latest confirmed CHoCH bearish
//  0 = no confirmed CHoCH yet
var int lastChochDir = 0
var int lastChochBar = na

if not na(phStruct)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := phStruct
    lastSwingHighBar := bar_index - structureRight
    highBroken := false
    if showSwingLabels
        string htxt = na(prevSwingHigh) ? "H" : phStruct > prevSwingHigh ? "HH" : "LH"
        label.new(lastSwingHighBar, phStruct, htxt,
          style=label.style_none,
          textcolor=htxt == "HH" ? color.lime : color.red,
          size=size.tiny)

if not na(plStruct)
    prevSwingLow := lastSwingLow
    lastSwingLow := plStruct
    lastSwingLowBar := bar_index - structureRight
    lowBroken := false
    if showSwingLabels
        string ltxt = na(prevSwingLow) ? "L" : plStruct > prevSwingLow ? "HL" : "LL"
        label.new(lastSwingLowBar, plStruct, ltxt,
          style=label.style_none,
          textcolor=ltxt == "HL" ? color.lime : color.red,
          size=size.tiny)

// Support / Resistance from latest confirmed swings
var line resistanceLine = na
var line supportLine = na
var label resistancePriceLabel = na
var label supportPriceLabel = na

if showSR and not na(phStruct)
    if not na(resistanceLine)
        line.delete(resistanceLine)
    resistanceLine := line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh,
      xloc=xloc.bar_index, extend=extend.right, color=color.red, width=1)

    if not na(resistancePriceLabel)
        label.delete(resistancePriceLabel)
    resistancePriceLabel := label.new(bar_index, lastSwingHigh,
      "RESISTANCE  " + str.tostring(lastSwingHigh, format.mintick),
      style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)

if showSR and not na(plStruct)
    if not na(supportLine)
        line.delete(supportLine)
    supportLine := line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow,
      xloc=xloc.bar_index, extend=extend.right, color=color.lime, width=1)

    if not na(supportPriceLabel)
        label.delete(supportPriceLabel)
    supportPriceLabel := label.new(bar_index, lastSwingLow,
      "SUPPORT  " + str.tostring(lastSwingLow, format.mintick),
      style=label.style_label_left, color=color.rgb(0, 170, 70), textcolor=color.white, size=size.small)

// Optional BSL / SSL liquidity reference lines from latest confirmed swings.
var line bslLine = na
var line sslLine = na
var label bslLabel = na
var label sslLabel = na

if showBSL and not na(phStruct)
    if not na(bslLine)
        line.delete(bslLine)
    if not na(bslLabel)
        label.delete(bslLabel)
    bslLine := line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh,
      xloc=xloc.bar_index, extend=extend.right, color=color.new(color.blue, 20), width=1, style=line.style_dashed)
    bslLabel := label.new(bar_index, lastSwingHigh, "BSL", style=label.style_none,
      textcolor=color.blue, size=size.tiny)

if showSSL and not na(plStruct)
    if not na(sslLine)
        line.delete(sslLine)
    if not na(sslLabel)
        label.delete(sslLabel)
    sslLine := line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow,
      xloc=xloc.bar_index, extend=extend.right, color=color.new(color.red, 20), width=1, style=line.style_dashed)
    sslLabel := label.new(bar_index, lastSwingLow, "SSL", style=label.style_none,
      textcolor=color.red, size=size.tiny)

// Optional 3-candle Fair Value Gaps.
var array<box> fvgBoxes = array.new<box>()
bullFVG = showFVG and low > high[2]
bearFVG = showFVG and high < low[2]

if bullFVG
    box f = box.new(bar_index - 2, low, bar_index, high[2], xloc=xloc.bar_index,
      extend=extend.right, bgcolor=color.new(color.lime, 90), border_color=color.new(color.lime, 45),
      text="FVG", text_color=color.new(color.green, 10), text_size=size.tiny)
    array.push(fvgBoxes, f)

if bearFVG
    box f = box.new(bar_index - 2, low[2], bar_index, high, xloc=xloc.bar_index,
      extend=extend.right, bgcolor=color.new(color.red, 90), border_color=color.new(color.red, 45),
      text="FVG", text_color=color.new(color.red, 10), text_size=size.tiny)
    array.push(fvgBoxes, f)

while array.size(fvgBoxes) > 20
    box.delete(array.shift(fvgBoxes))

// BOS / CHOCH
bullBreak = not na(lastSwingHigh) and close > lastSwingHigh and not highBroken
bearBreak = not na(lastSwingLow) and close < lastSwingLow and not lowBroken

if bullBreak
    bool isChoch = structureDir == -1
    if isChoch
        lastChochDir := 1
        lastChochBar := bar_index
    if (isChoch and showCHOCH) or (not isChoch and showBOS)
        line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh,
          xloc=xloc.bar_index, extend=extend.none, color=color.rgb(34, 197, 94), width=2)
        int midBar = int(math.floor((lastSwingHighBar + bar_index) / 2))
        label.new(midBar, lastSwingHigh, isChoch ? "CHoCH" : "BOS",
          style=label.style_none, textcolor=color.rgb(34, 197, 94), size=size.small)
    structureDir := 1
    lastBreakText := isChoch ? "BULL CHOCH" : "BULL BOS"
    highBroken := true

if bearBreak
    bool isChoch = structureDir == 1
    if isChoch
        lastChochDir := -1
        lastChochBar := bar_index
    if (isChoch and showCHOCH) or (not isChoch and showBOS)
        line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow,
          xloc=xloc.bar_index, extend=extend.none, color=color.rgb(239, 68, 68), width=2)
        int midBar = int(math.floor((lastSwingLowBar + bar_index) / 2))
        label.new(midBar, lastSwingLow, isChoch ? "CHoCH" : "BOS",
          style=label.style_none, textcolor=color.rgb(239, 68, 68), size=size.small)
    structureDir := -1
    lastBreakText := isChoch ? "BEAR CHOCH" : "BEAR BOS"
    lowBroken := true

//-----------------------------------------------------------------------------
// ONLY LATEST ACTIVE SESSION HIGH / LOW
// Tokyo establishes initial High/Low.
// London replaces ONLY the side it breaks.
// New York replaces ONLY the side it breaks.
//-----------------------------------------------------------------------------
inTokyo  = not na(time(timeframe.period, tokyoSession, sessionTz))
inLondon = not na(time(timeframe.period, londonSession, sessionTz))
inNY     = not na(time(timeframe.period, nySession, sessionTz))

dayStamp = time("D", "0000-2359", sessionTz)
newSessionDay = ta.change(dayStamp) != 0

var float activeSessionHigh = na
var float activeSessionLow = na
var string activeHighName = "TOKYO HIGH"
var string activeLowName = "TOKYO LOW"
var int sessionDayStart = na

var line activeHighLine = na
var line activeLowLine = na
var label activeHighLabel = na
var label activeLowLabel = na

if newSessionDay or na(sessionDayStart)
    activeSessionHigh := na
    activeSessionLow := na
    activeHighName := "TOKYO HIGH"
    activeLowName := "TOKYO LOW"
    sessionDayStart := time

    if not na(activeHighLine)
        line.delete(activeHighLine)
    if not na(activeLowLine)
        line.delete(activeLowLine)
    if not na(activeHighLabel)
        label.delete(activeHighLabel)
    if not na(activeLowLabel)
        label.delete(activeLowLabel)

    activeHighLine := na
    activeLowLine := na
    activeHighLabel := na
    activeLowLabel := na

// Tokyo initializes/runs the active range
if inTokyo
    if na(activeSessionHigh) or high > activeSessionHigh
        activeSessionHigh := high
        activeHighName := "TOKYO HIGH"
    if na(activeSessionLow) or low < activeSessionLow
        activeSessionLow := low
        activeLowName := "TOKYO LOW"

// London only replaces a side if that side is broken
if inLondon
    if na(activeSessionHigh)
        activeSessionHigh := high
        activeHighName := "LONDON HIGH"
    else if high > activeSessionHigh
        activeSessionHigh := high
        activeHighName := "LONDON HIGH"

    if na(activeSessionLow)
        activeSessionLow := low
        activeLowName := "LONDON LOW"
    else if low < activeSessionLow
        activeSessionLow := low
        activeLowName := "LONDON LOW"

// New York only replaces a side if that side is broken
if inNY
    if na(activeSessionHigh)
        activeSessionHigh := high
        activeHighName := "NY HIGH"
    else if high > activeSessionHigh
        activeSessionHigh := high
        activeHighName := "NY HIGH"

    if na(activeSessionLow)
        activeSessionLow := low
        activeLowName := "NY LOW"
    else if low < activeSessionLow
        activeSessionLow := low
        activeLowName := "NY LOW"

// Draw ONLY the current active high + low
if showSessionHL and not na(activeSessionHigh)
    if na(activeHighLine)
        activeHighLine := line.new(sessionDayStart, activeSessionHigh, time, activeSessionHigh,
          xloc=xloc.bar_time, extend=extend.right, color=color.aqua, width=1, style=line.style_dashed)
    else
        line.set_xy1(activeHighLine, sessionDayStart, activeSessionHigh)
        line.set_xy2(activeHighLine, time, activeSessionHigh)

    if na(activeHighLabel)
        activeHighLabel := label.new(time, activeSessionHigh, activeHighName,
          xloc=xloc.bar_time, style=label.style_label_left,
          color=color.rgb(0, 110, 125), textcolor=color.white, size=size.small)
    else
        label.set_xy(activeHighLabel, time, activeSessionHigh)
        label.set_text(activeHighLabel, activeHighName)

if showSessionHL and not na(activeSessionLow)
    if na(activeLowLine)
        activeLowLine := line.new(sessionDayStart, activeSessionLow, time, activeSessionLow,
          xloc=xloc.bar_time, extend=extend.right, color=color.orange, width=1, style=line.style_dashed)
    else
        line.set_xy1(activeLowLine, sessionDayStart, activeSessionLow)
        line.set_xy2(activeLowLine, time, activeSessionLow)

    if na(activeLowLabel)
        activeLowLabel := label.new(time, activeSessionLow, activeLowName,
          xloc=xloc.bar_time, style=label.style_label_left,
          color=color.rgb(175, 90, 0), textcolor=color.white, size=size.small)
    else
        label.set_xy(activeLowLabel, time, activeSessionLow)
        label.set_text(activeLowLabel, activeLowName)

//-----------------------------------------------------------------------------
// OPTIONAL TOKYO SESSION POC + PREMIUM / DISCOUNT
//-----------------------------------------------------------------------------
// Tokyo POC is session-fixed: it accumulates each Tokyo bar's volume into price
// bins across the developing Tokyo range, then freezes when Tokyo ends.
// It is independent of chart zoom. This is a bar-volume approximation of
// session POC and does not require TradingView footprint-plan access.
var array<float> tokPrices = array.new_float()
var array<float> tokVolumes = array.new_float()
var float tokLow = na
var float tokHigh = na
var float frozenTokyoPOC = na
var line tokPOCLine = na
var label tokPOCLabel = na

tokyoStart = inTokyo and not inTokyo[1]
tokyoEnd = not inTokyo and inTokyo[1]

if tokyoStart
    array.clear(tokPrices)
    array.clear(tokVolumes)
    tokLow := low
    tokHigh := high
    frozenTokyoPOC := na
    if not na(tokPOCLine)
        line.delete(tokPOCLine)
        tokPOCLine := na
    if not na(tokPOCLabel)
        label.delete(tokPOCLabel)
        tokPOCLabel := na

if inTokyo
    tokLow := na(tokLow) ? low : math.min(tokLow, low)
    tokHigh := na(tokHigh) ? high : math.max(tokHigh, high)
    float rangeNow = math.max(tokHigh - tokLow, syminfo.mintick * pocBins)
    float stepNow = rangeNow / pocBins
    float bucket = tokLow + (math.floor((hlc3 - tokLow) / stepNow) + 0.5) * stepNow
    int found = -1
    if array.size(tokPrices) > 0
        for i = 0 to array.size(tokPrices) - 1
            if math.abs(array.get(tokPrices, i) - bucket) <= stepNow * 0.5
                found := i
                break
    if found >= 0
        array.set(tokVolumes, found, array.get(tokVolumes, found) + volume)
    else
        array.push(tokPrices, bucket)
        array.push(tokVolumes, volume)

if tokyoEnd and array.size(tokVolumes) > 0
    float maxVol = -1.0
    float bestPrice = na
    for i = 0 to array.size(tokVolumes) - 1
        float v = array.get(tokVolumes, i)
        if v > maxVol
            maxVol := v
            bestPrice := array.get(tokPrices, i)
    frozenTokyoPOC := bestPrice

if showTokyoPOC and not na(frozenTokyoPOC)
    if na(tokPOCLine)
        tokPOCLine := line.new(bar_index, frozenTokyoPOC, bar_index + 1, frozenTokyoPOC,
          xloc=xloc.bar_index, extend=extend.right, color=color.fuchsia, width=2, style=line.style_dashed)
    else
        line.set_y1(tokPOCLine, frozenTokyoPOC)
        line.set_y2(tokPOCLine, frozenTokyoPOC)
    if na(tokPOCLabel)
        tokPOCLabel := label.new(bar_index, frozenTokyoPOC, "TOKYO POC",
          style=label.style_none, textcolor=color.fuchsia, size=size.small)
    else
        label.set_xy(tokPOCLabel, bar_index, frozenTokyoPOC)
else
    if not na(tokPOCLine)
        line.delete(tokPOCLine)
        tokPOCLine := na
    if not na(tokPOCLabel)
        label.delete(tokPOCLabel)
        tokPOCLabel := na

// Premium / Discount based on the current active session range.
var box premiumBox = na
var box discountBox = na
if showPremiumDiscount and not na(activeSessionHigh) and not na(activeSessionLow) and activeSessionHigh > activeSessionLow
    float eq = (activeSessionHigh + activeSessionLow) / 2.0
    if not na(premiumBox)
        box.delete(premiumBox)
    if not na(discountBox)
        box.delete(discountBox)
    premiumBox := box.new(bar_index, activeSessionHigh, bar_index + 1, eq,
      xloc=xloc.bar_index, extend=extend.right, bgcolor=color.new(color.red, 93),
      border_color=color.new(color.red, 70), text="PREMIUM", text_color=color.red, text_size=size.tiny)
    discountBox := box.new(bar_index, eq, bar_index + 1, activeSessionLow,
      xloc=xloc.bar_index, extend=extend.right, bgcolor=color.new(color.lime, 93),
      border_color=color.new(color.lime, 70), text="DISCOUNT", text_color=color.green, text_size=size.tiny)
else
    if not na(premiumBox)
        box.delete(premiumBox)
        premiumBox := na
    if not na(discountBox)
        box.delete(discountBox)
        discountBox := na

//-----------------------------------------------------------------------------
// NEAREST ACTIVE BUY / SELL ZONES
//-----------------------------------------------------------------------------
float nearestBuy = na
string nearestBuyTF = "--"
float nearestBuyDist = 1e10

float nearestSell = na
string nearestSellTF = "--"
float nearestSellDist = 1e10

// Buy candidates: nearest top boundary at/below price, or containing price
if not na(m5BuyTop)
    float d = close >= m5BuyBot ? math.abs(close - math.min(close, m5BuyTop)) : math.abs(close - m5BuyTop)
    if d < nearestBuyDist
        nearestBuyDist := d
        nearestBuy := m5BuyTop
        nearestBuyTF := "5M"

if not na(m15BuyTop)
    float d = close >= m15BuyBot ? math.abs(close - math.min(close, m15BuyTop)) : math.abs(close - m15BuyTop)
    if d < nearestBuyDist
        nearestBuyDist := d
        nearestBuy := m15BuyTop
        nearestBuyTF := "15M"

if not na(h1BuyTop)
    float d = close >= h1BuyBot ? math.abs(close - math.min(close, h1BuyTop)) : math.abs(close - h1BuyTop)
    if d < nearestBuyDist
        nearestBuyDist := d
        nearestBuy := h1BuyTop
        nearestBuyTF := "1H"

if not na(h4BuyTop)
    float d = close >= h4BuyBot ? math.abs(close - math.min(close, h4BuyTop)) : math.abs(close - h4BuyTop)
    if d < nearestBuyDist
        nearestBuyDist := d
        nearestBuy := h4BuyTop
        nearestBuyTF := "4H"

// Sell candidates: nearest bottom boundary at/above price, or containing price
if not na(m5SellBot)
    float d = close <= m5SellTop ? math.abs(close - math.max(close, m5SellBot)) : math.abs(close - m5SellBot)
    if d < nearestSellDist
        nearestSellDist := d
        nearestSell := m5SellBot
        nearestSellTF := "5M"

if not na(m15SellBot)
    float d = close <= m15SellTop ? math.abs(close - math.max(close, m15SellBot)) : math.abs(close - m15SellBot)
    if d < nearestSellDist
        nearestSellDist := d
        nearestSell := m15SellBot
        nearestSellTF := "15M"

if not na(h1SellBot)
    float d = close <= h1SellTop ? math.abs(close - math.max(close, h1SellBot)) : math.abs(close - h1SellBot)
    if d < nearestSellDist
        nearestSellDist := d
        nearestSell := h1SellBot
        nearestSellTF := "1H"

if not na(h4SellBot)
    float d = close <= h4SellTop ? math.abs(close - math.max(close, h4SellBot)) : math.abs(close - h4SellBot)
    if d < nearestSellDist
        nearestSellDist := d
        nearestSell := h4SellBot
        nearestSellTF := "4H"

//-----------------------------------------------------------------------------
// LIVE SUPPORT / RESISTANCE BOXES
// Uses the already-calculated nearest active BUY / SELL zone levels.
// Separate from the normal Support / Resistance price labels above.
//-----------------------------------------------------------------------------
var box liveSupportBox = na
var box liveResistanceBox = na

float liveBoxHalf = ta.atr(14) * 0.08

if showSR and not na(nearestBuy)
    float liveSupportTop = nearestBuy + liveBoxHalf
    float liveSupportBottom = nearestBuy - liveBoxHalf
    if na(liveSupportBox)
        liveSupportBox := box.new(bar_index, liveSupportTop, bar_index + 1, liveSupportBottom,
          xloc=xloc.bar_index, extend=extend.right,
          bgcolor=color.new(color.lime, 88), border_color=color.lime, border_width=1,
          text="SUPPORT", text_color=color.rgb(0, 85, 0),
          text_size=size.small, text_halign=text.align_left, text_valign=text.align_center)
    else
        box.set_lefttop(liveSupportBox, bar_index, liveSupportTop)
        box.set_rightbottom(liveSupportBox, bar_index + 1, liveSupportBottom)
else
    if not na(liveSupportBox)
        box.delete(liveSupportBox)
        liveSupportBox := na

if showSR and not na(nearestSell)
    float liveResistanceTop = nearestSell + liveBoxHalf
    float liveResistanceBottom = nearestSell - liveBoxHalf
    if na(liveResistanceBox)
        liveResistanceBox := box.new(bar_index, liveResistanceTop, bar_index + 1, liveResistanceBottom,
          xloc=xloc.bar_index, extend=extend.right,
          bgcolor=color.new(color.red, 88), border_color=color.red, border_width=1,
          text="RESISTANCE", text_color=color.rgb(125, 0, 0),
          text_size=size.small, text_halign=text.align_left, text_valign=text.align_center)
    else
        box.set_lefttop(liveResistanceBox, bar_index, liveResistanceTop)
        box.set_rightbottom(liveResistanceBox, bar_index + 1, liveResistanceBottom)
else
    if not na(liveResistanceBox)
        box.delete(liveResistanceBox)
        liveResistanceBox := na

