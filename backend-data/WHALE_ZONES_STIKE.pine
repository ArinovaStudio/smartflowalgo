//=============================================================================
// V21.2 SFA FIXED-LOT MONEY MODEL — GOLD 0.10 BASELINE
//=============================================================================
// GOLD reference: XAUUSD 0.10 lot, a $1.00 price move ≈ $10 P/L.
// BTC: 5.00 lots gives about $5 P/L for a $1 price move. ETH remains 10.00 lots.
// FOREX: auto-normalise to a REAL 0.01-step lot so one pip is approximately
// $10 P/L in USD.
// SILVER: fixed member lot is 0.10, matching the broker examples supplied.
// Its real broker contract is used, so the displayed P/L is not artificially normalised.
//
// Broker contracts confirmed from the user's screenshots:
// XAUUSD 1 lot = 100 oz
// XAGUSD 1 lot = 5,000 oz
// BTCUSD 1 lot = 1 BTC
// ETHUSD 1 lot = 1 ETH
// Forex 1 lot = 100,000 base-currency units.

string dashboardTickerUpper = str.upper(syminfo.ticker)

bool dashboardIsGold =
     str.contains(dashboardTickerUpper, "XAU") or
     str.contains(dashboardTickerUpper, "GOLD")

bool dashboardIsSilver =
     str.contains(dashboardTickerUpper, "XAG") or
     str.contains(dashboardTickerUpper, "SILVER")

bool dashboardIsBtc =
     str.contains(dashboardTickerUpper, "BTC")

bool dashboardIsEth =
     str.contains(dashboardTickerUpper, "ETH")

bool dashboardIsForex =
     syminfo.type == "forex" and
     not dashboardIsGold and not dashboardIsSilver and
     not dashboardIsBtc and not dashboardIsEth

float dashboardGoldContractSize = 100.0
float dashboardSilverContractSize = 5000.0
float dashboardCryptoContractSize = 1.0
float dashboardForexContractSize = 100000.0

// Forex P/L is produced in the quote currency, then converted to USD.
float dashboardFxQuoteToUsd =
     dashboardIsForex ?
          request.currency_rate(syminfo.currency, currency.USD, true) :
          1.0

bool dashboardForexQuoteIsJpy =
     dashboardIsForex and str.upper(syminfo.currency) == "JPY"

float dashboardForexPipSize =
     dashboardForexQuoteIsJpy ? 0.01 : 0.0001

// Pip value in USD for 1.00 lot.
float dashboardForexOneLotPipUsd =
     dashboardIsForex and not na(dashboardFxQuoteToUsd) ?
          dashboardForexContractSize * dashboardForexPipSize * dashboardFxQuoteToUsd :
          na

// Lot needed for approximately $10 per pip, rounded to a real 0.01 lot step.
float dashboardForexRawLot =
     dashboardIsForex and not na(dashboardForexOneLotPipUsd) and dashboardForexOneLotPipUsd > 0 ?
          10.0 / dashboardForexOneLotPipUsd :
          na

float dashboardForexNormalizedLot =
     na(dashboardForexRawLot) ?
          1.00 :
          math.max(0.01, math.round(dashboardForexRawLot * 100.0) / 100.0)

// Final SFA member lot displayed on the chart.
float dashboardLotSize =
     dashboardIsGold ? 0.10 :
     dashboardIsSilver ? 0.10 :
     dashboardIsBtc ? 5.00 :
     dashboardIsEth ? 10.00 :
     dashboardIsForex ? dashboardForexNormalizedLot :
     0.10

f_dashboardMoneyFactorForLot(float lotSize) =>
    float result = na
    if dashboardIsGold
        result := dashboardGoldContractSize * lotSize
    else if dashboardIsSilver
        result := dashboardSilverContractSize * lotSize
    else if dashboardIsBtc or dashboardIsEth
        result := dashboardCryptoContractSize * lotSize
    else if dashboardIsForex
        result := na(dashboardFxQuoteToUsd) ? na : dashboardForexContractSize * lotSize * dashboardFxQuoteToUsd
    else
        result := dashboardGoldContractSize * lotSize
    result

float dashboardMoneyFactor = f_dashboardMoneyFactorForLot(dashboardLotSize)

f_dashboardPl(float entryPrice, int dir) =>
    float result = na
    if not na(entryPrice) and dir != 0 and not na(dashboardMoneyFactor)
        result := (close - entryPrice) * dir * dashboardMoneyFactor
    result

f_dashboardPlLot(float entryPrice, float exitPrice, int dir, float lotSize) =>
    float moneyFactor = f_dashboardMoneyFactorForLot(lotSize)
    float result = na
    if not na(entryPrice) and not na(exitPrice) and dir != 0 and not na(lotSize) and not na(moneyFactor)
        result := (exitPrice - entryPrice) * dir * moneyFactor
    result

f_moneyText(float value) =>
    string result = "$0.00"
    if na(value)
        result := "--"
    else if value > 0
        result := "+$" + str.tostring(value, "#.00")
    else if value < 0
        result := "-$" + str.tostring(math.abs(value), "#.00")
    result

string dashboardLotText =
     str.tostring(dashboardLotSize, "0.00")

