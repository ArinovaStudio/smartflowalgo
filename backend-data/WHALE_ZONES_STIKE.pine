        mapSell2Time := h1SellTimeRaw
        mapSell2TF := "1H"

if show4hZones and not na(h4SellTop) and not f_rangesOverlap(h4SellTop, h4SellBot, mapSellTop, mapSellBot)
    float s = f_mapScore(h4SellTop, h4SellBot, h4SellTimeRaw, "4H", true)
    if s < mapSell2Rank
        mapSell2Rank := s
        mapSell2Top := h4SellTop
        mapSell2Bot := h4SellBot
        mapSell2Time := h4SellTimeRaw
        mapSell2TF := "4H"

if showD1Zones and not na(d1SellTop) and not f_rangesOverlap(d1SellTop, d1SellBot, mapSellTop, mapSellBot)
    float s = f_mapScore(d1SellTop, d1SellBot, d1SellTimeRaw, "D1", true)
    if s < mapSell2Rank
        mapSell2Rank := s
        mapSell2Top := d1SellTop
        mapSell2Bot := d1SellBot
        mapSell2Time := d1SellTimeRaw
        mapSell2TF := "D1"

// Structural zone-strength score.
// This is a comparative ZONE QUALITY score, NOT a win-rate probability.
f_masterTfBase(string tf) =>
    tf == "D1" ? 78.0 :
     tf == "4H" ? 74.0 :
     tf == "1H" ? 68.0 :
     tf == "30M" ? 63.0 :
     tf == "15M" ? 59.0 :
     tf == "5M" ? 54.0 :
     tf == "1M" ? 50.0 : 45.0

f_masterTfHours(string tf) =>
    tf == "D1" ? 24.0 :
     tf == "4H" ? 4.0 :
     tf == "1H" ? 1.0 :
     tf == "30M" ? 0.5 :
     tf == "15M" ? 0.25 :
     tf == "5M" ? 5.0 / 60.0 :
     tf == "1M" ? 1.0 / 60.0 : 1.0

f_masterZoneStrength(float top, float bot, int leftTime, string tf, bool isSell) =>
    float score = 0.0
    if not na(top) and not na(bot) and not na(leftTime)
        float width = math.max(top - bot, syminfo.mintick)
        float widthAtr = width / mapAtrNow
        float ageHours = math.max(0.0, (timenow - leftTime) / 3600000.0)
        float ageBars = ageHours / math.max(f_masterTfHours(tf), 1.0 / 60.0)

        float widthPts =
             widthAtr <= 3.0 ? 12.0 :
             widthAtr <= 6.0 ? 8.0 :
             widthAtr <= 10.0 ? 4.0 :
             widthAtr <= 14.0 ? 0.0 : -12.0

        float freshnessPts =
             ageBars <= 20.0 ? 10.0 :
             ageBars <= 50.0 ? 6.0 :
             ageBars <= 100.0 ? 2.0 :
             ageBars <= 200.0 ? -4.0 : -10.0

        bool correctlyLocated = isSell ? bot >= close - mapAtrNow * 0.25 : top <= close + mapAtrNow * 0.25
        float locationPts = correctlyLocated ? 6.0 : 0.0

        score := f_masterTfBase(tf) + widthPts + freshnessPts + locationPts

    int(math.round(math.min(99.0, math.max(20.0, score))))

f_masterStars(int pct) =>
    pct >= 90 ? "★★★★★" :
     pct >= 75 ? "★★★★☆" :
     pct >= 60 ? "★★★☆☆" :
     pct >= 40 ? "★★☆☆☆" :
     pct > 0 ? "★☆☆☆☆" : "☆☆☆☆☆"

int mapBuyStrengthBase = f_masterZoneStrength(mapBuyTop, mapBuyBot, mapBuyTime, mapBuyTF, false)
int mapSellStrengthBase = f_masterZoneStrength(mapSellTop, mapSellBot, mapSellTime, mapSellTF, true)

// Zone-box strength must be self-contained here.
// Do NOT reference focusDir/focusLevel before the rejection engine declares them.
// A small +3 live-location bonus is allowed only when price is currently inside
// the primary zone. Confirmation strength is added later in the dashboard.
int mapBuyStrength = math.min(99, mapBuyStrengthBase + (priceInMapBuy ? 3 : 0))
int mapSellStrength = math.min(99, mapSellStrengthBase + (priceInMapSell ? 3 : 0))
int mapBuy2Strength = f_masterZoneStrength(mapBuy2Top, mapBuy2Bot, mapBuy2Time, mapBuy2TF, false)
int mapSell2Strength = f_masterZoneStrength(mapSell2Top, mapSell2Bot, mapSell2Time, mapSell2TF, true)

string mapBuyStars = f_masterStars(mapBuyStrength)
string mapSellStars = f_masterStars(mapSellStrength)
string mapBuy2Stars = f_masterStars(mapBuy2Strength)
string mapSell2Stars = f_masterStars(mapSell2Strength)

//=============================================================================
// SFA 🐋 WHALE ZONES STIKE — AUTO CONFLUENCE VISUAL ENGINE
//
// DISPLAY RULES
// 1) BUY 1 + BUY 2 overlap / sit close -> ONE BUY CONFLUENCE band.
// 2) SELL 1 + SELL 2 overlap / sit close -> ONE SELL CONFLUENCE band.
// 3) The underlying BUY1/BUY2/SELL1/SELL2 logical prices remain separate.
// 4) If an opposite BUY/SELL text area is extremely close, only the stronger
//    side prints chart text. The dashboard still shows BOTH exact zones.
//
// This is presentation only. Entry/rejection/confirmation logic is unchanged.
//=============================================================================
f_visualZoneTop(float logicalTop, float logicalBot, float minAtrHeight) =>
    float out = logicalTop
    if not na(logicalTop) and not na(logicalBot)
        float logicalHeight = math.max(logicalTop - logicalBot, syminfo.mintick)
        float displayHeight = math.max(logicalHeight, mapAtrNow * minAtrHeight)
        float mid = (logicalTop + logicalBot) * 0.5
        out := mid + displayHeight * 0.5
    out

f_visualZoneBot(float logicalTop, float logicalBot, float minAtrHeight) =>
    float out = logicalBot
    if not na(logicalTop) and not na(logicalBot)
        float logicalHeight = math.max(logicalTop - logicalBot, syminfo.mintick)
        float displayHeight = math.max(logicalHeight, mapAtrNow * minAtrHeight)
        float mid = (logicalTop + logicalBot) * 0.5
        out := mid - displayHeight * 0.5
    out

f_masterZoneGap(float top1, float bot1, float top2, float bot2) =>
    float gap = 1e20
    if not na(top1) and not na(bot1) and not na(top2) and not na(bot2)
        if f_rangesOverlap(top1, bot1, top2, bot2)
            gap := 0.0
        else if bot1 > top2
            gap := bot1 - top2
        else if bot2 > top1
            gap := bot2 - top1
        else
            gap := 0.0
    gap

f_masterConfluenceStrength(int s1, int s2) =>
    math.min(99, int(math.round((s1 + s2) * 0.5)) + 6)

bool buyConfluence =
     not na(mapBuyTop) and not na(mapBuy2Top) and
     f_masterZoneGap(mapBuyTop, mapBuyBot, mapBuy2Top, mapBuy2Bot) <= mapAtrNow * zoneConfluenceGapAtr

bool sellConfluence =
     not na(mapSellTop) and not na(mapSell2Top) and
     f_masterZoneGap(mapSellTop, mapSellBot, mapSell2Top, mapSell2Bot) <= mapAtrNow * zoneConfluenceGapAtr

float buyDisplayLogicalTop =
     buyConfluence ? math.max(mapBuyTop, mapBuy2Top) : mapBuyTop
float buyDisplayLogicalBot =
     buyConfluence ? math.min(mapBuyBot, mapBuy2Bot) : mapBuyBot

float sellDisplayLogicalTop =
     sellConfluence ? math.max(mapSellTop, mapSell2Top) : mapSellTop
float sellDisplayLogicalBot =
     sellConfluence ? math.min(mapSellBot, mapSell2Bot) : mapSellBot

int buyDisplayTime =
     buyConfluence ? math.min(mapBuyTime, mapBuy2Time) : mapBuyTime
int sellDisplayTime =
     sellConfluence ? math.min(mapSellTime, mapSell2Time) : mapSellTime

string buyDisplayTF =
     buyConfluence ?
         (mapBuyTF == mapBuy2TF ? mapBuyTF : mapBuyTF + "+" + mapBuy2TF) :
         mapBuyTF

string sellDisplayTF =
     sellConfluence ?
         (mapSellTF == mapSell2TF ? mapSellTF : mapSellTF + "+" + mapSell2TF) :
         mapSellTF

int buyDisplayStrength =
     buyConfluence ? f_masterConfluenceStrength(mapBuyStrength, mapBuy2Strength) : mapBuyStrength
int sellDisplayStrength =
     sellConfluence ? f_masterConfluenceStrength(mapSellStrength, mapSell2Strength) : mapSellStrength

string buyDisplayStars = f_masterStars(buyDisplayStrength)
string sellDisplayStars = f_masterStars(sellDisplayStrength)

string buyDisplayText =
     buyConfluence ?
         "BUY CONFLUENCE • " + buyDisplayTF + " • " +
         str.tostring(buyDisplayStrength) + "% • " + buyDisplayStars :
         "BUY 1 • " + mapBuyTF + " • " +
         str.tostring(mapBuyStrength) + "% • " + mapBuyStars

string sellDisplayText =
     sellConfluence ?
         "SELL CONFLUENCE • " + sellDisplayTF + " • " +
         str.tostring(sellDisplayStrength) + "% • " + sellDisplayStars :
         "SELL 1 • " + mapSellTF + " • " +
         str.tostring(mapSellStrength) + "% • " + mapSellStars

string buy2BoxText =
     "BUY 2 • " + mapBuy2TF + " • " + str.tostring(mapBuy2Strength) + "% • " + mapBuy2Stars

string sell2BoxText =
     "SELL 2 • " + mapSell2TF + " • " + str.tostring(mapSell2Strength) + "% • " + mapSell2Stars

// Opposite-side text collision protection.
// If BUY and SELL display areas are nearly touching, only the stronger side
// prints text on the chart. Both bands still remain visible and the dashboard
// still lists both exact sides.
bool oppositeTextCrowded =
     not na(buyDisplayLogicalTop) and not na(sellDisplayLogicalTop) and
     f_masterZoneGap(
         buyDisplayLogicalTop, buyDisplayLogicalBot,
         sellDisplayLogicalTop, sellDisplayLogicalBot) <= mapAtrNow * zoneCrossTextGapAtr

bool showBuyChartText =
     not oppositeTextCrowded or buyDisplayStrength >= sellDisplayStrength
bool showSellChartText =
     not oppositeTextCrowded or sellDisplayStrength > buyDisplayStrength

// Maximum four logical zones, but only 2–4 visual bands depending on confluence.
var box marketBuyBox = na
var box marketSellBox = na
var box marketBuyBox2 = na
var box marketSellBox2 = na

var float marketBuyVisualTop = na
var float marketBuyVisualBot = na
var float marketSellVisualTop = na
var float marketSellVisualBot = na
var float marketBuy2VisualTop = na
var float marketBuy2VisualBot = na
var float marketSell2VisualTop = na
var float marketSell2VisualBot = na

// Rebuild a side whenever either of its logical zones or confluence state changes.
bool buyVisualChanged = barstate.isconfirmed and (
     mapBuyTime != mapBuyTime[1] or mapBuyTop != mapBuyTop[1] or
     mapBuyBot != mapBuyBot[1] or mapBuyTF != mapBuyTF[1] or
     mapBuy2Time != mapBuy2Time[1] or mapBuy2Top != mapBuy2Top[1] or
     mapBuy2Bot != mapBuy2Bot[1] or mapBuy2TF != mapBuy2TF[1] or
     buyConfluence != buyConfluence[1])

bool sellVisualChanged = barstate.isconfirmed and (
     mapSellTime != mapSellTime[1] or mapSellTop != mapSellTop[1] or
     mapSellBot != mapSellBot[1] or mapSellTF != mapSellTF[1] or
     mapSell2Time != mapSell2Time[1] or mapSell2Top != mapSell2Top[1] or
     mapSell2Bot != mapSell2Bot[1] or mapSell2TF != mapSell2TF[1] or
     sellConfluence != sellConfluence[1])

if buyVisualChanged
    if not na(marketBuyBox)
        box.delete(marketBuyBox)
        marketBuyBox := na
    if not na(marketBuyBox2)
        box.delete(marketBuyBox2)
        marketBuyBox2 := na

    marketBuyVisualTop := f_visualZoneTop(
         buyDisplayLogicalTop, buyDisplayLogicalBot, zoneVisualPrimaryMinAtr)
    marketBuyVisualBot := f_visualZoneBot(
         buyDisplayLogicalTop, buyDisplayLogicalBot, zoneVisualPrimaryMinAtr)

    if showMarketZoneMap and not na(buyDisplayTime) and
       not na(buyDisplayLogicalTop) and not na(buyDisplayLogicalBot)
        marketBuyBox := box.new(
             buyDisplayTime, marketBuyVisualTop, time, marketBuyVisualBot,
             xloc=xloc.bar_time, extend=extend.right,
             bgcolor=color.new(bullColor, buyConfluence ? 76 : 80),
             border_color=color.new(bullColor, 100), border_width=1,
             text=showBuyChartText ? buyDisplayText : "",
             text_color=chart.fg_color, text_size=size.small,
             text_halign=text.align_center, text_valign=text.align_center)

    // BUY 2 is shown separately only when it is NOT visually confluent with BUY 1.
    marketBuy2VisualTop := f_visualZoneTop(
         mapBuy2Top, mapBuy2Bot, zoneVisualSecondaryMinAtr)
    marketBuy2VisualBot := f_visualZoneBot(
         mapBuy2Top, mapBuy2Bot, zoneVisualSecondaryMinAtr)

    if showMarketZoneMap and not buyConfluence and
       not na(mapBuy2Time) and not na(mapBuy2Top) and not na(mapBuy2Bot)
        marketBuyBox2 := box.new(
             mapBuy2Time, marketBuy2VisualTop, time, marketBuy2VisualBot,
             xloc=xloc.bar_time, extend=extend.right,
             bgcolor=color.new(bullColor, 90),
             border_color=color.new(bullColor, 100), border_width=1,
             text=buy2BoxText,
             text_color=chart.fg_color, text_size=size.small,
             text_halign=text.align_center, text_valign=text.align_center)

if sellVisualChanged
    if not na(marketSellBox)
        box.delete(marketSellBox)
        marketSellBox := na
    if not na(marketSellBox2)
        box.delete(marketSellBox2)
        marketSellBox2 := na

    marketSellVisualTop := f_visualZoneTop(
         sellDisplayLogicalTop, sellDisplayLogicalBot, zoneVisualPrimaryMinAtr)
    marketSellVisualBot := f_visualZoneBot(
         sellDisplayLogicalTop, sellDisplayLogicalBot, zoneVisualPrimaryMinAtr)

    if showMarketZoneMap and not na(sellDisplayTime) and
       not na(sellDisplayLogicalTop) and not na(sellDisplayLogicalBot)
        marketSellBox := box.new(
             sellDisplayTime, marketSellVisualTop, time, marketSellVisualBot,
             xloc=xloc.bar_time, extend=extend.right,
             bgcolor=color.new(bearColor, sellConfluence ? 78 : 82),
             border_color=color.new(bearColor, 100), border_width=1,
             text=showSellChartText ? sellDisplayText : "",
             text_color=chart.fg_color, text_size=size.small,
             text_halign=text.align_center, text_valign=text.align_center)

    // SELL 2 is shown separately only when it is NOT visually confluent with SELL 1.
    marketSell2VisualTop := f_visualZoneTop(
         mapSell2Top, mapSell2Bot, zoneVisualSecondaryMinAtr)
    marketSell2VisualBot := f_visualZoneBot(
         mapSell2Top, mapSell2Bot, zoneVisualSecondaryMinAtr)

    if showMarketZoneMap and not sellConfluence and
       not na(mapSell2Time) and not na(mapSell2Top) and not na(mapSell2Bot)
        marketSellBox2 := box.new(
             mapSell2Time, marketSell2VisualTop, time, marketSell2VisualBot,
             xloc=xloc.bar_time, extend=extend.right,
             bgcolor=color.new(bearColor, 91),
             border_color=color.new(bearColor, 100), border_width=1,
             text=sell2BoxText,
             text_color=chart.fg_color, text_size=size.small,
             text_halign=text.align_center, text_valign=text.align_center)

if not showMarketZoneMap
    if not na(marketBuyBox)
        box.delete(marketBuyBox)
        marketBuyBox := na
    if not na(marketSellBox)
        box.delete(marketSellBox)
        marketSellBox := na
    if not na(marketBuyBox2)
        box.delete(marketBuyBox2)
        marketBuyBox2 := na
    if not na(marketSellBox2)
        box.delete(marketSellBox2)
        marketSellBox2 := na

    marketBuyVisualTop := na
    marketBuyVisualBot := na
    marketSellVisualTop := na
    marketSellVisualBot := na
    marketBuy2VisualTop := na
    marketBuy2VisualBot := na
    marketSell2VisualTop := na
    marketSell2VisualBot := na

// Live style/text updates without recreating geometry.
if not na(marketBuyBox)
    box.set_text(marketBuyBox, showBuyChartText ? buyDisplayText : "")
    box.set_text_color(marketBuyBox, chart.fg_color)
    box.set_bgcolor(
         marketBuyBox,
         color.new(bullColor, buyConfluence ? (priceInMapBuy ? 70 : 76) : (priceInMapBuy ? 74 : 80)))

if not na(marketSellBox)
    box.set_text(marketSellBox, showSellChartText ? sellDisplayText : "")
    box.set_text_color(marketSellBox, chart.fg_color)
    box.set_bgcolor(
         marketSellBox,
         color.new(bearColor, sellConfluence ? (priceInMapSell ? 72 : 78) : (priceInMapSell ? 76 : 82)))

if not na(marketBuyBox2)
    box.set_text(marketBuyBox2, buy2BoxText)
    box.set_text_color(marketBuyBox2, chart.fg_color)
    box.set_bgcolor(marketBuyBox2, color.new(bullColor, 90))

if not na(marketSellBox2)
    box.set_text(marketSellBox2, sell2BoxText)
    box.set_text_color(marketSellBox2, chart.fg_color)
    box.set_bgcolor(marketSellBox2, color.new(bearColor, 91))

//=============================================================================
// EARLY ZONE-EDGE CONFIRMATION ⚡
// This is the execution timing requested:
// SELL = GREEN test candle at SELL zone -> IMMEDIATE NEXT CLOSED RED candle.
// BUY  = RED test candle at BUY zone  -> IMMEDIATE NEXT CLOSED GREEN candle.
// The signal is therefore printed at the zone reaction, NEVER in the middle
// of a move several candles later.
//=============================================================================
float edgeAtr = math.max(ta.atr(14), syminfo.mintick * 20)
float edgeTolerance = edgeAtr * 0.12

bool priorTouchedSellZone =
     not na(mapSellTop) and not na(mapSellBot) and
     high[1] >= mapSellBot - edgeTolerance and low[1] <= mapSellTop + edgeTolerance

bool priorTouchedBuyZone =
     not na(mapBuyTop) and not na(mapBuyBot) and
     low[1] <= mapBuyTop + edgeTolerance and high[1] >= mapBuyBot - edgeTolerance

// Test candle colour at the zone.
bool sellTestGreen =
     priorTouchedSellZone and close[1] > open[1] and
     close[1] <= mapSellTop + edgeTolerance

bool buyTestRed =
     priorTouchedBuyZone and close[1] < open[1] and
     close[1] >= mapBuyBot - edgeTolerance

// Immediate next candle must reverse colour and direction.
// No extra candles are allowed between the test and confirmation.
bool sellConfirmRed =
     edgeConfirmEnabled and barstate.isconfirmed and
     sellTestGreen and close < open and close < close[1]

bool buyConfirmGreen =
     edgeConfirmEnabled and barstate.isconfirmed and
     buyTestRed and close > open and close > close[1]

var int lastEdgeSellZoneTime = na
var int lastEdgeBuyZoneTime = na

bool edgeSellSignal =
     sellConfirmRed and
     (not edgeOneSignalPerZone or na(lastEdgeSellZoneTime) or mapSellTime != lastEdgeSellZoneTime)

bool edgeBuySignal =
     buyConfirmGreen and
     (not edgeOneSignalPerZone or na(lastEdgeBuyZoneTime) or mapBuyTime != lastEdgeBuyZoneTime)

// Active edge-signal state for dashboard + persistent notifications.
var int edgeSignalDir = 0
var float edgeSignalEntry = na
var float edgeSignalInvalid = na
var string edgeSignalTf = "--"
var int edgeSignalBar = na

if edgeSellSignal
    lastEdgeSellZoneTime := mapSellTime
    edgeSignalDir := -1
    edgeSignalEntry := close
    edgeSignalInvalid := mapSellTop
    edgeSignalTf := mapSellTF
    edgeSignalBar := bar_index


if edgeBuySignal
    lastEdgeBuyZoneTime := mapBuyTime
    edgeSignalDir := 1
    edgeSignalEntry := close
    edgeSignalInvalid := mapBuyBot
    edgeSignalTf := mapBuyTF
    edgeSignalBar := bar_index


// Closed-candle invalidation. Opposite edge signal automatically replaces prior state.
bool edgeSignalInvalidated =
     edgeSignalDir == 1 and barstate.isconfirmed and not na(edgeSignalInvalid) and close < edgeSignalInvalid or
     edgeSignalDir == -1 and barstate.isconfirmed and not na(edgeSignalInvalid) and close > edgeSignalInvalid

if edgeSignalInvalidated
    edgeSignalDir := 0
    edgeSignalEntry := na
    edgeSignalInvalid := na
    edgeSignalTf := "--"
    edgeSignalBar := na

string edgeSignalText =
     edgeSignalDir == 1 ? "⚡ BUY CONFIRMED • ZONE EDGE" :
     edgeSignalDir == -1 ? "⚡ SELL CONFIRMED • ZONE EDGE" :
     sellTestGreen ? "SELL ZONE • GREEN TEST ✓ • WAIT RED" :
     buyTestRed ? "BUY ZONE • RED TEST ✓ • WAIT GREEN" :
     "⚡ ZONE EDGE • WAIT"

// Premium sideways / trade-quality calculations.
float currentAtr = ta.atr(14)
float ema200Slope = ema200 - ema200[emaSlopeLookback]
float emaSlopeAtr = not na(currentAtr) and currentAtr > 0 ? math.abs(ema200Slope) / currentAtr : 0.0
bool emaSlopeReady = emaSlopeAtr >= minEmaSlopeAtr

// Gap between the nearest BUY-zone top and nearest SELL-zone bottom.
// Positive = clean room between zones; zero/negative = overlapping/compressed.
float rawZoneGap = not na(nearestBuyTopFull) and not na(nearestSellBotFull) ?
     nearestSellBotFull - nearestBuyTopFull : na
float zoneGapAtr = not na(rawZoneGap) and not na(currentAtr) and currentAtr > 0 ?
     rawZoneGap / currentAtr : na
bool zoneGapReady = na(zoneGapAtr) or zoneGapAtr >= minZoneGapAtr

bool mtfBuyAgreement = trend5 == 1 and trend15 == 1
bool mtfSellAgreement = trend5 == -1 and trend15 == -1
bool mtfAgreementReady = not requireMtfAgreement or mtfBuyAgreement or mtfSellAgreement

// Market state.
bool adxReady = not requireAdx or adx5 >= adxReadyLevel
bool adxCaution = requireAdx and adx5 >= adxCautionLevel and adx5 < adxReadyLevel
bool trendBuyAligned = trend5 == 1 and trend15 == 1
bool trendSellAligned = trend5 == -1 and trend15 == -1

bool bullishChochConfirmed = lastChochDir == 1
bool bearishChochConfirmed = lastChochDir == -1

// Preliminary stop-risk and available room calculations.
float previewBuySL = not na(nearestBuyBotFull) ? nearestBuyBotFull - currentAtr * zoneBufferAtr : na
float previewSellSL = not na(nearestSellTopFull) ? nearestSellTopFull + currentAtr * zoneBufferAtr : na
float previewBuyRisk = not na(previewBuySL) ? math.max(close - previewBuySL, syminfo.mintick * 10) : na
float previewSellRisk = not na(previewSellSL) ? math.max(previewSellSL - close, syminfo.mintick * 10) : na

float buyRoom = not na(nearestSellBotFull) ? nearestSellBotFull - close : na
float sellRoom = not na(nearestBuyTopFull) ? close - nearestBuyTopFull : na
float buyRoomRR = not na(buyRoom) and not na(previewBuyRisk) and previewBuyRisk > 0 ? buyRoom / previewBuyRisk : na
float sellRoomRR = not na(sellRoom) and not na(previewSellRisk) and previewSellRisk > 0 ? sellRoom / previewSellRisk : na

bool buyRoomReady = na(buyRoomRR) or buyRoomRR >= minRoomRR
bool sellRoomReady = na(sellRoomRR) or sellRoomRR >= minRoomRR

bool commonQualityReady = not useSidewaysFilter or
     (adxReady and zoneGapReady and emaSlopeReady and mtfAgreementReady)

bool buyQualityReady = commonQualityReady and buyRoomReady and
     (not requireMtfAgreement or mtfBuyAgreement)
bool sellQualityReady = commonQualityReady and sellRoomReady and
     (not requireMtfAgreement or mtfSellAgreement)

bool buySetupNow = barstate.isconfirmed and inBuyZone and trendBuyAligned and
     bullishChochConfirmed and buyQualityReady
bool sellSetupNow = barstate.isconfirmed and inSellZone and trendSellAligned and
     bearishChochConfirmed and sellQualityReady

//=============================================================================
// OPTIONAL UP / DOWN ZONE TP GUIDANCE
// Completely independent from Flight BUY/SELL control.
// UP/DOWN zone setup can run as a short zone trade while the Flight trade
// continues in its own direction.
//=============================================================================
float zoneTpAtrValue = ta.atr(zoneTpAtrLen)

// ZONE TRADE SIGNAL — confirmation candle inside ANY existing zone.
// A BUY/SELL zone is LOCATION only. It does not itself tell members to trade.
// Direction comes only from the already-existing confirmed reversal candle.
bool inAnyTradeZone = inBuyZone or inSellZone

float buyZoneWidthNow = not na(nearestBuyTopFull) and not na(nearestBuyBotFull) ?
     math.abs(nearestBuyTopFull - nearestBuyBotFull) : na
float sellZoneWidthNow = not na(nearestSellTopFull) and not na(nearestSellBotFull) ?
     math.abs(nearestSellTopFull - nearestSellBotFull) : na

bool useBuyZoneContext = inBuyZone and not inSellZone ? true :
     inSellZone and not inBuyZone ? false :
     inBuyZone and inSellZone ? (na(sellZoneWidthNow) or
     (not na(buyZoneWidthNow) and buyZoneWidthNow <= sellZoneWidthNow)) : false

string activeTradeZoneTf = useBuyZoneContext ? nearestBuyTF :
     inSellZone ? nearestSellTF : "--"
int activeTradeZoneTime = useBuyZoneContext ? nearestBuyTimeFull :
     inSellZone ? nearestSellTimeFull : na

// REAL A-B-C MODEL 1 — VISIBLE ZONE B + ⚡ SIGNAL
// Flight BUY/SELL below is untouched.

// New ⚡ event = a Model source timeframe has just moved into Stage 5,
// which is the NEXT candle after a valid closed Zone-B retest.
bool e1Bull = m1BullStage == 5 and m1BullStage[1] != 5
bool e5Bull = m5BullStage == 5 and m5BullStage[1] != 5
bool e15Bull = m15BullStage == 5 and m15BullStage[1] != 5
bool e30Bull = m30BullStage == 5 and m30BullStage[1] != 5
bool e1hBull = h1BullStage == 5 and h1BullStage[1] != 5
bool e4hBull = h4BullStage == 5 and h4BullStage[1] != 5
bool eD1Bull = d1BullStage == 5 and d1BullStage[1] != 5

bool e1Bear = m1BearStage == 5 and m1BearStage[1] != 5
bool e5Bear = m5BearStage == 5 and m5BearStage[1] != 5
bool e15Bear = m15BearStage == 5 and m15BearStage[1] != 5
bool e30Bear = m30BearStage == 5 and m30BearStage[1] != 5
bool e1hBear = h1BearStage == 5 and h1BearStage[1] != 5
bool e4hBear = h4BearStage == 5 and h4BearStage[1] != 5
bool eD1Bear = d1BearStage == 5 and d1BearStage[1] != 5

bool newUpZoneSignal = false
bool newDownZoneSignal = false

// Resolve exact levels for the CURRENT CHART TF only.
float eventBullTop = newUpZoneSignal ? chartBullTop : na
float eventBullBot = newUpZoneSignal ? chartBullBot : na
float eventBullA = newUpZoneSignal ? chartBullA : na
float eventBullC = newUpZoneSignal ? chartBullC : na
string eventBullTF = newUpZoneSignal ? chartModelTF : "--"
int eventBullBTime = newUpZoneSignal ? chartBullBTime : na

float eventBearTop = newDownZoneSignal ? chartBearTop : na
float eventBearBot = newDownZoneSignal ? chartBearBot : na
float eventBearA = newDownZoneSignal ? chartBearA : na
float eventBearC = newDownZoneSignal ? chartBearC : na
string eventBearTF = newDownZoneSignal ? chartModelTF : "--"
int eventBearBTime = newDownZoneSignal ? chartBearBTime : na

// Small internal Model-1 trade state used only for P/L, BE and persistent ⚡ alerts.
var int zoneTradeDir = 0
var float zoneTradeEntry = na         // actual confirmation-candle close
var float zoneTradePointB = na        // structural Point B / invalidation reference
var float zoneTradeInvalid = na
var float zoneTradeTargetC = na       // Point C = TP1 only, NOT final target
var string zoneTradeTf = "--"
var bool zoneTradeBeLocked = false
var bool zoneTradeC1Hit = false
var string zoneTradeLastExit = "--"
var int zoneTradeLastExitBar = na
var int zoneTradeCycle = 0
var label zoneSignalLabel = na
var label zoneNoTradeLabel = na

if newUpZoneSignal and not na(eventBullBot)
    // Opposite/new Model confirmation REPLACES any older simulated trade.
    zoneTradeDir := 1
    zoneTradeEntry := close              // actual BUY confirmation close
    zoneTradePointB := eventBullBot      // structural B reference
    zoneTradeInvalid := eventBullBot     // closed below B invalidates
    zoneTradeTargetC := not na(eventBullC) and eventBullC > close ? eventBullC : na
    zoneTradeTf := eventBullTF
    zoneTradeBeLocked := false
    zoneTradeC1Hit := false
    zoneTradeLastExit := "--"
    zoneTradeLastExitBar := na
    zoneTradeCycle += 1

    // Make the signalled TF the visible bullish Model-1 zone.
    modelBuyTop := eventBullTop
    modelBuyBot := eventBullBot
    modelBuyA := eventBullA
    modelBuyC := eventBullC
    modelBuyStage := 5
    modelBuyBTime := eventBullBTime
    modelBuyTF := eventBullTF


if newDownZoneSignal and not na(eventBearTop)
    // Opposite/new Model confirmation REPLACES any older simulated trade.
    zoneTradeDir := -1
    zoneTradeEntry := close              // actual SELL confirmation close
    zoneTradePointB := eventBearTop      // structural B reference
    zoneTradeInvalid := eventBearTop     // closed above B invalidates
    zoneTradeTargetC := not na(eventBearC) and eventBearC < close ? eventBearC : na
    zoneTradeTf := eventBearTF
    zoneTradeBeLocked := false
    zoneTradeC1Hit := false
    zoneTradeLastExit := "--"
    zoneTradeLastExitBar := na
    zoneTradeCycle += 1

    modelSellTop := eventBearTop
    modelSellBot := eventBearBot
    modelSellA := eventBearA
    modelSellC := eventBearC
    modelSellStage := 5
    modelSellBTime := eventBearBTime
    modelSellTF := eventBearTF


// Raw simulated P/L from the ACTUAL Model confirmation entry.
float modelRunningProfitRaw = f_dashboardPl(zoneTradeEntry, zoneTradeDir)

// Point C is TP1 only. Reaching C does NOT close the setup.
bool modelC1HitNow =
     zoneTradeDir != 0 and not zoneTradeC1Hit and not na(zoneTradeTargetC) and
     ((zoneTradeDir == 1 and high >= zoneTradeTargetC) or
      (zoneTradeDir == -1 and low <= zoneTradeTargetC))

if modelC1HitNow
    zoneTradeC1Hit := true

if zoneTradeDir != 0 and not zoneTradeBeLocked and not na(modelRunningProfitRaw) and modelRunningProfitRaw >= beTriggerProfitUsd
    zoneTradeBeLocked := true

bool modelClosedAtBE =
     zoneTradeBeLocked and barstate.isconfirmed and
     ((zoneTradeDir == 1 and close <= zoneTradeEntry) or
      (zoneTradeDir == -1 and close >= zoneTradeEntry))

bool modelInvalid =
     zoneTradeDir == 1 and barstate.isconfirmed and close < zoneTradeInvalid or
     zoneTradeDir == -1 and barstate.isconfirmed and close > zoneTradeInvalid

if modelClosedAtBE or modelInvalid
    zoneTradeLastExit := modelClosedAtBE ? "BE CLOSED" : "MODEL INVALIDATED"
    zoneTradeLastExitBar := bar_index
    zoneTradeDir := 0
    zoneTradeEntry := na
    zoneTradePointB := na
    zoneTradeInvalid := na
    zoneTradeTargetC := na
    zoneTradeTf := "--"
    zoneTradeBeLocked := false
    zoneTradeC1Hit := false


// Visible Model-1 Zone B boxes. These are NOT the generic Flight zones.
var box abcBuyBox = na
var box abcSellBox = na
var line abcBuyBLine = na
var line abcSellBLine = na
var line abcBuyALine = na
var line abcSellALine = na
var line abcBuyCLine = na
var line abcSellCLine = na
var label abcBuyBLabel = na
var label abcSellBLabel = na
var label abcBuyALabel = na
var label abcBuyCLabel = na
var label abcSellALabel = na
var label abcSellCLabel = na

bool abcBuyChanged = barstate.isconfirmed and (
     modelBuyTop != modelBuyTop[1] or modelBuyBot != modelBuyBot[1] or
     modelBuyTF != modelBuyTF[1] or modelBuyStage != modelBuyStage[1] or
     modelBuyA != modelBuyA[1] or modelBuyC != modelBuyC[1])
bool abcSellChanged = barstate.isconfirmed and (
     modelSellTop != modelSellTop[1] or modelSellBot != modelSellBot[1] or
     modelSellTF != modelSellTF[1] or modelSellStage != modelSellStage[1] or
     modelSellA != modelSellA[1] or modelSellC != modelSellC[1])

if abcBuyChanged
    if not na(abcBuyBox)
        box.delete(abcBuyBox)
    if not na(abcBuyBLine)
        line.delete(abcBuyBLine)
    if not na(abcBuyALine)
        line.delete(abcBuyALine)
    if not na(abcBuyCLine)
        line.delete(abcBuyCLine)
    if not na(abcBuyBLabel)
        label.delete(abcBuyBLabel)
    if not na(abcBuyALabel)
        label.delete(abcBuyALabel)
    if not na(abcBuyCLabel)
        label.delete(abcBuyCLabel)

    if showModelStructure and not na(modelBuyTop) and not na(modelBuyBot) and not na(modelBuyBTime)
        abcBuyBox := box.new(modelBuyBTime, modelBuyTop, time, modelBuyBot,
             xloc=xloc.bar_time, extend=extend.right,
             bgcolor=color.new(bullColor, 91), border_color=gold, border_width=2,
             text="MODEL 1 • ZONE B (DEMAND) • " + modelBuyTF, text_color=bullColor, text_size=size.small)
        abcBuyBLine := line.new(modelBuyBTime, modelBuyBot, time, modelBuyBot,
             xloc=xloc.bar_time, extend=extend.right, color=gold, width=2, style=line.style_dashed)
        abcBuyBLabel := label.new(modelBuyBTime, modelBuyBot,
             "B • ZONE B REF  " + str.tostring(modelBuyBot, format.mintick),
             xloc=xloc.bar_time, style=label.style_label_up, color=darkBg, textcolor=gold, size=size.small)
        if not na(modelBuyA)
            abcBuyALine := line.new(modelBuyBTime, modelBuyA, time, modelBuyA,
                 xloc=xloc.bar_time, extend=extend.right, color=color.new(bullColor, 45), width=1, style=line.style_dotted)
            abcBuyALabel := label.new(modelBuyBTime, modelBuyA, "A • BOS LEVEL",
                 xloc=xloc.bar_time, style=label.style_label_left, color=darkBg, textcolor=bullColor, size=size.tiny)
        if not na(modelBuyC) and not (zoneTradeDir == 1 and zoneTradeC1Hit)
            abcBuyCLine := line.new(time, modelBuyC, time + 1, modelBuyC,
                 xloc=xloc.bar_time, extend=extend.right, color=color.new(bullColor, 15), width=1, style=line.style_dashed)
            abcBuyCLabel := label.new(time, modelBuyC, "C • TP1 STRUCTURE",
                 xloc=xloc.bar_time, style=label.style_label_left, color=darkBg, textcolor=bullColor, size=size.tiny)

if abcSellChanged
    if not na(abcSellBox)
        box.delete(abcSellBox)
    if not na(abcSellBLine)
        line.delete(abcSellBLine)
    if not na(abcSellALine)
        line.delete(abcSellALine)
    if not na(abcSellCLine)
        line.delete(abcSellCLine)
    if not na(abcSellBLabel)
        label.delete(abcSellBLabel)
    if not na(abcSellALabel)
        label.delete(abcSellALabel)
    if not na(abcSellCLabel)
        label.delete(abcSellCLabel)

    if showModelStructure and not na(modelSellTop) and not na(modelSellBot) and not na(modelSellBTime)
        abcSellBox := box.new(modelSellBTime, modelSellTop, time, modelSellBot,
             xloc=xloc.bar_time, extend=extend.right,
             bgcolor=color.new(bearColor, 92), border_color=gold, border_width=2,
             text="MODEL 1 • ZONE B (SUPPLY) • " + modelSellTF, text_color=bearColor, text_size=size.small)
        abcSellBLine := line.new(modelSellBTime, modelSellTop, time, modelSellTop,
             xloc=xloc.bar_time, extend=extend.right, color=gold, width=2, style=line.style_dashed)
        abcSellBLabel := label.new(modelSellBTime, modelSellTop,
             "B • ZONE B REF  " + str.tostring(modelSellTop, format.mintick),
             xloc=xloc.bar_time, style=label.style_label_down, color=darkBg, textcolor=gold, size=size.small)
        if not na(modelSellA)
            abcSellALine := line.new(modelSellBTime, modelSellA, time, modelSellA,
                 xloc=xloc.bar_time, extend=extend.right, color=color.new(bearColor, 45), width=1, style=line.style_dotted)
            abcSellALabel := label.new(modelSellBTime, modelSellA, "A • BOS LEVEL",
                 xloc=xloc.bar_time, style=label.style_label_left, color=darkBg, textcolor=bearColor, size=size.tiny)
        if not na(modelSellC) and not (zoneTradeDir == -1 and zoneTradeC1Hit)
            abcSellCLine := line.new(time, modelSellC, time + 1, modelSellC,
                 xloc=xloc.bar_time, extend=extend.right, color=color.new(bearColor, 15), width=1, style=line.style_dashed)
            abcSellCLabel := label.new(time, modelSellC, "C • TP1 STRUCTURE",
                 xloc=xloc.bar_time, style=label.style_label_left, color=darkBg, textcolor=bearColor, size=size.tiny)

// TP1 CLEANUP:
// After Point C / TP1 is hit, it is no longer an ACTIVE TARGET.
// Remove the C target line/label from the chart and continue only as RUNNER.
if zoneTradeC1Hit
    if zoneTradeDir == 1
        if not na(abcBuyCLine)
            line.delete(abcBuyCLine)
            abcBuyCLine := na
        if not na(abcBuyCLabel)
            label.delete(abcBuyCLabel)
            abcBuyCLabel := na
    if zoneTradeDir == -1
        if not na(abcSellCLine)
            line.delete(abcSellCLine)
            abcSellCLine := na
        if not na(abcSellCLabel)
            label.delete(abcSellCLabel)
            abcSellCLabel := na

string zoneTradeStatus =
     zoneTradeDir == 1 ? "⚡ BULL POINT B ACTIVE" :
     zoneTradeDir == -1 ? "⚡ BEAR POINT B ACTIVE" : "WAIT"

//=============================================================================
// ELITE V3.2 — INTERNAL CONTROL ENGINE

// Hidden logic may use pivots, market structure, CHoCH, zone strength,
// trend agreement and zone validity. Members only see the final decision.
//=============================================================================

// Track nearest-zone identity, age and retests.
var int trackedBuyZoneTime = na
var int trackedSellZoneTime = na
var int buyZoneFirstSeen = na
var int sellZoneFirstSeen = na
var int buyRetests = 0
var int sellRetests = 0
var bool wasInBuyZone = false
var bool wasInSellZone = false

bool buyZoneChanged = nearestBuyTimeFull != trackedBuyZoneTime
bool sellZoneChanged = nearestSellTimeFull != trackedSellZoneTime

if buyZoneChanged
    trackedBuyZoneTime := nearestBuyTimeFull
    buyZoneFirstSeen := time
    buyRetests := 0
    wasInBuyZone := false

if sellZoneChanged
    trackedSellZoneTime := nearestSellTimeFull
    sellZoneFirstSeen := time
    sellRetests := 0
    wasInSellZone := false

if inBuyZone and not wasInBuyZone
    buyRetests += 1
if inSellZone and not wasInSellZone
    sellRetests += 1

wasInBuyZone := inBuyZone
wasInSellZone := inSellZone

f_ageText(int firstSeen) =>
    if na(firstSeen)
        "NEW"
    else
        int mins = int(math.max(0, (timenow - firstSeen) / 60000))
        int hrs = int(math.floor(mins / 60))
        int days = int(math.floor(hrs / 24))
        int remHrs = hrs % 24
        int remMins = mins % 60
        mins <= 1 ? "NEW" :
         mins < 60 ? str.tostring(mins) + "m" :
         hrs < 24 ? str.tostring(hrs) + "h " + str.tostring(remMins) + "m" :
         days < 30 ? str.tostring(days) + "D " + str.tostring(remHrs) + "h" :
         "30D+"

f_eventAgeText(int eventTime) =>
    if na(eventTime)
        "--"
    else
        int mins = int(math.max(0, (timenow - eventTime) / 60000))
        int hrs = int(math.floor(mins / 60))
        int remMins = mins % 60
        mins <= 1 ? "NOW" :
         hrs > 0 ? str.tostring(hrs) + "h " + str.tostring(remMins) + "m AGO" :
         str.tostring(mins) + "m AGO"

f_grade(float score) =>
    score >= 95 ? "A+" :
     score >= 85 ? "A" :
     score >= 75 ? "B+" :
     score >= 65 ? "B" :
     score >= 50 ? "C" : "D"

f_strengthColor(float score) =>
    score >= 84 ? bullColor :
     score >= 64 ? neutralColor : bearColor

float buyTfScore = nearestBuyTF == "4H" ? 20.0 :
     nearestBuyTF == "1H" ? 16.0 :
     nearestBuyTF == "15M" ? 11.0 :
     nearestBuyTF == "5M" ? 7.0 : 0.0

float sellTfScore = nearestSellTF == "4H" ? 20.0 :
     nearestSellTF == "1H" ? 16.0 :
     nearestSellTF == "15M" ? 11.0 :
     nearestSellTF == "5M" ? 7.0 : 0.0

float adxStrengthScore = adx5 >= 35 ? 16.0 :
     adx5 >= 25 ? 12.0 :
     adx5 >= 20 ? 6.0 : 0.0

// Hidden pivot / structure confirmation.
float internalPivotHigh = ta.pivothigh(high, controlPivotLen, controlPivotLen)
float internalPivotLow = ta.pivotlow(low, controlPivotLen, controlPivotLen)

var float lastInternalHigh = na
var float prevInternalHigh = na
var float lastInternalLow = na
var float prevInternalLow = na

if not na(internalPivotHigh)
    prevInternalHigh := lastInternalHigh
    lastInternalHigh := internalPivotHigh

if not na(internalPivotLow)
    prevInternalLow := lastInternalLow
    lastInternalLow := internalPivotLow

bool internalHH = not na(lastInternalHigh) and not na(prevInternalHigh) and lastInternalHigh > prevInternalHigh
bool internalLH = not na(lastInternalHigh) and not na(prevInternalHigh) and lastInternalHigh < prevInternalHigh
bool internalHL = not na(lastInternalLow) and not na(prevInternalLow) and lastInternalLow > prevInternalLow
bool internalLL = not na(lastInternalLow) and not na(prevInternalLow) and lastInternalLow < prevInternalLow

bool internalBullStructure = internalHH or internalHL
bool internalBearStructure = internalLH or internalLL

// Zone strength remains member-facing, but its calculation stays hidden.
float buyStrengthRaw = 42.0 + buyTfScore + adxStrengthScore
buyStrengthRaw += mtfBuyAgreement ? 12.0 : trend5 == 1 ? 5.0 : 0.0
buyStrengthRaw += bullishChochConfirmed ? 8.0 : 0.0
buyStrengthRaw += internalBullStructure ? 8.0 : 0.0
buyStrengthRaw += zoneGapReady ? 5.0 : 0.0
buyStrengthRaw += buyRetests <= 1 ? 9.0 : buyRetests == 2 ? 5.0 : buyRetests == 3 ? 1.0 : -6.0
float buyStrength = math.max(20.0, math.min(99.0, buyStrengthRaw))

float sellStrengthRaw = 42.0 + sellTfScore + adxStrengthScore
sellStrengthRaw += mtfSellAgreement ? 12.0 : trend5 == -1 ? 5.0 : 0.0
sellStrengthRaw += bearishChochConfirmed ? 8.0 : 0.0
sellStrengthRaw += internalBearStructure ? 8.0 : 0.0
sellStrengthRaw += zoneGapReady ? 5.0 : 0.0
sellStrengthRaw += sellRetests <= 1 ? 9.0 : sellRetests == 2 ? 5.0 : sellRetests == 3 ? 1.0 : -6.0
float sellStrength = math.max(20.0, math.min(99.0, sellStrengthRaw))

string buyGrade = f_grade(buyStrength)
string sellGrade = f_grade(sellStrength)

// Hidden control scores. The dashboard never exposes these components.
float buyControlScore = buyStrength
buyControlScore += inBuyZone ? 8.0 : 0.0
buyControlScore += bullishChochConfirmed ? 8.0 : 0.0
buyControlScore += internalBullStructure ? 8.0 : 0.0
buyControlScore += mtfBuyAgreement ? 6.0 : 0.0

float sellControlScore = sellStrength
sellControlScore += inSellZone ? 8.0 : 0.0
sellControlScore += bearishChochConfirmed ? 8.0 : 0.0
sellControlScore += internalBearStructure ? 8.0 : 0.0
sellControlScore += mtfSellAgreement ? 6.0 : 0.0

bool fullBuyConfirmation = barstate.isconfirmed and
     buyControlScore >= controlMinScore and
     bullishChochConfirmed and
     internalBullStructure and
     (inBuyZone or close > nearestBuyTopFull)

bool fullSellConfirmation = barstate.isconfirmed and
     sellControlScore >= controlMinScore and
     bearishChochConfirmed and
     internalBearStructure and
     (inSellZone or close < nearestSellBotFull)

//=============================================================================
// V6.0 FRESH MARKET-CONTROL STATE MACHINE
//
// HH / HL / LH / LL, pivots, CHoCH, EMA200 and zones are used internally.
// Members only see BUY ACTIVE, SELL ACTIVE, SIDEWAYS or WAIT FOR ZONE.
//
// Important:
// - A small pullback cannot reverse control.
// - A genuine opposite-zone reaction + pivot break can reverse control.
// - No old-direction score advantage is required after a confirmed takeover.
//=============================================================================

// Persistent market state.
var int radarDir = 0                    // 1 BUY, -1 SELL, 0 neutral
var float radarEntry = na
var float radarEntryLot = na              // SFA lot locked at FLIGHT entry
var float activeZoneTop = na
var float activeZoneBottom = na
var int radarStartTime = na
var int radarStartBar = na
var string radarFinal = ""
var int radarLastEventTime = na
var int radarLastAlertBar = na

// One active arrow only.
var label activeTrendArrow = na
var int lastArrowDir = 0

// Takeover confirmation counters.
var int bullTakeoverCount = 0
var int bearTakeoverCount = 0

// Remember the most recent time price touched each side.
var int lastBuyZoneTouchBar = na
var int lastSellZoneTouchBar = na

if inBuyZone
    lastBuyZoneTouchBar := bar_index
if inSellZone
    lastSellZoneTouchBar := bar_index

bool recentBuyZoneTouch = not na(lastBuyZoneTouchBar) and
     bar_index - lastBuyZoneTouchBar <= takeoverWindowBars
bool recentSellZoneTouch = not na(lastSellZoneTouchBar) and
     bar_index - lastSellZoneTouchBar <= takeoverWindowBars

// Live pivot breaks use the last confirmed pivot values.
// This reacts faster than waiting for a new HH/HL label to be fully formed.
bool breakAbovePivot = not na(lastInternalHigh) and close > lastInternalHigh
bool breakBelowPivot = not na(lastInternalLow) and close < lastInternalLow

float candleBody = math.abs(close - open)
bool strongBullBody = close > open and candleBody >= currentAtr * takeoverBodyAtr
bool strongBearBody = close < open and candleBody >= currentAtr * takeoverBodyAtr

float recentSwingLow = ta.lowest(low, controlPivotLen * 4 + 4)
float recentSwingHigh = ta.highest(high, controlPivotLen * 4 + 4)

bool bullExpansion = close - recentSwingLow >= currentAtr * takeoverMoveAtr
bool bearExpansion = recentSwingHigh - close >= currentAtr * takeoverMoveAtr

// Fresh takeover confirmation.
// Zone reaction + pivot break are the core requirements.
// Structure/CHOCH/EMA200 support the confirmation but one lagging item
// cannot keep the dashboard stuck forever.
bool bullTakeoverRaw = barstate.isconfirmed and
     recentBuyZoneTouch and
     breakAbovePivot and
     strongBullBody and
     bullExpansion and
     close > ema200 and
     (internalBullStructure or bullishChochConfirmed or trend5 == 1)

bool bearTakeoverRaw = barstate.isconfirmed and
     recentSellZoneTouch and
     breakBelowPivot and
     strongBearBody and
     bearExpansion and
     close < ema200 and
     (internalBearStructure or bearishChochConfirmed or trend5 == -1)

// Continue confirmation briefly after the actual break candle.
bool bullTakeoverFollow = radarDir == -1 and bullTakeoverCount > 0 and
     close > ema200 and close > lastInternalHigh
bool bearTakeoverFollow = radarDir == 1 and bearTakeoverCount > 0 and
     close < ema200 and close < lastInternalLow

if bullTakeoverRaw or bullTakeoverFollow
    bullTakeoverCount += 1
else
    bullTakeoverCount := 0

if bearTakeoverRaw or bearTakeoverFollow
    bearTakeoverCount += 1
else
    bearTakeoverCount := 0

bool confirmedBullTakeover = bullTakeoverCount >= takeoverConfirmBars
bool confirmedBearTakeover = bearTakeoverCount >= takeoverConfirmBars

// Initial state: use the strongest complete setup, or a confirmed live takeover.
if radarDir == 0
    if confirmedBullTakeover or (fullBuyConfirmation and buyControlScore >= sellControlScore)
        radarDir := 1
        radarEntry := close
        radarEntryLot := dashboardLotSize
        activeZoneTop := nearestBuyTopFull
        activeZoneBottom := nearestBuyBotFull
        radarStartTime := time
        radarStartBar := bar_index
        radarFinal := "BUY CONTROL STARTED"
        radarLastEventTime := time
        radarLastAlertBar := na
        bullTakeoverCount := 0
        bearTakeoverCount := 0
    else if confirmedBearTakeover or (fullSellConfirmation and sellControlScore >= buyControlScore)
        radarDir := -1
        radarEntry := close
        radarEntryLot := dashboardLotSize
        activeZoneTop := nearestSellTopFull
        activeZoneBottom := nearestSellBotFull
        radarStartTime := time
        radarStartBar := bar_index
        radarFinal := "SELL CONTROL STARTED"
        radarLastEventTime := time
        radarLastAlertBar := na
        bullTakeoverCount := 0
        bearTakeoverCount := 0

// Direct confirmed takeover.
// The old direction is replaced immediately after the required closed bars.
if radarDir == -1 and confirmedBullTakeover
    radarDir := 1
    radarEntry := close
    radarEntryLot := dashboardLotSize
    activeZoneTop := nearestBuyTopFull
    activeZoneBottom := nearestBuyBotFull
    radarStartTime := time
    radarStartBar := bar_index
    radarFinal := "BUY TAKEOVER CONFIRMED"
    radarLastEventTime := time
    radarLastAlertBar := na
    bullTakeoverCount := 0
    bearTakeoverCount := 0

if radarDir == 1 and confirmedBearTakeover
    radarDir := -1
    radarEntry := close
    radarEntryLot := dashboardLotSize
    activeZoneTop := nearestSellTopFull
    activeZoneBottom := nearestSellBotFull
    radarStartTime := time
    radarStartBar := bar_index
    radarFinal := "SELL TAKEOVER CONFIRMED"
    radarLastEventTime := time
    radarLastAlertBar := na
    bullTakeoverCount := 0
    bearTakeoverCount := 0

// Neutralise only when the active zone is broken AND opposite structure confirms.
// A normal pullback cannot end the active state.
bool buyControlBroken = radarDir == 1 and barstate.isconfirmed and
     not na(activeZoneBottom) and close < activeZoneBottom and
     breakBelowPivot and (internalBearStructure or bearishChochConfirmed)

bool sellControlBroken = radarDir == -1 and barstate.isconfirmed and
     not na(activeZoneTop) and close > activeZoneTop and
     breakAbovePivot and (internalBullStructure or bullishChochConfirmed)

if buyControlBroken and not confirmedBearTakeover
    radarDir := 0
    radarEntry := na
    radarEntryLot := na
    activeZoneTop := na
    activeZoneBottom := na
    radarStartTime := na
    radarStartBar := na
    radarFinal := "BUY CONTROL ENDED"
    radarLastEventTime := time
    radarLastAlertBar := na

if sellControlBroken and not confirmedBullTakeover
    radarDir := 0
    radarEntry := na
    radarEntryLot := na
    activeZoneTop := na
    activeZoneBottom := na
    radarStartTime := na
    radarStartBar := na
    radarFinal := "SELL CONTROL ENDED"
    radarLastEventTime := time
    radarLastAlertBar := na

//=============================================================================
// MAIN FLIGHT CHART SIGNAL
//=============================================================================
float trendArrowAtr = math.max(ta.atr(14), syminfo.mintick * 20)
float flightMarkerGap =
     math.max(
         trendArrowAtr * trendArrowGapAtr,
         (high - low) * 1.25,
         syminfo.mintick * 60)

bool flightBuySignalEvent =
     barstate.isconfirmed and radarDir == 1 and radarDir != nz(radarDir[1], 0)

bool flightSellSignalEvent =
     barstate.isconfirmed and radarDir == -1 and radarDir != nz(radarDir[1], 0)

bool flightEndedEvent =
     barstate.isconfirmed and radarDir == 0 and nz(radarDir[1], 0) != 0

if showFlightOnChart and radarDir != lastArrowDir
    if not na(activeTrendArrow)
        label.delete(activeTrendArrow)
        activeTrendArrow := na

    int arrowBar = nz(radarStartBar, bar_index)

    if radarDir == 1
        float buyArrowPrice = low - flightMarkerGap
        activeTrendArrow := label.new(
             arrowBar,
             buyArrowPrice,
             "🐋 WHALE BUY",
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=label.style_label_up,
             color=color.new(bullColor, 0),
             textcolor=color.white,
             size=f_flightChartSize(),
             tooltip="SFA WHALE BUY\nSame locked main signal logic. Remains active until WHALE SELL or signal end.")

    else if radarDir == -1
        float sellArrowPrice = high + flightMarkerGap
        activeTrendArrow := label.new(
             arrowBar,
             sellArrowPrice,
             "🐋 WHALE SELL",
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=label.style_label_down,
             color=color.new(bearColor, 0),
             textcolor=color.white,
             size=f_flightChartSize(),
             tooltip="SFA WHALE SELL\nSame locked main signal logic. Remains active until WHALE BUY or signal end.")

    lastArrowDir := radarDir

if not showFlightOnChart and not na(activeTrendArrow)
    label.delete(activeTrendArrow)
    activeTrendArrow := na
    lastArrowDir := radarDir

bool marketSideways = radarDir == 0 and useSidewaysFilter and
     (adx5 < adxCautionLevel or not zoneGapReady or not emaSlopeReady or not mtfAgreementReady)

// NO TRADE is valid only when BUY/SELL zones are compressed
// AND price is actually near/inside one of those zones.
float zoneActionNearAtr = 0.25
bool zoneNearPrice =
     inBuyZone or inSellZone or
     (not na(buyDistance) and buyDistance <= currentAtr * zoneActionNearAtr) or
     (not na(sellDistance) and sellDistance <= currentAtr * zoneActionNearAtr)

bool zoneNoTradeNow = not zoneGapReady and zoneNearPrice
bool zoneNoTradeEvent = zoneNoTradeNow and not zoneNoTradeNow[1]
bool zoneNoTradeExit = not zoneNoTradeNow and zoneNoTradeNow[1]

bool showNoTradeBadgeOnChart = false

if showNoTradeBadgeOnChart and zoneNoTradeEvent
    if not na(zoneNoTradeLabel)
        label.delete(zoneNoTradeLabel)
    zoneNoTradeLabel := label.new(
         bar_index,
         high + math.max(ta.atr(14) * 0.18, syminfo.mintick * 10),
         "⚠ NO TRADE",
         xloc=xloc.bar_index,
         yloc=yloc.price,
         style=label.style_label_down,
         color=color.rgb(202, 138, 4),
         textcolor=color.white,
         size=f_zoneSignalSize(),
         tooltip="BUY/SELL zones compressed near price")

if zoneNoTradeExit and not na(zoneNoTradeLabel)
    label.delete(zoneNoTradeLabel)
    zoneNoTradeLabel := na

// A confirmed UP/DOWN always removes temporary NO TRADE.
if (newUpZoneSignal or newDownZoneSignal) and not na(zoneNoTradeLabel)
    label.delete(zoneNoTradeLabel)
    zoneNoTradeLabel := na

string uiMarketState =
     marketSideways ? "SIDEWAYS" :
     radarDir == 1 ? "TRENDING UP" :
     radarDir == -1 ? "TRENDING DOWN" :
     "WAIT"

var int uiUpCountToday = 0
var int uiDownCountToday = 0
bool uiNewDay = dayofmonth != dayofmonth[1] or month != month[1] or year != year[1]
if uiNewDay
    uiUpCountToday := 0
    uiDownCountToday := 0
if newUpZoneSignal
    uiUpCountToday += 1
if newDownZoneSignal
    uiDownCountToday += 1


f_qualityLabel(float score) =>
    score >= 95 ? "ELITE" :
     score >= 85 ? "PREMIUM" :
     score >= 75 ? "STRONG" :
     score >= 65 ? "GOOD" :
     score >= 50 ? "FAIR" : "WEAK"

f_qualityBar(float score) =>
    int filled = int(math.round(math.max(0.0, math.min(100.0, score)) / 20.0))
    filled >= 5 ? "★★★★★" :
     filled == 4 ? "★★★★☆" :
     filled == 3 ? "★★★☆☆" :
     filled == 2 ? "★★☆☆☆" :
     filled == 1 ? "★☆☆☆☆" : "☆☆☆☆☆"

f_zoneLife(int retests, float strength) =>
    retests == 0 ? "FRESH" :
     retests == 1 ? "TESTED" :
     retests == 2 ? "RETEST 2" :
     retests == 3 and strength >= 65 ? "RETEST 3" :
     strength < 55 ? "WEAK" : "MATURE"

f_timeText(int eventTime) =>
    if na(eventTime)
        "--"
    else
        str.format_time(eventTime, "HH:mm", "Europe/London")

// -----------------------------------------------------------------------------
// FINAL MODEL-1 / FLIGHT DISPLAY VARIABLES
// -----------------------------------------------------------------------------
string buyZoneStatus = f_modelStageText(modelBuyStage, true)
string sellZoneStatus = f_modelStageText(modelSellStage, false)

color buyStatusColor =
     modelBuyStage == 5 ? bullColor :
     modelBuyStage >= 3 ? neutralColor : color.silver

color sellStatusColor =
     modelSellStage == 5 ? bearColor :
     modelSellStage >= 3 ? neutralColor : color.silver

string runningAge = radarDir == 0 ? "--" : f_ageText(radarStartTime)

float flightRunningPl =
     radarDir == 0 or na(radarEntry) ?
          na :
          f_dashboardPlLot(
               radarEntry,
               close,
               radarDir,
               na(radarEntryLot) ? dashboardLotSize : radarEntryLot)

string flightSignalText =
     radarDir == 1 ? "🐋 WHALE BUY // RUNNING" :
     radarDir == -1 ? "🐋 WHALE SELL // RUNNING" :
     "🐋 WHALE WAIT // IDLE"

string flightEntryText =
     radarDir == 0 or na(radarEntry) ? "--" :
     str.tostring(radarEntry, format.mintick)

string flightPlText =
     na(flightRunningPl) ? "--" :
     "$" + str.tostring(flightRunningPl, "#.00")

string flightAgeText =
     radarDir == 0 ? "--" : runningAge

string dashboardLotModelText =
     dashboardIsGold ? "GOLD // LOT " + dashboardLotText :
     dashboardIsSilver ? "SILVER // LOT " + dashboardLotText :
     dashboardIsBtc ? "BTC // LOT " + dashboardLotText :
     dashboardIsEth ? "ETH // LOT " + dashboardLotText :
     dashboardIsForex ? "FX // LOT " + dashboardLotText + " // ~ $10/PIP" :
     "LOT " + dashboardLotText

string controlStrength =
     radarDir == 1 ?
         (buyStrength >= 85 ? "✈ BUY CONTROL • STRONG" :
          buyStrength >= 70 ? "✈ BUY CONTROL • ACTIVE" : "✈ BUY CONTROL • WEAKENING") :
     radarDir == -1 ?
         (sellStrength >= 85 ? "✈ SELL CONTROL • STRONG" :
          sellStrength >= 70 ? "✈ SELL CONTROL • ACTIVE" : "✈ SELL CONTROL • WEAKENING") :
     "✈ WAIT"

string activeGuide =
     zoneTradeDir == 1 ? "⚡ BULL POINT B ACTIVE" :
     zoneTradeDir == -1 ? "⚡ BEAR POINT B ACTIVE" :
     radarDir == 1 ? "✈ BUY ACTIVE" :
     radarDir == -1 ? "✈ SELL ACTIVE" :
     "WAIT"

float radarConfidence =
     radarDir == 1 ? buyStrength :
     radarDir == -1 ? sellStrength :
     math.max(buyStrength, sellStrength)

string dashboardTradeWarning =
     zoneTradeDir == 1 ? "⚡ MODEL 1 BULL ACTIVE • B ENTRY " + str.tostring(zoneTradeEntry, format.mintick) :
     zoneTradeDir == -1 ? "⚡ MODEL 1 BEAR ACTIVE • B ENTRY " + str.tostring(zoneTradeEntry, format.mintick) :
     radarDir == 1 ? "✈ FLIGHT BUY ACTIVE" :
     radarDir == -1 ? "✈ FLIGHT SELL ACTIVE" :
     "WAIT"

color marketStatusColor =
     zoneTradeDir == 1 ? bullColor :
     zoneTradeDir == -1 ? bearColor :
     radarDir == 1 ? bullColor :
     radarDir == -1 ? bearColor :
     neutralColor

string uiStatusText = activeGuide
color uiStatusColor = marketStatusColor

f_dashboardPos(string posOpt) =>
    switch posOpt
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.bottom_right

f_dashboardSize(string sizeOpt) =>
    switch sizeOpt
        "Tiny" => size.tiny
        "Small" => size.small
        "Large" => size.large
        => size.normal

f_dashboardHeaderSize(string sizeOpt) =>
    sizeOpt == "Tiny" ? size.small :
     sizeOpt == "Small" ? size.normal :
     size.large

// -----------------------------------------------------------------------------
//=============================================================================
//=============================================================================
// SFA FINAL REJECTION ENGINE
//
// ONLY LOGIC USED FOR THE TRADE SIGNAL:
//
// BUY
//   meaningful BUY zone
//   -> RED rejection/test candle closes valid at the zone
//   -> IMMEDIATE NEXT CLOSED GREEN candle follows through
//   -> ⚡ BUY CONFIRMED
//
// SELL
//   meaningful SELL zone
//   -> GREEN rejection/test candle closes valid at the zone
//   -> IMMEDIATE NEXT CLOSED RED candle follows through
//   -> ⚡ SELL CONFIRMED
//
// Confirmation ladder:
//   1/4 Rejection close
//   2/4 Next-candle follow-through   <-- DEFAULT ENTRY
//   3/4 Break rejection high / low
//   4/4 Structure shift BOS / CHOCH
//
// A running SELL keeps running if price only finds/tests a BUY zone.
// It reverses only after a valid BUY confirmation.
// Exact opposite for a running BUY.
//=============================================================================

float rejAtr = math.max(ta.atr(14), syminfo.mintick * 20)
float rejTouchTolerance = rejAtr * 0.08

// Keep the visible ⚡ safely outside the entire candle/wick.
// Tall candles use candle-range spacing; normal candles use ATR spacing.
float signalMarkerGap =
     math.max(
         rejAtr * signalMarkerGapAtr,
         (high - low) * signalMarkerCandleGap,
         syminfo.mintick * 50)

bool rejBuyZoneChanged =
     mapBuyTime != mapBuyTime[1] or mapBuyTop != mapBuyTop[1] or mapBuyBot != mapBuyBot[1]
bool rejSellZoneChanged =
     mapSellTime != mapSellTime[1] or mapSellTop != mapSellTop[1] or mapSellBot != mapSellBot[1]

var int rejBuyBar = na
var float rejBuyHigh = na
var float rejBuyLow = na
var float rejBuyClose = na
var float rejBuyStructLevel = na
var int rejBuyLevel = 0

var int rejSellBar = na
var float rejSellHigh = na
var float rejSellLow = na
var float rejSellClose = na
var float rejSellStructLevel = na
var int rejSellLevel = 0

var float rejBuyVol = na
var float rejBuyAvgVol = na
var float rejBuyClosePos = na
var bool rejBuySwept = false

var float rejSellVol = na
var float rejSellAvgVol = na
var float rejSellClosePos = na
var bool rejSellSwept = false

// Recent rejection event memory (latest 3).
var array<int> recentEvtTime = array.new_int()
var array<int> recentEvtDir = array.new_int()
var array<float> recentEvtLevel = array.new_float()
var array<float> recentEvtClosePos = array.new_float()
var array<float> recentEvtEffort = array.new_float()

f_pushRecent(int t, int dir, float lvl, float closePos, float effort) =>
    array.unshift(recentEvtTime, t)
    array.unshift(recentEvtDir, dir)
    array.unshift(recentEvtLevel, lvl)
    array.unshift(recentEvtClosePos, closePos)
    array.unshift(recentEvtEffort, effort)
    while array.size(recentEvtTime) > 3
        array.pop(recentEvtTime)
        array.pop(recentEvtDir)
        array.pop(recentEvtLevel)
        array.pop(recentEvtClosePos)
        array.pop(recentEvtEffort)


if rejBuyZoneChanged
    rejBuyBar := na
    rejBuyHigh := na
    rejBuyLow := na
    rejBuyClose := na
    rejBuyStructLevel := na
    rejBuyVol := na
    rejBuyAvgVol := na
    rejBuyClosePos := na
    rejBuySwept := false
    rejBuyLevel := 0

if rejSellZoneChanged
    rejSellBar := na
    rejSellHigh := na
    rejSellLow := na
    rejSellClose := na
    rejSellStructLevel := na
    rejSellVol := na
    rejSellAvgVol := na
    rejSellClosePos := na
    rejSellSwept := false
    rejSellLevel := 0

bool buyTouchesZone =
     not na(mapBuyTop) and not na(mapBuyBot) and
     low <= mapBuyTop + rejTouchTolerance and high >= mapBuyBot - rejTouchTolerance

bool sellTouchesZone =
     not na(mapSellTop) and not na(mapSellBot) and
     high >= mapSellBot - rejTouchTolerance and low <= mapSellTop + rejTouchTolerance

bool buyRejectionClose =
     barstate.isconfirmed and buyTouchesZone and
     close < open and
     close >= mapBuyBot and
     close > low + (high - low) * 0.25

bool sellRejectionClose =
     barstate.isconfirmed and sellTouchesZone and
     close > open and
     close <= mapSellTop and
     close < high - (high - low) * 0.25

if buyRejectionClose
    rejBuyBar := bar_index
    rejBuyHigh := high
    rejBuyLow := low
    rejBuyClose := close
    rejBuyStructLevel := ta.highest(high[1], rejectStructureLookback)
    rejBuyVol := volume
    rejBuyAvgVol := ta.sma(volume, 20)
    rejBuyClosePos := high == low ? 50.0 : (close - low) / (high - low) * 100.0
    rejBuySwept := low < mapBuyBot
    rejBuyLevel := 1
    f_pushRecent(time, 1, mapBuyBot, rejBuyClosePos,
         na(rejBuyAvgVol) or rejBuyAvgVol == 0 ? 0.0 : rejBuyVol / rejBuyAvgVol)


if sellRejectionClose
    rejSellBar := bar_index
    rejSellHigh := high
    rejSellLow := low
    rejSellClose := close
    rejSellStructLevel := ta.lowest(low[1], rejectStructureLookback)
    rejSellVol := volume
    rejSellAvgVol := ta.sma(volume, 20)
    rejSellClosePos := high == low ? 50.0 : (close - low) / (high - low) * 100.0
    rejSellSwept := high > mapSellTop
    rejSellLevel := 1
    f_pushRecent(time, -1, mapSellTop, rejSellClosePos,
         na(rejSellAvgVol) or rejSellAvgVol == 0 ? 0.0 : rejSellVol / rejSellAvgVol)


bool buyFollowThrough =
     barstate.isconfirmed and rejBuyLevel == 1 and
     not na(rejBuyBar) and bar_index == rejBuyBar + 1 and
     close > open and close > rejBuyClose

bool sellFollowThrough =
     barstate.isconfirmed and rejSellLevel == 1 and
     not na(rejSellBar) and bar_index == rejSellBar + 1 and
     close < open and close < rejSellClose

if barstate.isconfirmed and rejBuyLevel == 1 and not na(rejBuyBar) and bar_index > rejBuyBar
    if buyFollowThrough
        rejBuyLevel := 2
    else
        rejBuyBar := na
        rejBuyHigh := na
        rejBuyLow := na
        rejBuyClose := na
        rejBuyStructLevel := na
        rejBuyLevel := 0

if barstate.isconfirmed and rejSellLevel == 1 and not na(rejSellBar) and bar_index > rejSellBar
    if sellFollowThrough
        rejSellLevel := 2
    else
        rejSellBar := na
        rejSellHigh := na
        rejSellLow := na
        rejSellClose := na
        rejSellStructLevel := na
        rejSellLevel := 0

if rejBuyLevel >= 2 and not na(rejBuyHigh) and barstate.isconfirmed and close > rejBuyHigh
    rejBuyLevel := math.max(rejBuyLevel, 3)

if rejSellLevel >= 2 and not na(rejSellLow) and barstate.isconfirmed and close < rejSellLow
    rejSellLevel := math.max(rejSellLevel, 3)

bool buyStructureShift =
     rejBuyLevel >= 2 and barstate.isconfirmed and
     ((not na(rejBuyStructLevel) and close > rejBuyStructLevel) or bullishChochConfirmed)

bool sellStructureShift =
     rejSellLevel >= 2 and barstate.isconfirmed and
     ((not na(rejSellStructLevel) and close < rejSellStructLevel) or bearishChochConfirmed)

if buyStructureShift
    rejBuyLevel := 4
if sellStructureShift
    rejSellLevel := 4

var int rejLastBuySignalZoneTime = na
var int rejLastSellSignalZoneTime = na

//=============================================================================
// V20.5 LIVE STATE RESET
// Historical chart logic can still render normally, but ACTIVE trade/card
// memory is rebuilt only from the recent window. This prevents an ancient
// historical BUY/SELL from appearing as a current live trade after reload.
//=============================================================================
int sfaLiveRebuildHours = 48
int sfaLiveRebuildMs = sfaLiveRebuildHours * 60 * 60 * 1000
bool sfaInLiveRebuildWindow = time >= timenow - sfaLiveRebuildMs
bool sfaLiveStateResetBar =
     sfaInLiveRebuildWindow and
     (bar_index == 0 or not sfaInLiveRebuildWindow[1])

// Reset raw-confirmation de-dup memory exactly at the recent-window boundary.
if sfaLiveStateResetBar
    rejLastBuySignalZoneTime := na
    rejLastSellSignalZoneTime := na
    rejBuyLevel := 0
    rejSellLevel := 0

bool rejBuySignalRaw = buyFollowThrough
bool rejSellSignalRaw = sellFollowThrough

bool rejBuySignal =
     rejBuySignalRaw and
     (not rejectOneTradePerConfirm or na(rejLastBuySignalZoneTime) or mapBuyTime != rejLastBuySignalZoneTime)

bool rejSellSignal =
     rejSellSignalRaw and
     (not rejectOneTradePerConfirm or na(rejLastSellSignalZoneTime) or mapSellTime != rejLastSellSignalZoneTime)

// Raw L2 confirmations are internal.
// Lock the zone so the same zone cannot keep firing confirmation events.
if rejBuySignal
    rejLastBuySignalZoneTime := mapBuyTime

if rejSellSignal
    rejLastSellSignalZoneTime := mapSellTime

//=============================================================================
// SIMPLE REAL TRADE STATE
// A zone touch alone NEVER reverses the current trade.
// Only the opposite confirmed ⚡ reverses it.
//=============================================================================
var int rejTradeDir = 0
var float rejTradeEntry = na
var float rejTradeStop = na
var float rejTradeZoneInvalid = na
var int rejTradeEntryBar = na
var int rejTradeEntryTime = na
var bool rejTradeBeLocked = false
var int rejTradeCycle = 0
var string rejTradeLastExit = "--"
var int rejLastAlertBar = na

// Dedicated decision memory. Kept separate from the active trade so the
// dashboard can still show the last exit after a new opposite trade begins.
var int decisionLastExitTime = na
var float decisionLastExitPrice = na
var int decisionLastExitDir = 0
var string decisionLastExitReason = "--"

// Last accepted REAL L2 signal. This remains visible even after the trade
// later closes, so members can distinguish "last signal" from "current setup".
var int rejLastSignalDir = 0
var float rejLastSignalEntry = na
var int rejLastSignalTime = na
var string rejLastSignalKind = "--"

//-----------------------------------------------------------------------------
// V20.2 CARD-ONLY MAJOR TARGET SELECTOR
// Target must be completely on the correct side of Entry.
// Priority: 1H/4H/D1 -> 30M/15M -> 5M/1M fallback.
//-----------------------------------------------------------------------------
f_cardMajorSellTarget(float entry) =>
    float outTop = na
    float outBot = na
    string outTf = "--"
    float best = 1e20

    // Tier 1: major HTF SELL zones above BUY entry.
    if not na(h1SellTop) and not na(h1SellBot) and h1SellBot > entry
        float d = h1SellBot - entry
        if d < best
            best := d
            outTop := h1SellTop
            outBot := h1SellBot
            outTf := "1H"

    if not na(h4SellTop) and not na(h4SellBot) and h4SellBot > entry
        float d = h4SellBot - entry
        if d < best
            best := d
            outTop := h4SellTop
            outBot := h4SellBot
            outTf := "4H"

    if not na(d1SellTop) and not na(d1SellBot) and d1SellBot > entry
        float d = d1SellBot - entry
        if d < best
            best := d
            outTop := d1SellTop
            outBot := d1SellBot
            outTf := "D1"

    // Tier 2: middle TF only if no major HTF target exists.
    if na(outTop)
        best := 1e20

        if not na(m30SellTop) and not na(m30SellBot) and m30SellBot > entry
            float d = m30SellBot - entry
            if d < best
                best := d
                outTop := m30SellTop
                outBot := m30SellBot
                outTf := "30M"

        if not na(m15SellTop) and not na(m15SellBot) and m15SellBot > entry
            float d = m15SellBot - entry
            if d < best
                best := d
                outTop := m15SellTop
                outBot := m15SellBot
                outTf := "15M"

    // V20.3: no 5M / 1M target fallback.
    // Small live/confluence zones are ignored for active trade targets.

    [outTop, outBot, outTf]

f_cardMajorBuyTarget(float entry) =>
    float outTop = na
    float outBot = na
    string outTf = "--"
    float best = 1e20

    // Tier 1: major HTF BUY zones below SELL entry.
    if not na(h1BuyTop) and not na(h1BuyBot) and h1BuyTop < entry
        float d = entry - h1BuyTop
        if d < best
            best := d
            outTop := h1BuyTop
            outBot := h1BuyBot
            outTf := "1H"

    if not na(h4BuyTop) and not na(h4BuyBot) and h4BuyTop < entry
        float d = entry - h4BuyTop
        if d < best
            best := d
            outTop := h4BuyTop
            outBot := h4BuyBot
            outTf := "4H"

    if not na(d1BuyTop) and not na(d1BuyBot) and d1BuyTop < entry
        float d = entry - d1BuyTop
        if d < best
            best := d
            outTop := d1BuyTop
            outBot := d1BuyBot
            outTf := "D1"

    // Tier 2: middle TF only if no major HTF target exists.
    if na(outTop)
        best := 1e20

        if not na(m30BuyTop) and not na(m30BuyBot) and m30BuyTop < entry
            float d = entry - m30BuyTop
            if d < best
                best := d
                outTop := m30BuyTop
                outBot := m30BuyBot
                outTf := "30M"

        if not na(m15BuyTop) and not na(m15BuyBot) and m15BuyTop < entry
            float d = entry - m15BuyTop
            if d < best
                best := d
                outTop := m15BuyTop
                outBot := m15BuyBot
                outTf := "15M"

    // V20.3: no 5M / 1M target fallback.
    // Small live/confluence zones are ignored for active trade targets.

    [outTop, outBot, outTf]

//-----------------------------------------------------------------------------
// V20.4 STEP-ZONE SELECTOR
// 1M / 5M opposite zones are sequential checkpoints before the major target.
//-----------------------------------------------------------------------------
f_cardStepSellTarget(float reference, float majorNear) =>
    float outTop = na
    float outBot = na
    string outTf = "--"
    float best = 1e20

    if not na(m1SellTop) and not na(m1SellBot) and
       m1SellBot > reference and
       (na(majorNear) or m1SellBot < majorNear)
        float d = m1SellBot - reference
        if d < best
            best := d
            outTop := m1SellTop
            outBot := m1SellBot
            outTf := "1M"

    if not na(m5SellTop) and not na(m5SellBot) and
       m5SellBot > reference and
       (na(majorNear) or m5SellBot < majorNear)
        float d = m5SellBot - reference
        if d < best
            best := d
            outTop := m5SellTop
            outBot := m5SellBot
            outTf := "5M"

    [outTop, outBot, outTf]

f_cardStepBuyTarget(float reference, float majorNear) =>
    float outTop = na
    float outBot = na
    string outTf = "--"
    float best = 1e20

    if not na(m1BuyTop) and not na(m1BuyBot) and
       m1BuyTop < reference and
       (na(majorNear) or m1BuyTop > majorNear)
        float d = reference - m1BuyTop
        if d < best
            best := d
            outTop := m1BuyTop
            outBot := m1BuyBot
            outTf := "1M"

    if not na(m5BuyTop) and not na(m5BuyBot) and
       m5BuyTop < reference and
       (na(majorNear) or m5BuyTop > majorNear)
        float d = reference - m5BuyTop
        if d < best
            best := d
            outTop := m5BuyTop
            outBot := m5BuyBot
            outTf := "5M"

    [outTop, outBot, outTf]

// V20 DISPLAY-ONLY origin-zone snapshot.
var float cardOriginTop = na
var float cardOriginBot = na
var string cardOriginTf = "--"

// V20.1 DISPLAY-ONLY fixed target snapshot.
// The Card keeps this opposite zone fixed for the active setup and ignores
// newer/smaller live zones until a new real trade/reversal is accepted.
var float cardTargetTop = na
var float cardTargetBot = na
var string cardTargetTf = "--"
var int cardLockedDir = 0
var bool cardTargetReached = false
var int cardTargetReachedBar = na
var float cardSearchReference = na

// V20.4 small checkpoint state.
var float cardStepTop = na
var float cardStepBot = na
var string cardStepTf = "--"
var int cardStepDir = 0
var float cardStepSearchReference = na
var bool cardStepReached = false

// True when the currently armed decision is a small 1M/5M checkpoint.
var bool cardDecisionIsStep = false

// Most recently broken opposite checkpoint (STEP or MAJOR).
// BREAK keeps the same signal active. A later full cross back through this
// broken zone is treated as a confirmed failed-break reversal.
var int cardBrokenWatchDir = 0
var float cardBrokenWatchTop = na
var float cardBrokenWatchBot = na
var string cardBrokenWatchTf = "--"

f_rejStop(int dir, float entry) =>
    float stop = na
    if slDisplayMode == "Zone"
        stop := dir == 1 ? mapBuyBot - rejAtr * slZoneBufferDisplay :
             mapSellTop + rejAtr * slZoneBufferDisplay
    else if slDisplayMode == "ATR"
        stop := dir == 1 ? entry - rejAtr * slAtrMultDisplay :
             entry + rejAtr * slAtrMultDisplay
    else if slDisplayMode == "Custom Points"
        float dist = slCustomPointsDisplay * syminfo.mintick
        stop := dir == 1 ? entry - dist : entry + dist
    stop

// Real trade-space check.
// BUY needs room to the next SELL zone.
// SELL needs room to the next BUY zone.
float buyCandidateInvalid = mapBuyBot
float buyCandidateTarget = mapSellBot
float buyCandidateRisk = na(buyCandidateInvalid) ? na : math.abs(close - buyCandidateInvalid)
float buyCandidateReward =
     na(buyCandidateTarget) or buyCandidateTarget <= close ? na :
     buyCandidateTarget - close
float buyCandidateRR =
     na(buyCandidateRisk) or buyCandidateRisk <= 0 or na(buyCandidateReward) ? na :
     buyCandidateReward / buyCandidateRisk
bool buySpaceOk = not na(buyCandidateRR) and buyCandidateRR >= minRoomRR

float sellCandidateInvalid = mapSellTop
float sellCandidateTarget = mapBuyTop
float sellCandidateRisk = na(sellCandidateInvalid) ? na : math.abs(sellCandidateInvalid - close)
float sellCandidateReward =
     na(sellCandidateTarget) or sellCandidateTarget >= close ? na :
     close - sellCandidateTarget
float sellCandidateRR =
     na(sellCandidateRisk) or sellCandidateRisk <= 0 or na(sellCandidateReward) ? na :
     sellCandidateReward / sellCandidateRisk
bool sellSpaceOk = not na(sellCandidateRR) and sellCandidateRR >= minRoomRR

var int rejNoTradeDir = 0
var string rejNoTradeReason = "--"
var float rejNoTradeRR = na

// V20.5 CORE LIVE RESET.
// Wipe all ancient active-trade / Card memory before the first recent bar is
// allowed to build a new current setup.
if sfaLiveStateResetBar
    rejTradeDir := 0
    rejTradeEntry := na
    rejTradeStop := na
    rejTradeZoneInvalid := na
    rejTradeEntryBar := na
    rejTradeEntryTime := na
    rejTradeBeLocked := false
    rejTradeCycle := 0
    rejTradeLastExit := "--"
    rejLastAlertBar := na

    decisionLastExitTime := na
    decisionLastExitPrice := na
    decisionLastExitDir := 0
    decisionLastExitReason := "--"

    rejLastSignalDir := 0
    rejLastSignalEntry := na
    rejLastSignalTime := na
    rejLastSignalKind := "--"

    cardOriginTop := na
    cardOriginBot := na
    cardOriginTf := "--"

    cardTargetTop := na
    cardTargetBot := na
    cardTargetTf := "--"
    cardLockedDir := 0
    cardTargetReached := false
    cardTargetReachedBar := na
    cardSearchReference := na

    cardStepTop := na
    cardStepBot := na
    cardStepTf := "--"
    cardStepDir := 0
    cardStepSearchReference := na
    cardStepReached := false
    cardDecisionIsStep := false

    cardBrokenWatchDir := 0
    cardBrokenWatchTop := na
    cardBrokenWatchBot := na
    cardBrokenWatchTf := "--"

    rejNoTradeDir := 0
    rejNoTradeReason := "--"
    rejNoTradeRR := na

// Capture direction AFTER any V20.5 live reset.
int rejTradeDirBefore = rejTradeDir

//=============================================================================
// V16.6 SIMPLE REACH / REJECT / BREAK ENGINE
//=============================================================================

// Exact visible primary boxes members see.
bool decisionVisibleBuyTouch =
     not na(marketBuyVisualTop) and not na(marketBuyVisualBot) and
     high >= marketBuyVisualBot and low <= marketBuyVisualTop

bool decisionVisibleSellTouch =
     not na(marketSellVisualTop) and not na(marketSellVisualBot) and
     high >= marketSellVisualBot and low <= marketSellVisualTop

// ------------------------------------------------------------------
// OPPOSITE ZONE CONFLICT / CONFLUENCE FILTER
// If BUY and SELL boxes overlap, or the gap between them is very small,
// they become ONE combined cluster. Decision is made only outside the
// entire combined area.
// ------------------------------------------------------------------
bool decisionBothBoxesReady =
     not na(marketBuyVisualTop) and not na(marketBuyVisualBot) and
     not na(marketSellVisualTop) and not na(marketSellVisualBot)

bool decisionBoxesOverlap =
     decisionBothBoxesReady and
     math.max(marketBuyVisualBot, marketSellVisualBot) <=
     math.min(marketBuyVisualTop, marketSellVisualTop)

float decisionOppositeGap =
     not decisionBothBoxesReady ? na :
     decisionBoxesOverlap ? 0.0 :
     marketSellVisualBot > marketBuyVisualTop ?
          marketSellVisualBot - marketBuyVisualTop :
     marketBuyVisualBot > marketSellVisualTop ?
          marketBuyVisualBot - marketSellVisualTop :
     0.0

bool decisionZoneConflict =
     conflictFilterEnabled and decisionBothBoxesReady and
     (decisionBoxesOverlap or decisionOppositeGap <= mapAtrNow * conflictGapAtr)

float decisionConflictTop =
     decisionZoneConflict ? math.max(marketBuyVisualTop, marketSellVisualTop) : na

float decisionConflictBot =
     decisionZoneConflict ? math.min(marketBuyVisualBot, marketSellVisualBot) : na

bool decisionConflictTouch =
     decisionZoneConflict and
     high >= decisionConflictBot and low <= decisionConflictTop

// Visual highlight: one gold neutral band across the complete cluster.
var box decisionConflictBox = na

if barstate.islast
    if showConflictHighlight and decisionZoneConflict and
       not na(decisionConflictTop) and not na(decisionConflictBot)
        if na(decisionConflictBox)
            decisionConflictBox := box.new(
                 bar_index, decisionConflictTop,
                 bar_index + 1, decisionConflictBot,
                 xloc=xloc.bar_index, extend=extend.right,
                 bgcolor=color.new(gold, 88),
                 border_color=color.new(gold, 25),
                 border_width=1,
                 text="⚠ BUY / SELL CONFLICT • WAIT OUTSIDE",
                 text_color=gold,
                 text_size=size.tiny,
                 text_halign=text.align_center,
                 text_valign=text.align_center)
        else
            box.set_lefttop(decisionConflictBox, bar_index, decisionConflictTop)
            box.set_rightbottom(decisionConflictBox, bar_index + 1, decisionConflictBot)
            box.set_bgcolor(decisionConflictBox, color.new(gold, 88))
            box.set_border_color(decisionConflictBox, color.new(gold, 25))
            box.set_text(decisionConflictBox, "⚠ BUY / SELL CONFLICT • WAIT OUTSIDE")
    else
        if not na(decisionConflictBox)
            box.delete(decisionConflictBox)
            decisionConflictBox := na

f_fullyAbove(float zoneTop) =>
    outsideConfirmMode == "Full Candle" ? low > zoneTop :
     outsideConfirmMode == "Body" ? math.min(open, close) > zoneTop :
     close > zoneTop

f_fullyBelow(float zoneBot) =>
    outsideConfirmMode == "Full Candle" ? high < zoneBot :
     outsideConfirmMode == "Body" ? math.max(open, close) < zoneBot :
     close < zoneBot

// ------------------------------------------------------------------
// IDLE ORIGIN ZONE
// ------------------------------------------------------------------
var int decisionBuyTouchBar = na
var int decisionBuyTouchTime = na
var float decisionBuyTouchTop = na
var float decisionBuyTouchBot = na

var int decisionSellTouchBar = na
var int decisionSellTouchTime = na
var float decisionSellTouchTop = na
var float decisionSellTouchBot = na

// ------------------------------------------------------------------
// ACTIVE OPPOSITE-ZONE DECISION SNAPSHOT
// This is EMPTY while travelling. It locks only at actual zone reach.
// ------------------------------------------------------------------
var int decisionTargetSide = 0       // 1 BUY zone, -1 SELL zone
var float decisionTargetTop = na
var float decisionTargetBot = na
var int decisionTargetTime = na
var string decisionTargetTF = "--"
var bool decisionTargetTouched = false
var int decisionTargetTouchBar = na
var int decisionLastBrokenTargetTime = na
var int decisionLastBrokenTargetSide = 0

// Conflict target identity so the same overlapping cluster cannot fire
// repeatedly after a confirmed break.
var int decisionLastConflictBuyTime = na
var int decisionLastConflictSellTime = na
var bool decisionTargetIsConflict = false

var string decisionTargetLastEvent = "WAIT"

var label decisionLastEntryLabel = na
var label decisionLastExitLabel = na
var int decisionLastExitLabelBar = na
var label decisionLastTargetLabel = na
var label decisionOriginWatchLabel = na

// V20.5 DECISION-MEMORY RESET.
// Old touch/target snapshots must not survive into the live rebuild window.
if sfaLiveStateResetBar
    decisionBuyTouchBar := na
    decisionBuyTouchTime := na
    decisionBuyTouchTop := na
    decisionBuyTouchBot := na

    decisionSellTouchBar := na
    decisionSellTouchTime := na
    decisionSellTouchTop := na
    decisionSellTouchBot := na

    decisionTargetSide := 0
    decisionTargetTop := na
    decisionTargetBot := na
    decisionTargetTime := na
    decisionTargetTF := "--"
    decisionTargetTouched := false
    decisionTargetTouchBar := na
    decisionLastBrokenTargetTime := na
    decisionLastBrokenTargetSide := 0
    decisionLastConflictBuyTime := na
    decisionLastConflictSellTime := na
    decisionTargetIsConflict := false
    decisionTargetLastEvent := "LIVE RESET • WAIT CURRENT ZONE"

    // A stale yellow WATCH label is the only historical decision object we
    // actively remove. Entry/exit history can remain visible on the chart.
    if not na(decisionOriginWatchLabel)
        label.delete(decisionOriginWatchLabel)
        decisionOriginWatchLabel := na

    if not na(decisionLastExitLabel)
        label.delete(decisionLastExitLabel)
        decisionLastExitLabel := na
        decisionLastExitLabelBar := na

// ------------------------------------------------------------------
// V20.6 ACTIVE INVALIDATION / AT-RISK
// Intrabar cross = warning only. Confirmed close beyond invalidation = stop
// the active setup and require a fresh zone touch + confirmation.
// ------------------------------------------------------------------
bool buyTradeAtRisk =
     rejTradeDir == 1 and not na(rejTradeZoneInvalid) and
     low < rejTradeZoneInvalid

bool sellTradeAtRisk =
     rejTradeDir == -1 and not na(rejTradeZoneInvalid) and
     high > rejTradeZoneInvalid

bool buyTradeInvalidated =
     rejTradeDir == 1 and not na(rejTradeZoneInvalid) and
     barstate.isconfirmed and close < rejTradeZoneInvalid

bool sellTradeInvalidated =
     rejTradeDir == -1 and not na(rejTradeZoneInvalid) and
     barstate.isconfirmed and close > rejTradeZoneInvalid

bool tradeInvalidatedEvent = buyTradeInvalidated or sellTradeInvalidated

if tradeInvalidatedEvent
    int invalidDir = rejTradeDir

    decisionLastExitTime := time
    decisionLastExitPrice := close
    decisionLastExitDir := invalidDir
    decisionLastExitReason :=
         invalidDir == 1 ? "BUY INVALIDATED • CLOSED BELOW ORIGIN ZONE" :
         "SELL INVALIDATED • CLOSED ABOVE ORIGIN ZONE"

    rejTradeLastExit := decisionLastExitReason

    rejTradeDir := 0
    rejTradeEntry := na
    rejTradeStop := na
    rejTradeZoneInvalid := na
    rejTradeEntryBar := na
    rejTradeEntryTime := na
    rejTradeBeLocked := false
    rejLastAlertBar := na

    cardOriginTop := na
    cardOriginBot := na
    cardOriginTf := "--"

    cardTargetTop := na
    cardTargetBot := na
    cardTargetTf := "--"
    cardLockedDir := 0
    cardTargetReached := false
    cardTargetReachedBar := na
    cardSearchReference := na

    cardStepTop := na
    cardStepBot := na
    cardStepTf := "--"
    cardStepDir := 0
    cardStepSearchReference := na
    cardStepReached := false
    cardDecisionIsStep := false

    cardBrokenWatchDir := 0
    cardBrokenWatchTop := na
    cardBrokenWatchBot := na
    cardBrokenWatchTf := "--"

    decisionTargetSide := 0
    decisionTargetTop := na
    decisionTargetBot := na
    decisionTargetTime := na
    decisionTargetTF := "--"
    decisionTargetTouched := false
    decisionTargetTouchBar := na
    decisionTargetIsConflict := false
    decisionTargetLastEvent := decisionLastExitReason

    decisionBuyTouchBar := na
    decisionBuyTouchTime := na
    decisionBuyTouchTop := na
    decisionBuyTouchBot := na

    decisionSellTouchBar := na
    decisionSellTouchTime := na
    decisionSellTouchTop := na
    decisionSellTouchBot := na

    if not na(decisionOriginWatchLabel)
        label.delete(decisionOriginWatchLabel)
        decisionOriginWatchLabel := na

    if decisionHistoryOpt == "Latest Only" and not na(decisionLastExitLabel)
        label.delete(decisionLastExitLabel)

    decisionLastExitLabel := label.new(
         bar_index,
         invalidDir == 1 ? high + signalMarkerGap * 0.55 : low - signalMarkerGap * 0.55,
         invalidDir == 1 ? "BUY INVALID ✕\nWAIT ZONE" :
                           "SELL INVALID ✕\nWAIT ZONE",
         xloc=xloc.bar_index,
         yloc=yloc.price,
         style=invalidDir == 1 ? label.style_label_down : label.style_label_up,
         color=color.rgb(111, 20, 35),
         textcolor=color.rgb(245, 247, 250),
         size=f_decisionLabelSize())
    decisionLastExitLabelBar := bar_index

// ------------------------------------------------------------------
// V20.8 TEMPORARY MANAGEMENT-LABEL CLEANUP
// INVALIDATED is an event warning, not permanent chart history.
// ------------------------------------------------------------------
bool tempExitLabelExpired =
     not na(decisionLastExitLabel) and
     not na(decisionLastExitLabelBar) and
     bar_index - decisionLastExitLabelBar >= 4

if tempExitLabelExpired
    label.delete(decisionLastExitLabel)
    decisionLastExitLabel := na
    decisionLastExitLabelBar := na

// ------------------------------------------------------------------
// IDLE: lock exact visible box when price first reaches it.
// ------------------------------------------------------------------
if rejTradeDirBefore == 0 and na(decisionBuyTouchBar) and decisionVisibleBuyTouch
    decisionBuyTouchBar := bar_index
    decisionBuyTouchTime := buyDisplayTime
    decisionBuyTouchTop := marketBuyVisualTop
    decisionBuyTouchBot := marketBuyVisualBot

if rejTradeDirBefore == 0 and na(decisionSellTouchBar) and decisionVisibleSellTouch
    decisionSellTouchBar := bar_index
    decisionSellTouchTime := sellDisplayTime
    decisionSellTouchTop := marketSellVisualTop
    decisionSellTouchBot := marketSellVisualBot

bool newBuyOriginLock =
     rejTradeDirBefore == 0 and
     not na(decisionBuyTouchBar) and decisionBuyTouchBar == bar_index

bool newSellOriginLock =
     rejTradeDirBefore == 0 and
     not na(decisionSellTouchBar) and decisionSellTouchBar == bar_index

if (newBuyOriginLock or newSellOriginLock) and not na(decisionLastExitLabel)
    label.delete(decisionLastExitLabel)
    decisionLastExitLabel := na
    decisionLastExitLabelBar := na

if showOriginWatchLabel and (newBuyOriginLock or newSellOriginLock)
    if not na(decisionOriginWatchLabel)
        label.delete(decisionOriginWatchLabel)
    decisionOriginWatchLabel := label.new(
         bar_index,
         newBuyOriginLock ? low - signalMarkerGap * 0.35 : high + signalMarkerGap * 0.35,
         newBuyOriginLock ? "BUY ZONE TOUCHED • WAIT CLOSE" : "SELL ZONE TOUCHED • WAIT CLOSE",
         xloc=xloc.bar_index,
         yloc=yloc.price,
         style=newBuyOriginLock ? label.style_label_up : label.style_label_down,
         color=color.rgb(255, 199, 64),
         textcolor=darkBg,
         size=size.tiny)

bool idleBuyArmed =
     rejTradeDirBefore == 0 and
     not na(decisionBuyTouchTop) and not na(decisionBuyTouchBot)

bool idleSellArmed =
     rejTradeDirBefore == 0 and
     not na(decisionSellTouchTop) and not na(decisionSellTouchBot)

// First 100%-outside candle after zone was reached.
bool initialBuyEntryEvent =
     barstate.isconfirmed and idleBuyArmed and
     f_fullyAbove(decisionBuyTouchTop)

bool initialSellEntryEvent =
     barstate.isconfirmed and idleSellArmed and
     f_fullyBelow(decisionSellTouchBot)

// Wrong-way full break cancels the idle setup.
bool idleBuyWrongWayBreak =
     barstate.isconfirmed and idleBuyArmed and
     f_fullyBelow(decisionBuyTouchBot)

bool idleSellWrongWayBreak =
     barstate.isconfirmed and idleSellArmed and
     f_fullyAbove(decisionSellTouchTop)

if idleBuyWrongWayBreak and not initialBuyEntryEvent
    if not na(decisionOriginWatchLabel)
        label.delete(decisionOriginWatchLabel)
        decisionOriginWatchLabel := na
    decisionBuyTouchBar := na
    decisionBuyTouchTime := na
    decisionBuyTouchTop := na
    decisionBuyTouchBot := na

if idleSellWrongWayBreak and not initialSellEntryEvent
    if not na(decisionOriginWatchLabel)
        label.delete(decisionOriginWatchLabel)
        decisionOriginWatchLabel := na
    decisionSellTouchBar := na
    decisionSellTouchTime := na
    decisionSellTouchTop := na
    decisionSellTouchBot := na

// ------------------------------------------------------------------
// V20.4 ACTIVE TRADE — STEP FIRST, MAJOR DESTINATION SECOND.
//
// BUY: nearest 1M/5M SELL step -> next step -> major SELL zone.
// SELL: nearest 1M/5M BUY step -> next step -> major BUY zone.
//
// At every checkpoint:
// REJECT = reverse.
// BREAK = keep same active signal and move to next checkpoint.
// ------------------------------------------------------------------

if rejTradeDirBefore == 1 and cardLockedDir == 1 and na(cardTargetTop) and not na(cardSearchReference)
    [retrySellTop, retrySellBot, retrySellTf] = f_cardMajorSellTarget(cardSearchReference)
    if not na(retrySellTop)
        cardTargetTop := retrySellTop
        cardTargetBot := retrySellBot
        cardTargetTf := retrySellTf
        cardTargetReached := false
        cardTargetReachedBar := na

if rejTradeDirBefore == -1 and cardLockedDir == -1 and na(cardTargetTop) and not na(cardSearchReference)
    [retryBuyTop, retryBuyBot, retryBuyTf] = f_cardMajorBuyTarget(cardSearchReference)
    if not na(retryBuyTop)
        cardTargetTop := retryBuyTop
        cardTargetBot := retryBuyBot
        cardTargetTf := retryBuyTf
        cardTargetReached := false
        cardTargetReachedBar := na

if rejTradeDirBefore == 1 and cardStepDir == 1 and na(cardStepTop) and not na(cardStepSearchReference)
    [retryStepSellTop, retryStepSellBot, retryStepSellTf] =
         f_cardStepSellTarget(cardStepSearchReference, cardTargetBot)
    if not na(retryStepSellTop)
        cardStepTop := retryStepSellTop
        cardStepBot := retryStepSellBot
        cardStepTf := retryStepSellTf
        cardStepReached := false

if rejTradeDirBefore == -1 and cardStepDir == -1 and na(cardStepTop) and not na(cardStepSearchReference)
    [retryStepBuyTop, retryStepBuyBot, retryStepBuyTf] =
         f_cardStepBuyTarget(cardStepSearchReference, cardTargetTop)
    if not na(retryStepBuyTop)
        cardStepTop := retryStepBuyTop
        cardStepBot := retryStepBuyBot
        cardStepTf := retryStepBuyTf
        cardStepReached := false

bool fixedStepReady =
     rejTradeDirBefore != 0 and
     cardStepDir == rejTradeDirBefore and
     not na(cardStepTop) and not na(cardStepBot)

bool fixedMajorTargetReady =
     rejTradeDirBefore != 0 and
     cardLockedDir == rejTradeDirBefore and
     not na(cardTargetTop) and not na(cardTargetBot)

bool activeCheckpointIsStep = fixedStepReady

float activeCheckpointTop =
     activeCheckpointIsStep ? cardStepTop :
     fixedMajorTargetReady ? cardTargetTop : na

float activeCheckpointBot =
     activeCheckpointIsStep ? cardStepBot :
     fixedMajorTargetReady ? cardTargetBot : na

string activeCheckpointTf =
     activeCheckpointIsStep ? cardStepTf :
     fixedMajorTargetReady ? cardTargetTf : "--"

bool fixedCheckpointTouch =
     not na(activeCheckpointTop) and not na(activeCheckpointBot) and
     high >= activeCheckpointBot and low <= activeCheckpointTop

bool canArmConflictDecision = false

bool canArmBuyDecision =
     rejTradeDirBefore == -1 and
     na(decisionTargetTop) and
     fixedCheckpointTouch

bool canArmSellDecision =
     rejTradeDirBefore == 1 and
     na(decisionTargetTop) and
     fixedCheckpointTouch

bool newTargetTouchEvent = canArmBuyDecision or canArmSellDecision
bool newExitWatchEvent = newTargetTouchEvent

if canArmBuyDecision
    cardDecisionIsStep := activeCheckpointIsStep
    decisionTargetSide := 1
    decisionTargetTop := activeCheckpointTop
    decisionTargetBot := activeCheckpointBot
    decisionTargetTime := time
    decisionTargetTF := activeCheckpointTf
    decisionTargetTouched := true
    decisionTargetTouchBar := bar_index
    decisionTargetIsConflict := false

    if cardDecisionIsStep
        cardStepReached := true
        decisionTargetLastEvent :=
             "STEP BUY " + activeCheckpointTf + " REACHED • REJECT OR BREAK?"
    else
        cardTargetReached := true
        cardTargetReachedBar := bar_index
        decisionTargetLastEvent :=
             "MAJOR BUY " + activeCheckpointTf + " REACHED • REJECT OR BREAK?"

if canArmSellDecision
    cardDecisionIsStep := activeCheckpointIsStep
    decisionTargetSide := -1
    decisionTargetTop := activeCheckpointTop
    decisionTargetBot := activeCheckpointBot
    decisionTargetTime := time
    decisionTargetTF := activeCheckpointTf
    decisionTargetTouched := true
    decisionTargetTouchBar := bar_index
    decisionTargetIsConflict := false

    if cardDecisionIsStep
        cardStepReached := true
        decisionTargetLastEvent :=
             "STEP SELL " + activeCheckpointTf + " REACHED • REJECT OR BREAK?"
    else
        cardTargetReached := true
        cardTargetReachedBar := bar_index
        decisionTargetLastEvent :=
             "MAJOR SELL " + activeCheckpointTf + " REACHED • REJECT OR BREAK?"

// Fresh-target validity.
// Never allow a target touched many bars ago to reverse the trade later.
int decisionTargetAge =
     decisionTargetTouched and not na(decisionTargetTouchBar) ?
          bar_index - decisionTargetTouchBar : 0

bool decisionTargetFresh =
     decisionTargetTouched and not na(decisionTargetTouchBar) and
     ((rejTradeDirBefore != 0 and cardLockedDir == rejTradeDirBefore) or
      decisionTargetAge <= targetDecisionBars)

// ------------------------------------------------------------------
// DECISION AT OPPOSITE BOX
// SELL reaches BUY:
//   fully ABOVE BUY = BUY rejection -> reverse BUY
//   fully BELOW BUY = BUY break -> SELL continues
// BUY reaches SELL:
//   fully BELOW SELL = SELL rejection -> reverse SELL
//   fully ABOVE SELL = SELL break -> BUY continues
// ------------------------------------------------------------------
bool sellTargetRejectUp =
     rejTradeDirBefore == -1 and decisionTargetFresh and
     (decisionTargetSide == 1 or decisionTargetIsConflict) and
     barstate.isconfirmed and f_fullyAbove(decisionTargetTop)

bool sellTargetBreakDown =
     rejTradeDirBefore == -1 and decisionTargetFresh and
     (decisionTargetSide == 1 or decisionTargetIsConflict) and
     barstate.isconfirmed and f_fullyBelow(decisionTargetBot)

bool buyTargetRejectDown =
     rejTradeDirBefore == 1 and decisionTargetFresh and
     (decisionTargetSide == -1 or decisionTargetIsConflict) and
     barstate.isconfirmed and f_fullyBelow(decisionTargetBot)

bool buyTargetBreakUp =
     rejTradeDirBefore == 1 and decisionTargetFresh and
     (decisionTargetSide == -1 or decisionTargetIsConflict) and
     barstate.isconfirmed and f_fullyAbove(decisionTargetTop)

bool buyReversalEvent = sellTargetRejectUp
bool sellReversalEvent = buyTargetRejectDown
bool sellContinueEvent = sellTargetBreakDown
bool buyContinueEvent = buyTargetBreakUp
bool decisionContinueEvent = sellContinueEvent or buyContinueEvent

// BUY broke a major SELL zone -> BUY remains active.
// If price later closes fully BELOW that broken SELL zone -> reverse SELL.
bool brokenSellZoneFailedToSell =
     rejTradeDirBefore == 1 and cardBrokenWatchDir == 1 and
     not na(cardBrokenWatchBot) and barstate.isconfirmed and
     f_fullyBelow(cardBrokenWatchBot)

// SELL broke a major BUY zone -> SELL remains active.
// If price later closes fully ABOVE that broken BUY zone -> reverse BUY.
bool brokenBuyZoneFailedToBuy =
     rejTradeDirBefore == -1 and cardBrokenWatchDir == -1 and
     not na(cardBrokenWatchTop) and barstate.isconfirmed and
     f_fullyAbove(cardBrokenWatchTop)

bool rejBuyEntryEvent =
     initialBuyEntryEvent or buyReversalEvent or brokenBuyZoneFailedToBuy

bool rejSellEntryEvent =
     initialSellEntryEvent or sellReversalEvent or brokenSellZoneFailedToSell

bool decisionTargetExpired =
     decisionTargetTouched and not decisionTargetFresh and
     not rejBuyEntryEvent and not rejSellEntryEvent and
     not decisionContinueEvent

rejNoTradeDir := 0
rejNoTradeReason := "--"
rejNoTradeRR := na

// ------------------------------------------------------------------
// BUY START / BUY REVERSAL
// ------------------------------------------------------------------
if (rejBuyEntryEvent or rejSellEntryEvent) and not na(decisionLastExitLabel)
    label.delete(decisionLastExitLabel)
    decisionLastExitLabel := na
    decisionLastExitLabelBar := na

if rejBuyEntryEvent
    if not na(decisionOriginWatchLabel)
        label.delete(decisionOriginWatchLabel)
        decisionOriginWatchLabel := na

    if rejTradeDirBefore == -1
        decisionLastExitTime := time
        decisionLastExitPrice := close
        decisionLastExitDir := -1
        decisionLastExitReason :=
             brokenBuyZoneFailedToBuy ? "BROKEN BUY ZONE RECLAIM" :
             "BUY BOX REJECT"

    rejLastSignalDir := 1
    rejLastSignalEntry := close
    rejLastSignalTime := time
    rejLastSignalKind := rejTradeDirBefore == -1 ? "BUY REVERSAL" : "BUY ENTRY"

    rejTradeDir := 1
    rejTradeEntry := close

    // Display snapshot only — does not affect trade logic.
    cardOriginTop :=
         rejTradeDirBefore == -1 ?
              (brokenBuyZoneFailedToBuy ? cardBrokenWatchTop : decisionTargetTop) :
              decisionBuyTouchTop
    cardOriginBot :=
         rejTradeDirBefore == -1 ?
              (brokenBuyZoneFailedToBuy ? cardBrokenWatchBot : decisionTargetBot) :
              decisionBuyTouchBot
    cardOriginTf :=
         rejTradeDirBefore == -1 ?
              (brokenBuyZoneFailedToBuy ? cardBrokenWatchTf : decisionTargetTF) :
              buyDisplayTF

    // V20.2 Card only: lock the nearest VALID MAJOR SELL zone above Entry.
    // Prefer 1H/4H/D1; small live zones cannot replace it afterwards.
    [majorSellTop, majorSellBot, majorSellTf] = f_cardMajorSellTarget(close)
    cardTargetTop := majorSellTop
    cardTargetBot := majorSellBot
    cardTargetTf := majorSellTf
    cardLockedDir := 1
    cardTargetReached := false
    cardTargetReachedBar := na
    cardSearchReference := close

    cardStepSearchReference := close
    [firstStepSellTop, firstStepSellBot, firstStepSellTf] =
         f_cardStepSellTarget(cardStepSearchReference, cardTargetBot)
    cardStepTop := firstStepSellTop
    cardStepBot := firstStepSellBot
    cardStepTf := firstStepSellTf
    cardStepDir := 1
    cardStepReached := false
    cardDecisionIsStep := false

    // V21.7 STATE-MEMORY FIX ONLY:
    // Snapshot the exact reversal/origin invalidation BEFORE clearing the
    // broken-zone watch memory. This does not change any Zone signal rule.
    float buyInvalidSnapshot = na
    if rejTradeDirBefore == -1
        if brokenBuyZoneFailedToBuy
            buyInvalidSnapshot := cardBrokenWatchBot
        else
            buyInvalidSnapshot := decisionTargetBot
    else
        buyInvalidSnapshot := decisionBuyTouchBot

    cardBrokenWatchDir := 0
    cardBrokenWatchTop := na
    cardBrokenWatchBot := na
    cardBrokenWatchTf := "--"

    rejTradeStop := f_rejStop(1, close)
    rejTradeZoneInvalid := buyInvalidSnapshot
    rejTradeEntryBar := bar_index
    rejTradeEntryTime := time
    rejTradeBeLocked := false
    rejTradeCycle += 1
    rejTradeLastExit := "--"
    rejLastAlertBar := bar_index

    // Travelling state starts with NO target snapshot.
    decisionTargetSide := 0
    decisionTargetTop := na
    decisionTargetBot := na
    decisionTargetTime := na
    decisionTargetTF := "--"
    decisionTargetTouched := false
    decisionTargetTouchBar := na
    decisionTargetIsConflict := false
    decisionLastBrokenTargetTime := na
    decisionLastBrokenTargetSide := 0
    decisionLastConflictBuyTime := na
    decisionLastConflictSellTime := na
    decisionTargetLastEvent := "BUY ACTIVE • WAIT SELL BOX"

    rejBuyLevel := math.max(rejBuyLevel, 2)

    if decisionHistoryOpt == "Latest Only"
        if not na(decisionLastEntryLabel)
            label.delete(decisionLastEntryLabel)
        if not na(decisionLastTargetLabel)
            label.delete(decisionLastTargetLabel)
            decisionLastTargetLabel := na

    string buyDecisionText =
         rejTradeDirBefore == -1 and decisionTargetIsConflict ?
              "BUY REVERSE ↑\nCONFLICT EXIT" :
         rejTradeDirBefore == -1 ?
              "BUY REVERSE ↑" :
              "BUY ENTRY ✓"

    decisionLastEntryLabel := label.new(
         bar_index,
         low - signalMarkerGap,
         showDecisionLabels ? buyDecisionText : "⚡",
         xloc=xloc.bar_index,
         yloc=yloc.price,
         style=showDecisionLabels ? label.style_label_up : label.style_none,
         color=showDecisionLabels ? color.rgb(7, 78, 57) : color.new(bullColor, 100),
         textcolor=showDecisionLabels ? color.white : bullColor,
         size=showDecisionLabels ? f_decisionLabelSize() : size.large)

    decisionBuyTouchBar := na
    decisionBuyTouchTime := na
    decisionBuyTouchTop := na
    decisionBuyTouchBot := na
    decisionSellTouchBar := na
    decisionSellTouchTime := na
    decisionSellTouchTop := na
    decisionSellTouchBot := na

// ------------------------------------------------------------------
// SELL START / SELL REVERSAL
// ------------------------------------------------------------------
if rejSellEntryEvent
    if not na(decisionOriginWatchLabel)
        label.delete(decisionOriginWatchLabel)
        decisionOriginWatchLabel := na

    if rejTradeDirBefore == 1
        decisionLastExitTime := time
        decisionLastExitPrice := close
        decisionLastExitDir := 1
        decisionLastExitReason :=
             brokenSellZoneFailedToSell ? "BROKEN SELL ZONE FAILED" :
             "SELL BOX REJECT"

    rejLastSignalDir := -1
    rejLastSignalEntry := close
    rejLastSignalTime := time
    rejLastSignalKind := rejTradeDirBefore == 1 ? "SELL REVERSAL" : "SELL ENTRY"

    rejTradeDir := -1
    rejTradeEntry := close

    // Display snapshot only — does not affect trade logic.
    cardOriginTop :=
         rejTradeDirBefore == 1 ?
              (brokenSellZoneFailedToSell ? cardBrokenWatchTop : decisionTargetTop) :
              decisionSellTouchTop
    cardOriginBot :=
         rejTradeDirBefore == 1 ?
              (brokenSellZoneFailedToSell ? cardBrokenWatchBot : decisionTargetBot) :
              decisionSellTouchBot
    cardOriginTf :=
         rejTradeDirBefore == 1 ?
              (brokenSellZoneFailedToSell ? cardBrokenWatchTf : decisionTargetTF) :
              sellDisplayTF

    // V20.2 Card only: lock the nearest VALID MAJOR BUY zone below Entry.
    // Prefer 1H/4H/D1; small live zones cannot replace it afterwards.
    [majorBuyTop, majorBuyBot, majorBuyTf] = f_cardMajorBuyTarget(close)
    cardTargetTop := majorBuyTop
    cardTargetBot := majorBuyBot
    cardTargetTf := majorBuyTf
    cardLockedDir := -1
    cardTargetReached := false
    cardTargetReachedBar := na
    cardSearchReference := close

    cardStepSearchReference := close
    [firstStepBuyTop, firstStepBuyBot, firstStepBuyTf] =
         f_cardStepBuyTarget(cardStepSearchReference, cardTargetTop)
    cardStepTop := firstStepBuyTop
    cardStepBot := firstStepBuyBot
    cardStepTf := firstStepBuyTf
    cardStepDir := -1
    cardStepReached := false
    cardDecisionIsStep := false

    // V21.7 STATE-MEMORY FIX ONLY:
    // Snapshot the exact reversal/origin invalidation BEFORE clearing the
    // broken-zone watch memory. This does not change any Zone signal rule.
    float sellInvalidSnapshot = na
    if rejTradeDirBefore == 1
        if brokenSellZoneFailedToSell
            sellInvalidSnapshot := cardBrokenWatchTop
        else
            sellInvalidSnapshot := decisionTargetTop
    else
        sellInvalidSnapshot := decisionSellTouchTop

    cardBrokenWatchDir := 0
    cardBrokenWatchTop := na
    cardBrokenWatchBot := na
    cardBrokenWatchTf := "--"

    rejTradeStop := f_rejStop(-1, close)
    rejTradeZoneInvalid := sellInvalidSnapshot
    rejTradeEntryBar := bar_index
    rejTradeEntryTime := time
    rejTradeBeLocked := false
    rejTradeCycle += 1
    rejTradeLastExit := "--"
    rejLastAlertBar := bar_index

    decisionTargetSide := 0
    decisionTargetTop := na
    decisionTargetBot := na
    decisionTargetTime := na
    decisionTargetTF := "--"
    decisionTargetTouched := false
    decisionTargetTouchBar := na
    decisionTargetIsConflict := false
    decisionLastBrokenTargetTime := na
    decisionLastBrokenTargetSide := 0
    decisionLastConflictBuyTime := na
    decisionLastConflictSellTime := na
    decisionTargetLastEvent := "SELL ACTIVE • WAIT BUY BOX"

    rejSellLevel := math.max(rejSellLevel, 2)

    if decisionHistoryOpt == "Latest Only"
        if not na(decisionLastEntryLabel)
            label.delete(decisionLastEntryLabel)
        if not na(decisionLastTargetLabel)
            label.delete(decisionLastTargetLabel)
            decisionLastTargetLabel := na

    string sellDecisionText =
         rejTradeDirBefore == 1 and decisionTargetIsConflict ?
              "SELL REVERSE ↓\nCONFLICT EXIT" :
         rejTradeDirBefore == 1 ?
              "SELL REVERSE ↓" :
              "SELL ENTRY ✓"

    decisionLastEntryLabel := label.new(
         bar_index,
         high + signalMarkerGap,
         showDecisionLabels ? sellDecisionText : "⚡",
         xloc=xloc.bar_index,
         yloc=yloc.price,
         style=showDecisionLabels ? label.style_label_down : label.style_none,
         color=showDecisionLabels ? color.rgb(112, 27, 38) : color.new(bearColor, 100),
         textcolor=showDecisionLabels ? color.white : bearColor,
         size=showDecisionLabels ? f_decisionLabelSize() : size.large)

    decisionBuyTouchBar := na
    decisionBuyTouchTime := na
    decisionBuyTouchTop := na
    decisionBuyTouchBot := na
    decisionSellTouchBar := na
    decisionSellTouchTime := na
    decisionSellTouchTop := na
    decisionSellTouchBot := na

// ------------------------------------------------------------------
// V20.4 BREAK = KEEP SAME ACTIVE SIGNAL.
//
// STEP BREAK -> same trade, next 1M/5M checkpoint.
// MAJOR BREAK -> same trade, next major destination + restart step ladder.
// ------------------------------------------------------------------
if decisionContinueEvent
    float brokenTop = decisionTargetTop
    float brokenBot = decisionTargetBot
    string brokenTf = decisionTargetTF
    bool brokenWasStep = cardDecisionIsStep

    decisionLastBrokenTargetTime := decisionTargetTime
    decisionLastBrokenTargetSide := decisionTargetSide
    decisionLastConflictBuyTime := na
    decisionLastConflictSellTime := na

    // Most recently broken checkpoint becomes failed-break reversal watch.
    cardBrokenWatchDir := rejTradeDirBefore
    cardBrokenWatchTop := brokenTop
    cardBrokenWatchBot := brokenBot
    cardBrokenWatchTf := brokenTf

    if buyContinueEvent
        if brokenWasStep
            cardStepSearchReference := brokenTop + syminfo.mintick
            [nextStepSellTop, nextStepSellBot, nextStepSellTf] =
                 f_cardStepSellTarget(cardStepSearchReference, cardTargetBot)
            cardStepTop := nextStepSellTop
            cardStepBot := nextStepSellBot
            cardStepTf := nextStepSellTf
            cardStepDir := 1
            cardStepReached := false
            decisionTargetLastEvent :=
                 "STEP SELL " + brokenTf + " BROKE ↑ • BUY CONTINUES"
        else
            cardSearchReference := brokenTop + syminfo.mintick
            [nextSellTop, nextSellBot, nextSellTf] =
                 f_cardMajorSellTarget(cardSearchReference)
            cardTargetTop := nextSellTop
            cardTargetBot := nextSellBot
            cardTargetTf := nextSellTf
            cardLockedDir := 1
            cardTargetReached := false
            cardTargetReachedBar := na

            cardStepSearchReference := brokenTop + syminfo.mintick
            [newStepSellTop, newStepSellBot, newStepSellTf] =
                 f_cardStepSellTarget(cardStepSearchReference, cardTargetBot)
            cardStepTop := newStepSellTop
            cardStepBot := newStepSellBot
            cardStepTf := newStepSellTf
            cardStepDir := 1
            cardStepReached := false
            decisionTargetLastEvent :=
                 "MAJOR SELL " + brokenTf + " BROKE ↑ • BUY CONTINUES"

    if sellContinueEvent
        if brokenWasStep
            cardStepSearchReference := brokenBot - syminfo.mintick
            [nextStepBuyTop, nextStepBuyBot, nextStepBuyTf] =
                 f_cardStepBuyTarget(cardStepSearchReference, cardTargetTop)
            cardStepTop := nextStepBuyTop
            cardStepBot := nextStepBuyBot
            cardStepTf := nextStepBuyTf
            cardStepDir := -1
            cardStepReached := false
            decisionTargetLastEvent :=
                 "STEP BUY " + brokenTf + " BROKE ↓ • SELL CONTINUES"
        else
            cardSearchReference := brokenBot - syminfo.mintick
            [nextBuyTop, nextBuyBot, nextBuyTf] =
                 f_cardMajorBuyTarget(cardSearchReference)
            cardTargetTop := nextBuyTop
            cardTargetBot := nextBuyBot
            cardTargetTf := nextBuyTf
            cardLockedDir := -1
            cardTargetReached := false
            cardTargetReachedBar := na

            cardStepSearchReference := brokenBot - syminfo.mintick
            [newStepBuyTop, newStepBuyBot, newStepBuyTf] =
                 f_cardStepBuyTarget(cardStepSearchReference, cardTargetTop)
            cardStepTop := newStepBuyTop
            cardStepBot := newStepBuyBot
            cardStepTf := newStepBuyTf
            cardStepDir := -1
            cardStepReached := false
            decisionTargetLastEvent :=
                 "MAJOR BUY " + brokenTf + " BROKE ↓ • SELL CONTINUES"

    if decisionHistoryOpt == "Latest Only" and not na(decisionLastTargetLabel)
        label.delete(decisionLastTargetLabel)

    string continueLabelText =
         sellContinueEvent ?
              (brokenWasStep ? "SELL CONTINUE ↓\nSTEP BREAK" : "SELL CONTINUE ↓\nMAJOR BREAK") :
              (brokenWasStep ? "BUY CONTINUE ↑\nSTEP BREAK" : "BUY CONTINUE ↑\nMAJOR BREAK")

    decisionLastTargetLabel := label.new(
         bar_index,
         sellContinueEvent ? high + signalMarkerGap * 0.65 : low - signalMarkerGap * 0.65,
         continueLabelText,
         xloc=xloc.bar_index,
         yloc=yloc.price,
         style=sellContinueEvent ? label.style_label_down : label.style_label_up,
         color=sellContinueEvent ? color.rgb(112, 27, 38) : color.rgb(7, 78, 57),
         textcolor=color.white,
         size=f_decisionLabelSize())

    // BREAK never changes the active BUY / SELL direction.
    decisionTargetSide := 0
    decisionTargetTop := na
    decisionTargetBot := na
    decisionTargetTime := na
    decisionTargetTF := "--"
    decisionTargetTouched := false
    decisionTargetTouchBar := na
    decisionTargetIsConflict := false
    cardDecisionIsStep := false

// ------------------------------------------------------------------
// STALE TARGET EXPIRED
// Remove old WATCH state and wait for price to physically reach the
// CURRENT opposite box again. No reversal/continue signal is printed.
// ------------------------------------------------------------------
if decisionTargetExpired
    decisionTargetSide := 0
    decisionTargetTop := na
    decisionTargetBot := na
    decisionTargetTime := na
    decisionTargetTF := "--"
    decisionTargetTouched := false
    decisionTargetTouchBar := na
    decisionTargetIsConflict := false
    decisionTargetLastEvent := "OLD TARGET EXPIRED • WAIT CURRENT BOX"

// Compatibility booleans for existing dashboard.
bool decisionBuyTouchValid =
     rejTradeDir == -1 ?
          ((decisionTargetSide == 1 or decisionTargetIsConflict) and decisionTargetTouched) :
     rejTradeDir == 0 ? idleBuyArmed : false

bool decisionSellTouchValid =
     rejTradeDir == 1 ?
          ((decisionTargetSide == -1 or decisionTargetIsConflict) and decisionTargetTouched) :
     rejTradeDir == 0 ? idleSellArmed : false

float rejTradePl = f_dashboardPl(rejTradeEntry, rejTradeDir)

if rejTradeDir != 0 and not rejTradeBeLocked and not na(rejTradePl) and rejTradePl >= beTriggerProfitUsd
    rejTradeBeLocked := true

// V16.2 HOLD MODE:
// BE/SL/zone invalidation are INFORMATION ONLY.
// They do NOT close the Zone decision trade.
// The trade reverses only after the OPPOSITE visible zone confirms
// with a closed candle outside its box.
bool rejBeClosed = false
bool rejStopClosed = false
bool rejZoneInvalidClosed = false
bool rejTradeCloseEvent = false
int rejTradeClosingDir = 0
float rejTradeClosingEntry = na
string rejTradeClosingReason = "--"

//=============================================================================
// OPPOSITE BOX REACHED = THIS IS WHERE DECISION WORK STARTS
//=============================================================================
bool sellTradeExitWatchActive =
     rejTradeDir == -1 and decisionTargetSide == 1 and decisionTargetTouched

bool buyTradeExitWatchActive =
     rejTradeDir == 1 and decisionTargetSide == -1 and decisionTargetTouched

bool exitWatchActive = sellTradeExitWatchActive or buyTradeExitWatchActive

var label decisionExitWatchLabel = na

if newTargetTouchEvent
    if not na(decisionExitWatchLabel)
        label.delete(decisionExitWatchLabel)

    if showExitWatchLabel
        bool watchBelow = canArmBuyDecision or
             (canArmConflictDecision and rejTradeDirBefore == -1)

        string watchText =
             canArmConflictDecision ?
                  "CONFLICT ⚠\nWAIT OUTSIDE" :
             canArmBuyDecision ?
                  "BUY BOX ⚠\nREJECT / BREAK" :
                  "SELL BOX ⚠\nREJECT / BREAK"

        decisionExitWatchLabel := label.new(
             bar_index,
             watchBelow ? low - signalMarkerGap * 0.55 : high + signalMarkerGap * 0.55,
             watchText,
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=watchBelow ? label.style_label_up : label.style_label_down,
             color=color.rgb(255, 199, 64),
             textcolor=darkBg,
             size=size.tiny,
             tooltip="Decision window is fresh only for a few bars after the box is reached. Conflict cluster: price must fully exit the entire cluster.")

if rejBuyEntryEvent or rejSellEntryEvent or decisionContinueEvent or decisionTargetExpired
    if not na(decisionExitWatchLabel)
        label.delete(decisionExitWatchLabel)
        decisionExitWatchLabel := na

// Exact decision candle highlighting.
color decisionCandleColor =
     not highlightDecisionCandles ? na :
     rejBuyEntryEvent ? color.rgb(67, 232, 183) :
     rejSellEntryEvent ? color.rgb(255, 104, 117) :
     buyContinueEvent ? color.rgb(67, 232, 183) :
     sellContinueEvent ? color.rgb(255, 104, 117) : na

barcolor(decisionCandleColor)

//=============================================================================
// MEMBER-FACING V16.3 TARGET DECISION STATUS
//=============================================================================
int currentSetupDir =
     rejTradeDir != 0 ? rejTradeDir :
     idleBuyArmed and not idleSellArmed ? 1 :
     idleSellArmed and not idleBuyArmed ? -1 :
     priceInMapBuy ? 1 :
     priceInMapSell ? -1 : radarDir

int currentSetupLevel =
     rejTradeDir != 0 ? 2 :
     idleBuyArmed or idleSellArmed ? 1 : 0

float currentSetupRR =
     currentSetupDir == 1 ? buyCandidateRR :
     currentSetupDir == -1 ? sellCandidateRR : na

bool currentSetupSpaceOk =
     currentSetupDir == 1 ? buySpaceOk :
     currentSetupDir == -1 ? sellSpaceOk : false

string currentSetupSide = currentSetupDir == 1 ? "BUY" : currentSetupDir == -1 ? "SELL" : "WAIT"

string targetSideText =
     decisionTargetIsConflict ? "CONFLICT CLUSTER" :
     decisionTargetSide == 1 ? "BUY ZONE" :
     decisionTargetSide == -1 ? "SELL ZONE" : "--"

string targetPriceText =
     na(decisionTargetTop) or na(decisionTargetBot) ? "--" :
     str.tostring(decisionTargetBot, format.mintick) + " - " + str.tostring(decisionTargetTop, format.mintick)

string currentSetupText =
     rejTradeDir != 0 and decisionTargetIsConflict and decisionTargetFresh ?
          (rejTradeDir == 1 ? "BUY ACTIVE • CONFLICT • WAIT OUTSIDE" : "SELL ACTIVE • CONFLICT • WAIT OUTSIDE") :
     rejTradeDir == -1 and decisionTargetFresh ? "SELL ACTIVE • BUY ZONE REACHED • REJECT OR BREAK" :
     rejTradeDir == 1 and decisionTargetFresh ? "BUY ACTIVE • SELL ZONE REACHED • REJECT OR BREAK" :
     rejTradeDir == -1 ? "SELL ACTIVE • WAIT CURRENT BUY BOX" :
     rejTradeDir == 1 ? "BUY ACTIVE • WAIT CURRENT SELL BOX" :
     idleBuyArmed ? "BUY ZONE LOCKED • WAIT BODY 100% ABOVE" :
     idleSellArmed ? "SELL ZONE LOCKED • WAIT BODY 100% BELOW" :
     "WAIT FOR BUY / SELL ZONE"

color currentSetupColor = currentSetupDir == 1 ? bullColor : currentSetupDir == -1 ? bearColor : neutralColor

int focusDir = currentSetupDir
int focusLevel = currentSetupLevel
color focusColor = focusDir == 1 ? bullColor : focusDir == -1 ? bearColor : neutralColor

string signalStatus =
     rejTradeDir != 0 and decisionTargetIsConflict and decisionTargetFresh ? "CONFLICT • WAIT OUTSIDE" :
     rejTradeDir == -1 and decisionTargetFresh ? "SELL • TARGET BUY ZONE • DECIDE" :
     rejTradeDir == 1 and decisionTargetFresh ? "BUY • TARGET SELL ZONE • DECIDE" :
     rejTradeDir == -1 ? "SELL ACTIVE • HOLD" :
     rejTradeDir == 1 ? "BUY ACTIVE • HOLD" :
     idleBuyArmed ? "BUY WATCH • LOCKED ZONE" :
     idleSellArmed ? "SELL WATCH • LOCKED ZONE" : "WAIT FOR ZONE"

string tradeStatus = rejTradeDir == 1 ? "RUNNING BUY 🔒" : rejTradeDir == -1 ? "RUNNING SELL 🔒" : "WAIT"

string rejPlText = na(rejTradePl) ? "--" : "$" + str.tostring(rejTradePl, "#.00")
string rejBeText = rejTradeDir == 0 ? "WAIT" : rejTradeBeLocked ? "PROFIT PROTECTED" : "WATCH"
string rejSlText = slDisplayMode == "Off" ? "OFF" : na(rejTradeStop) ? "--" : str.tostring(rejTradeStop, format.mintick)

float decisionInvalidDisplay =
     rejTradeDir != 0 and not na(rejTradeZoneInvalid) ? rejTradeZoneInvalid :
     focusDir == 1 ? mapBuyBot : focusDir == -1 ? mapSellTop : na

string decisionEntryTimeText = na(rejTradeEntryTime) ? "--" : str.format_time(rejTradeEntryTime, "HH:mm", "Europe/London")
string decisionTradeAgeText = rejTradeDir == 0 or na(rejTradeEntryTime) ? "--" : f_ageText(rejTradeEntryTime)

string decisionExitWatchText =
     rejTradeDir != 0 and decisionTargetIsConflict and decisionTargetFresh ? "CONFLICT • WAIT OUTSIDE" :
     rejTradeDir != 0 and decisionTargetFresh ? targetSideText + " • DECISION NOW" :
     rejTradeDir != 0 ? (rejTradeDir == -1 ? "HOLD → CURRENT BUY BOX" : "HOLD → CURRENT SELL BOX") :
     idleBuyArmed ? "BUY WATCH" : idleSellArmed ? "SELL WATCH" : "WAIT FOR ZONE"

color decisionExitWatchColor =
     rejTradeDir != 0 and decisionTargetTouched ? gold :
     rejTradeDir == 1 ? bullColor : rejTradeDir == -1 ? bearColor : neutralColor

string decisionLastExitText =
     decisionLastExitDir == 0 or na(decisionLastExitTime) ? "LAST REVERSAL • --" :
     "LAST REVERSAL • " + (decisionLastExitDir == 1 ? "EXIT BUY" : "EXIT SELL") +
     " • " + decisionLastExitReason +
     " • " + str.format_time(decisionLastExitTime, "HH:mm", "Europe/London") +
     " • " + str.tostring(decisionLastExitPrice, format.mintick)

// Dedicated FLIGHT SIGNAL row — never hidden inside another header.
string masterFlightText =
     radarDir == 1 ?
         "✈ MAIN FLIGHT • BUY • " + str.tostring(radarConfidence, "#") + "% • " + runningAge :
     radarDir == -1 ?
         "✈ MAIN FLIGHT • SELL • " + str.tostring(radarConfidence, "#") + "% • " + runningAge :
     "✈ MAIN FLIGHT • WAIT"

color masterFlightColor =
     radarDir == 1 ? bullColor :
     radarDir == -1 ? bearColor : neutralColor

string lastSignalTimeText =
     na(rejLastSignalTime) ? "--" :
     str.format_time(rejLastSignalTime, "HH:mm", "Europe/London")

string masterLastSignalText =
     rejLastSignalDir == 0 ? "⚡ LAST REAL SIGNAL • --" :
     "⚡ LAST REAL SIGNAL • " + rejLastSignalKind +
     " • " + lastSignalTimeText +
     " • " + str.tostring(rejLastSignalEntry, format.mintick)

color masterLastSignalColor =
     rejLastSignalDir == 1 ? bullColor :
     rejLastSignalDir == -1 ? bearColor : neutralColor

string masterTradeStateText =
     rejTradeDir == 1 ? "TRADE STATUS • BUY ACTIVE 🔒" :
     rejTradeDir == -1 ? "TRADE STATUS • SELL ACTIVE 🔒" :
     rejTradeLastExit != "--" and rejLastSignalDir != 0 ?
         "TRADE STATUS • CLOSED • " + rejTradeLastExit +
         " • LAST " + (rejLastSignalDir == 1 ? "BUY" : "SELL") :
     "TRADE STATUS • NO ACTIVE TRADE"

color masterTradeStateColor =
     rejTradeDir == 1 ? bullColor :
     rejTradeDir == -1 ? bearColor :
     rejTradeLastExit != "--" ? gold : neutralColor

// Main banner describes ACTUAL trade state first.
// A rejected current setup is shown separately below; it does not overwrite
// the member's understanding of the last real signal.
string masterDecisionText =
     rejTradeDir == 1 ? "⚡ BUY ACTIVE • LOCKED" :
     rejTradeDir == -1 ? "⚡ SELL ACTIVE • LOCKED" :
     rejLastSignalDir == 1 and rejTradeLastExit != "--" ?
         "NO ACTIVE TRADE • LAST BUY • " + rejTradeLastExit :
     rejLastSignalDir == -1 and rejTradeLastExit != "--" ?
         "NO ACTIVE TRADE • LAST SELL • " + rejTradeLastExit :
     rejLastSignalDir == 1 ? "NO ACTIVE TRADE • LAST SIGNAL BUY" :
     rejLastSignalDir == -1 ? "NO ACTIVE TRADE • LAST SIGNAL SELL" :
     "WAIT FOR ZONE + CLOSED OUTSIDE"

color masterDecisionColor =
     rejTradeDir == 1 ? bullColor :
     rejTradeDir == -1 ? bearColor :
     rejLastSignalDir == 1 ? bullColor :
     rejLastSignalDir == -1 ? bearColor : neutralColor

string ladder1 = focusLevel >= 1 ? "✓" : "○"
string ladder2 = focusLevel >= 2 ? "✓" : "○"
string ladder3 = focusLevel >= 3 ? "✓" : "○"
string ladder4 = focusLevel >= 4 ? "✓" : "○"

float focusStrength =
     focusDir == 1 ? buyStrength :
     focusDir == -1 ? sellStrength :
     math.max(buyStrength, sellStrength)

//=============================================================================
// V1.2 LOCKED WHALE MONTHLY LEDGER + $100 PROFIT-LOCK LADDER
//=============================================================================
// IMPORTANT: This entire ledger block is intentionally placed AFTER the original
// Zone signal/decision engine. It reads FLIGHT state only and does not write to any
// Zone entry, reversal, target, conflict, rejection, confirmation or lifecycle variable.
// The Zone engine above is preserved exactly from the known-good pre-ledger build.
//
// CLOSED WHALE trades only.
// Each new confirmed WHALE signal opens ONE simulated ledger trade using the SFA lot
// locked at that entry.
//
// V2.4 GOLD + SILVER HOLD / MONEY-MANAGEMENT SCOPE:
//   GOLD (XAUUSD) + SILVER (XAGUSD) ONLY:
//     +$100 reached  -> lock +$25
//     +$250 reached  -> lock +$100
//     +$500 reached  -> lock +$250
//     +$750 reached  -> lock +$500
//     +$1,000 reached -> lock +$750
//     ...then every additional +$250 favourable move locks another +$250.
//   GOLD / SILVER HOLD EXIT (V2.4):
//     A normal signal END / neutral candle does NOT close the ledger trade.
//     A same-side WHALE re-entry does NOT reset the original trade entry or lock.
//     The trade stays open until an OPPOSITE WHALE signal or an active profit-lock stop is hit.
//   BTC / ETH / FOREX: EXACT V2.1 protection behaviour is preserved:
//     +$100 reached -> ENTRY / BE
//     +$500 reached -> lock +$250
//     +$750 reached -> lock +$500
//     +$1,000 reached -> lock +$750
//     ...then every additional +$250 favourable move locks another +$250.
//
// There is still NO artificial hard stop before profit protection.
//
// IMPORTANT HISTORICAL-BAR RULE:
// Pine historical OHLC does not reveal whether the HIGH or LOW happened first.
// To avoid false same-candle BE/lock exits, an upgraded trail becomes active on
// the NEXT bar. Existing trail protection is checked first; only if the trade is
// still open do we ratchet the stop from that bar's favourable excursion.
// This makes the monthly ledger much closer to a real step-trailing workflow.
//
// This is a dashboard simulation only; Pine cannot physically move a broker SL.
// Direct FLIGHT reversal closes any still-open ledger trade at the confirmed
// close unless an already-active trail stop was hit on that bar (trail priority).
// Neutralisation closes the open ledger trade at the confirmed close.
// Monthly attribution uses the CLOSE date/time in Europe/London.
const string flightLedgerTimezone = "Europe/London"
const int flightLedgerRows = 100

// V2.1 baseline — preserved for ETH / FOREX.
const float flightLedgerBeTriggerUsd = 100.0
const float flightLedgerLockStepUsd = 250.0
const float flightLedgerFirstProfitLockTriggerUsd = 500.0

// V2.5 BTC ONLY — HOLD + adaptive closed-candle protection.
// No forced BE below +$500.
// +$500 peak  -> protect +$100
// +$1,000     -> protect +$500
// +$1,500     -> protect +$750
// +$2,000     -> protect +$1,000
// Above +$2,000 -> protect 60% of the highest favourable P/L.
const float flightBtcProtectTrigger1Usd = 500.0
const float flightBtcProtectLock1Usd = 100.0
const float flightBtcProtectTrigger2Usd = 1000.0
const float flightBtcProtectLock2Usd = 500.0
const float flightBtcProtectTrigger3Usd = 1500.0
const float flightBtcProtectLock3Usd = 750.0
const float flightBtcProtectTrigger4Usd = 2000.0
const float flightBtcProtectLock4Usd = 1000.0
const float flightBtcPeakTrailPct = 0.60

// V2.4 GOLD + SILVER ONLY — protected profit + HOLD through neutral/same-side continuation.
const float flightMetalProtectTrigger1Usd = 100.0
const float flightMetalProtectLock1Usd = 25.0
const float flightMetalProtectTrigger2Usd = 250.0
const float flightMetalProtectLock2Usd = 100.0
const float flightMetalProtectTrigger3Usd = 500.0
const float flightMetalProtectLock3Usd = 250.0
const float flightMetalProtectTrigger4Usd = 750.0
const float flightMetalProtectLock4Usd = 500.0
const float flightMetalProtectTrigger5Usd = 1000.0
const float flightMetalProtectLock5Usd = 750.0
const float flightMetalProtectStepUsd = 250.0

bool flightLedgerUseMetalProfitLock = dashboardIsGold or dashboardIsSilver
// V2.4 metals keep HOLD semantics.
bool flightLedgerUseMetalHold = dashboardIsGold or dashboardIsSilver
// V2.5 BTC gets its OWN HOLD + adaptive protection. This changes only the simulated
// BTC ledger management; the locked Zone/WHALE signal engine and alert engine are untouched.
bool flightLedgerUseBtcAdaptiveHold = dashboardIsBtc
bool flightLedgerUseHold = flightLedgerUseMetalHold or flightLedgerUseBtcAdaptiveHold

var int flightMonthSignalCount = 0
var int flightMonthTradeCount = 0
var int flightMonthWinCount = 0
var int flightMonthLossCount = 0
var int flightMonthBeCount = 0
var float flightMonthNetPl = 0.0

var array<int> flightLedgerCloseTimes = array.new_int()
var array<int> flightLedgerDirs = array.new_int()
var array<float> flightLedgerLots = array.new_float()
var array<float> flightLedgerPls = array.new_float()
var array<float> flightLedgerEntries = array.new_float()
var array<float> flightLedgerExits = array.new_float()

// Independent ledger-trade state.
var int flightLedgerTradeDir = 0
var float flightLedgerTradeEntry = na
var float flightLedgerTradeLot = na
var int flightLedgerTradeEntryBar = na
var int flightLedgerTradeEntryTime = na

// Protective-stop state.
// ETH / FOREX retain V2.1:
//   trailSteps = 0 -> no protective stop yet; wait for +$100.
//   trailSteps = 1 -> +$100 reached, SL at ENTRY (BE).
//   trailSteps = 2 -> +$500 reached, +$250 locked.
//   trailSteps = 3 -> +$750 reached, +$500 locked, etc.
// GOLD / SILVER V2.4:
//   trailSteps = 0 -> no protective stop yet; wait for +$100.
//   trailSteps = 1 -> +$100 reached, +$25 locked.
//   trailSteps = 2 -> +$250 reached, +$100 locked.
//   trailSteps = 3 -> +$500 reached, +$250 locked.
//   trailSteps = 4 -> +$750 reached, +$500 locked.
//   trailSteps = 5 -> +$1,000 reached, +$750 locked, etc.
var int flightLedgerTrailSteps = 0
var float flightLedgerLockedUsd = na
var float flightLedgerTrailStopPrice = na
// V2.5 BTC peak favourable P/L used by the adaptive 60% trail.
var float flightLedgerPeakUsd = na

int flightMonthKey =
     year(time, flightLedgerTimezone) * 100 +
     month(time, flightLedgerTimezone)

bool flightNewCalendarMonth =
     not na(flightMonthKey[1]) and flightMonthKey != flightMonthKey[1]

if flightNewCalendarMonth
    flightMonthSignalCount := 0
    flightMonthTradeCount := 0
    flightMonthWinCount := 0
    flightMonthLossCount := 0
    flightMonthBeCount := 0
    flightMonthNetPl := 0.0
    // Keep the rolling last-100 history across month boundaries. Monthly counters reset above.

// Every confirmed new BUY/SELL FLIGHT event is a new ledger signal.
bool flightLedgerNewSignal = flightBuySignalEvent or flightSellSignalEvent

// -----------------------------------------------------------------------------
// ACTIVE PROTECTIVE STOP CHECK — only an already-active protection/lock.
// GOLD/SILVER: the first active protection already carries +$25.
// BTC V2.5 first protection starts only after +$500 and protects +$100.
// ETH/FOREX retain V2.1 +$100 -> BE. There is no artificial hard stop before protection.
// This prevents historical OHLC from falsely assuming a newly-raised stop was
// hit earlier on the same candle.
// -----------------------------------------------------------------------------
bool flightLedgerTrailActive =
     flightLedgerTradeDir != 0 and
     not na(flightLedgerTrailStopPrice)

// V2.5 BTC: protection is confirmed by the CANDLE CLOSE, not by a wick.
// Metals and legacy instruments retain their previous wick-touch behavior.
bool flightLedgerBtcProtectionTouched =
     barstate.isconfirmed and
     flightLedgerTrailActive and
     flightLedgerUseBtcAdaptiveHold and
     ((flightLedgerTradeDir == 1 and close <= flightLedgerTrailStopPrice) or
      (flightLedgerTradeDir == -1 and close >= flightLedgerTrailStopPrice))

bool flightLedgerLegacyTrailStopTouched =
     barstate.isconfirmed and
     flightLedgerTrailActive and
     not flightLedgerUseBtcAdaptiveHold and
     ((flightLedgerTradeDir == 1 and low <= flightLedgerTrailStopPrice) or
      (flightLedgerTradeDir == -1 and high >= flightLedgerTrailStopPrice))

bool flightLedgerTrailStopTouched =
     flightLedgerBtcProtectionTouched or flightLedgerLegacyTrailStopTouched

// V2.5 HOLD:
// - Gold/Silver keep V2.4 hold behavior.
// - BTC now also ignores neutralisation and same-side WHALE re-entry.
// - HOLD instruments close only on a genuine opposite WHALE signal or active protection.
// ETH / FOREX keep the V2.1 close rule.
bool flightLedgerOppositeSignal =
     flightLedgerTradeDir != 0 and
     ((flightLedgerTradeDir == 1 and flightSellSignalEvent) or
      (flightLedgerTradeDir == -1 and flightBuySignalEvent))

bool flightLedgerCloseBySignal =
     flightLedgerTradeDir != 0 and
     (flightLedgerUseHold ?
          flightLedgerOppositeSignal :
          (flightLedgerNewSignal or flightEndedEvent))

bool flightLedgerCloseNow = flightLedgerTrailStopTouched or flightLedgerCloseBySignal

if flightLedgerCloseNow and not na(flightLedgerTradeEntry)
    int closedDir = flightLedgerTradeDir
    float closedLot = na(flightLedgerTradeLot) ? dashboardLotSize : flightLedgerTradeLot
    float closedExitPrice = flightLedgerTrailStopTouched ? flightLedgerTrailStopPrice : close
    float closedPl = na

    // An already-active protective stop has priority over a signal close.
    // Use the exact locked-dollar value stored by the active instrument ladder.
    if flightLedgerTrailStopTouched
        closedPl := na(flightLedgerLockedUsd) ? 0.0 : flightLedgerLockedUsd
    else
        closedPl := f_dashboardPlLot(flightLedgerTradeEntry, closedExitPrice, closedDir, closedLot)

    if not na(closedPl)
        flightMonthTradeCount += 1
        flightMonthNetPl += closedPl

        if closedPl > 0
            flightMonthWinCount += 1
        else if closedPl < 0
            flightMonthLossCount += 1
        else
            flightMonthBeCount += 1

        array.push(flightLedgerCloseTimes, time)
        array.push(flightLedgerDirs, closedDir)
        array.push(flightLedgerLots, closedLot)
        array.push(flightLedgerPls, closedPl)
        array.push(flightLedgerEntries, flightLedgerTradeEntry)
        array.push(flightLedgerExits, closedExitPrice)

        if array.size(flightLedgerPls) > flightLedgerRows
            array.shift(flightLedgerCloseTimes)
            array.shift(flightLedgerDirs)
            array.shift(flightLedgerLots)
            array.shift(flightLedgerPls)
            array.shift(flightLedgerEntries)
            array.shift(flightLedgerExits)

    flightLedgerTradeDir := 0
    flightLedgerTradeEntry := na
    flightLedgerTradeLot := na
    flightLedgerTradeEntryBar := na
    flightLedgerTradeEntryTime := na
    flightLedgerTrailSteps := 0
    flightLedgerLockedUsd := na
    flightLedgerTrailStopPrice := na
    flightLedgerPeakUsd := na

// Count each NEW WHALE BUY / WHALE SELL once for the current month.
if flightLedgerNewSignal
    flightMonthSignalCount += 1

// Every NEW confirmed WHALE signal starts one fresh ledger trade. On a direct
// reversal, the previous trade is closed above first, then the opposite opens.
// V2.4 metals exception: if a Gold/Silver trade is already open and the same-side
// WHALE signal appears again after a neutral phase, KEEP the original trade/entry.
if flightLedgerNewSignal and radarDir != 0 and not na(radarEntry) and
     (not flightLedgerUseHold or flightLedgerTradeDir == 0)
    flightLedgerTradeDir := radarDir
    flightLedgerTradeEntry := radarEntry
    flightLedgerTradeLot := na(radarEntryLot) ? dashboardLotSize : radarEntryLot
    flightLedgerTradeEntryBar := bar_index
    flightLedgerTradeEntryTime := time
    flightLedgerTrailSteps := 0
    flightLedgerLockedUsd := na
    flightLedgerPeakUsd := na
    // No artificial hard SL before the instrument-specific protection trigger.
    // GOLD/SILVER first protection = +$25 after +$100.
    // BTC has no forced BE and waits until +$500 before protecting +$100.
    // ETH/FOREX retain V2.1 +$100 -> BE.
    flightLedgerTrailStopPrice := na

// -----------------------------------------------------------------------------
// PROFIT-LOCK RATCHET — update only AFTER stop/signal processing for this bar.
// The new stop therefore protects from the next bar onward.
//
// GOLD + SILVER ONLY:
//   +$100   -> lock +$25
//   +$250   -> lock +$100
//   +$500   -> lock +$250
//   +$750   -> lock +$500
//   +$1,000 -> lock +$750
//   then every additional +$250 favourable move locks another +$250.
//
// BTC V2.5 ONLY:
//   below +$500 -> HOLD, no forced BE
//   +$500  -> protect +$100
//   +$1,000 -> protect +$500
//   +$1,500 -> protect +$750
//   +$2,000 -> protect +$1,000
//   above +$2,000 -> protect 60% of highest favourable P/L
//   protection is only EXIT-confirmed on a CLOSED candle.
// ETH / FOREX remain V2.1.
// -----------------------------------------------------------------------------
bool flightLedgerCanRatchet = barstate.isconfirmed and not flightLedgerCloseNow and flightLedgerTradeDir != 0 and not na(flightLedgerTradeEntry) and not na(flightLedgerTradeEntryBar) and bar_index > flightLedgerTradeEntryBar

if flightLedgerCanRatchet
    float activeLot = na(flightLedgerTradeLot) ? dashboardLotSize : flightLedgerTradeLot
    float favourablePrice = flightLedgerTradeDir == 1 ? high : low
    float favourablePl = f_dashboardPlLot(
         flightLedgerTradeEntry, favourablePrice, flightLedgerTradeDir, activeLot)
    float moneyFactor = f_dashboardMoneyFactorForLot(activeLot)

    if flightLedgerUseMetalProfitLock
        // GOLD / SILVER: first protection is PROFIT, never $0 BE.
        int metalNewSteps = 0
        float metalNewLockedUsd = na

        if not na(favourablePl)
            if favourablePl >= flightMetalProtectTrigger5Usd
                int extraMetalSteps = int(math.floor((favourablePl - flightMetalProtectTrigger5Usd) / flightMetalProtectStepUsd))
                metalNewSteps := 5 + extraMetalSteps
                metalNewLockedUsd := flightMetalProtectLock5Usd + extraMetalSteps * flightMetalProtectStepUsd
            else if favourablePl >= flightMetalProtectTrigger4Usd
                metalNewSteps := 4
                metalNewLockedUsd := flightMetalProtectLock4Usd
            else if favourablePl >= flightMetalProtectTrigger3Usd
                metalNewSteps := 3
                metalNewLockedUsd := flightMetalProtectLock3Usd
            else if favourablePl >= flightMetalProtectTrigger2Usd
                metalNewSteps := 2
                metalNewLockedUsd := flightMetalProtectLock2Usd
            else if favourablePl >= flightMetalProtectTrigger1Usd
                metalNewSteps := 1
                metalNewLockedUsd := flightMetalProtectLock1Usd

        if metalNewSteps > flightLedgerTrailSteps and not na(metalNewLockedUsd)
            flightLedgerTrailSteps := metalNewSteps
            flightLedgerLockedUsd := metalNewLockedUsd

            if not na(moneyFactor) and moneyFactor > 0
                flightLedgerTrailStopPrice :=
                     flightLedgerTradeEntry +
                     flightLedgerTradeDir * (metalNewLockedUsd / moneyFactor)
    else if flightLedgerUseBtcAdaptiveHold
        // BTC V2.5 — HOLD + adaptive profit protection.
        // Track the best favourable excursion. Ratchet AFTER this bar's exit check,
        // therefore any newly-raised protection becomes active from the next bar.
        if not na(favourablePl)
            flightLedgerPeakUsd := na(flightLedgerPeakUsd) ? favourablePl : math.max(flightLedgerPeakUsd, favourablePl)

        float btcPeak = na(flightLedgerPeakUsd) ? 0.0 : flightLedgerPeakUsd
        float btcNewLockedUsd = na
        int btcNewStage = 0

        if btcPeak >= flightBtcProtectTrigger4Usd
            btcNewStage := 5 + int(math.floor((btcPeak - flightBtcProtectTrigger4Usd) / 250.0))
            btcNewLockedUsd := math.max(flightBtcProtectLock4Usd, btcPeak * flightBtcPeakTrailPct)
        else if btcPeak >= flightBtcProtectTrigger3Usd
            btcNewStage := 4
            btcNewLockedUsd := flightBtcProtectLock3Usd
        else if btcPeak >= flightBtcProtectTrigger2Usd
            btcNewStage := 3
            btcNewLockedUsd := flightBtcProtectLock2Usd
        else if btcPeak >= flightBtcProtectTrigger1Usd
            btcNewStage := 2
            btcNewLockedUsd := flightBtcProtectLock1Usd

        if not na(btcNewLockedUsd) and (na(flightLedgerLockedUsd) or btcNewLockedUsd > flightLedgerLockedUsd)
            flightLedgerTrailSteps := btcNewStage
            flightLedgerLockedUsd := btcNewLockedUsd

            if not na(moneyFactor) and moneyFactor > 0
                flightLedgerTrailStopPrice :=
                     flightLedgerTradeEntry +
                     flightLedgerTradeDir * (btcNewLockedUsd / moneyFactor)
    else
        // ETH / FOREX: V2.1 logic preserved exactly.
        // Stage 1: early BE protection at +$100.
        if not na(favourablePl) and favourablePl >= flightLedgerBeTriggerUsd and flightLedgerTrailSteps < 1
            flightLedgerTrailSteps := 1
            flightLedgerLockedUsd := 0.0
            flightLedgerTrailStopPrice := flightLedgerTradeEntry

        // Stage 2+: first real profit lock at +$500, then every +$250.
        if not na(favourablePl) and favourablePl >= flightLedgerFirstProfitLockTriggerUsd
            int reachedProfitLocks = int(math.floor((favourablePl - flightLedgerFirstProfitLockTriggerUsd) / flightLedgerLockStepUsd)) + 1
            int newTrailSteps = 1 + reachedProfitLocks

            if newTrailSteps > flightLedgerTrailSteps
                float newLockedUsd = reachedProfitLocks * flightLedgerLockStepUsd

                flightLedgerTrailSteps := newTrailSteps
                flightLedgerLockedUsd := newLockedUsd

                if not na(moneyFactor) and moneyFactor > 0
                    flightLedgerTrailStopPrice :=
                         flightLedgerTradeEntry +
                         flightLedgerTradeDir * (newLockedUsd / moneyFactor)


//=============================================================================
// MULTI-TIMEFRAME REJECTION STATUS (DASHBOARD ONLY)
// Every timeframe processes its own completed candle and its own zones.
//=============================================================================
f_rejMtfState() =>
    [sTop, sBot, sTime, bTop, bBot, bTime] = f_continuousZones()

    var int d = 0
    var int lvl = 0
    var int rTime = na
    var float rHi = na
    var float rLo = na
    var float rClose = na
    var float structHi = na
    var float structLo = na
    var int lastProcessed = na
    var int lastBuyZoneTime = na
    var int lastSellZoneTime = na

    // Reset a side if its active zone changes.
    if bTime != lastBuyZoneTime and not na(bTime)
        if d == 1
            d := 0
            lvl := 0
        lastBuyZoneTime := bTime

    if sTime != lastSellZoneTime and not na(sTime)
        if d == -1
            d := 0
            lvl := 0
        lastSellZoneTime := sTime

    if not na(time[1]) and time[1] != lastProcessed
        float o = open[1]
        float h = high[1]
        float l = low[1]
        float c = close[1]
        int t = time[1]
        lastProcessed := t

        // Existing L1 must be confirmed by the immediate next completed candle.
        if lvl == 1 and not na(rTime) and t > rTime
            bool okFollow = d == 1 ?
                 (c > o and c > rClose) :
                 (c < o and c < rClose)
            if okFollow
                lvl := 2
            else
                d := 0
                lvl := 0
                rTime := na
                rHi := na
                rLo := na
                rClose := na

        // Advance confirmed setups.
        if lvl >= 2
            if d == 1 and not na(rHi) and c > rHi
                lvl := math.max(lvl, 3)
            if d == -1 and not na(rLo) and c < rLo
                lvl := math.max(lvl, 3)

            if d == 1 and not na(structHi) and c > structHi
                lvl := 4
            if d == -1 and not na(structLo) and c < structLo
                lvl := 4

            // Closed through invalid side = setup no longer valid.
            if d == 1 and not na(bBot) and c < bBot
                d := 0
                lvl := 0
            if d == -1 and not na(sTop) and c > sTop
                d := 0
                lvl := 0

        // Fresh rejection can start a new watch.
        bool bTouch = not na(bTop) and not na(bBot) and l <= bTop and h >= bBot
        bool sTouch = not na(sTop) and not na(sBot) and h >= sBot and l <= sTop

        bool bReject = bTouch and c < o and c >= bBot and c > l + (h - l) * 0.25
        bool sReject = sTouch and c > o and c <= sTop and c < h - (h - l) * 0.25

        if bReject
            d := 1
            lvl := 1
            rTime := t
            rHi := h
            rLo := l
            rClose := c
            structHi := ta.highest(high[2], rejectStructureLookback)
            structLo := na

        if sReject
            d := -1
            lvl := 1
            rTime := t
            rHi := h
            rLo := l
            rClose := c
            structLo := ta.lowest(low[2], rejectStructureLookback)
            structHi := na

    [d, lvl]

[mtf1Dir, mtf1Lvl] = request.security(syminfo.tickerid, "1", f_rejMtfState(), barmerge.gaps_off, barmerge.lookahead_off)
[mtf5Dir, mtf5Lvl] = request.security(syminfo.tickerid, "5", f_rejMtfState(), barmerge.gaps_off, barmerge.lookahead_off)
[mtf15Dir, mtf15Lvl] = request.security(syminfo.tickerid, "15", f_rejMtfState(), barmerge.gaps_off, barmerge.lookahead_off)
[mtf30Dir, mtf30Lvl] = request.security(syminfo.tickerid, "30", f_rejMtfState(), barmerge.gaps_off, barmerge.lookahead_off)
[mtf1hDir, mtf1hLvl] = request.security(syminfo.tickerid, "60", f_rejMtfState(), barmerge.gaps_off, barmerge.lookahead_off)
[mtf4hDir, mtf4hLvl] = request.security(syminfo.tickerid, "240", f_rejMtfState(), barmerge.gaps_off, barmerge.lookahead_off)
[mtfD1Dir, mtfD1Lvl] = request.security(syminfo.tickerid, "D", f_rejMtfState(), barmerge.gaps_off, barmerge.lookahead_off)

f_mtfTxt(int d, int l) =>
    l <= 0 ? "WAIT" :
     d == 1 ? ("L" + str.tostring(l) + " BUY" + (l >= 2 ? " ⚡" : "")) :
     d == -1 ? ("L" + str.tostring(l) + " SELL" + (l >= 2 ? " ⚡" : "")) :
     "WAIT"

f_mtfCol(int d, int l) =>
    l <= 0 ? neutralColor :
     d == 1 ? bullColor :
     d == -1 ? bearColor : neutralColor

// The current chart timeframe must always show exactly the same state
// as the main live rejection engine.
int mtf1DirUi = timeframe.period == "1" ? focusDir : mtf1Dir
int mtf1LvlUi = timeframe.period == "1" ? focusLevel : mtf1Lvl
int mtf5DirUi = timeframe.period == "5" ? focusDir : mtf5Dir
int mtf5LvlUi = timeframe.period == "5" ? focusLevel : mtf5Lvl
int mtf15DirUi = timeframe.period == "15" ? focusDir : mtf15Dir
int mtf15LvlUi = timeframe.period == "15" ? focusLevel : mtf15Lvl
int mtf30DirUi = timeframe.period == "30" ? focusDir : mtf30Dir
int mtf30LvlUi = timeframe.period == "30" ? focusLevel : mtf30Lvl
int mtf1hDirUi = timeframe.period == "60" ? focusDir : mtf1hDir
int mtf1hLvlUi = timeframe.period == "60" ? focusLevel : mtf1hLvl
int mtf4hDirUi = timeframe.period == "240" ? focusDir : mtf4hDir
int mtf4hLvlUi = timeframe.period == "240" ? focusLevel : mtf4hLvl
int mtfD1DirUi = timeframe.period == "D" ? focusDir : mtfD1Dir
int mtfD1LvlUi = timeframe.period == "D" ? focusLevel : mtfD1Lvl

f_sessionText() =>
    int h = hour(timenow, "Etc/UTC")
    h >= 12 and h < 21 ? "NEW YORK" :
     h >= 7 and h < 16 ? "LONDON" :
     h >= 0 and h < 8 ? "ASIA" : "OFF"

f_yesNo(bool v) =>
    v ? "YES" : "NO"

f_checkMark(bool v) =>
    v ? "✓" : "○"


//=============================================================================
// SFA CLOSEPROOF — TINY LIVE-STEPS DASHBOARD
//
// Member-facing progression:
//   STEP 1  ZONE FOUND
//   STEP 2  REJECTION CLOSED
//   STEP 3  NEXT-CANDLE L2 CONFIRMED
//   STEP 4  RR / SPACE PASSED
//
// Zone Strength is a SCORE, not a win-rate prediction:
//   70% weight = Quality Score / 8
//   30% weight = Confirmation Level / 4
//=============================================================================
float focusRejClose = focusDir == 1 ? rejBuyClose : focusDir == -1 ? rejSellClose : na
float focusRejHigh = focusDir == 1 ? rejBuyHigh : focusDir == -1 ? rejSellHigh : na
float focusRejLow = focusDir == 1 ? rejBuyLow : focusDir == -1 ? rejSellLow : na
float focusRejVol = focusDir == 1 ? rejBuyVol : focusDir == -1 ? rejSellVol : na
float focusAvgVol = focusDir == 1 ? rejBuyAvgVol : focusDir == -1 ? rejSellAvgVol : na
float focusClosePos = focusDir == 1 ? rejBuyClosePos : focusDir == -1 ? rejSellClosePos : na
bool focusSwept = focusDir == 1 ? rejBuySwept : focusDir == -1 ? rejSellSwept : false

float focusInvalid =
     rejTradeDir != 0 and not na(rejTradeZoneInvalid) ? rejTradeZoneInvalid :
     focusDir == 1 ? marketBuyVisualBot :
     focusDir == -1 ? marketSellVisualTop : na

float focusNextLevel =
     rejTradeDir == 1 and not na(decisionTargetBot) ? decisionTargetBot :
     rejTradeDir == -1 and not na(decisionTargetTop) ? decisionTargetTop :
     focusDir == 1 ? mapSellBot : focusDir == -1 ? mapBuyTop : na

float focusCandidateEntry =
     rejTradeDir == focusDir and not na(rejTradeEntry) ? rejTradeEntry :
     focusDir == 1 and not na(rejBuyClose) ? rejBuyClose :
     focusDir == -1 and not na(rejSellClose) ? rejSellClose : close

float focusRisk =
     na(focusInvalid) ? na :
     math.abs(focusCandidateEntry - focusInvalid)

float focusReward =
     focusDir == 1 ?
         (na(focusNextLevel) or focusNextLevel <= focusCandidateEntry ? na : focusNextLevel - focusCandidateEntry) :
     focusDir == -1 ?
         (na(focusNextLevel) or focusNextLevel >= focusCandidateEntry ? na : focusCandidateEntry - focusNextLevel) :
     na

float focusRR =
     na(focusRisk) or focusRisk <= 0 or na(focusReward) ? na :
     focusReward / focusRisk

bool focusSpaceOk = not na(focusRR) and focusRR >= minRoomRR

float focusEffortRatio =
     na(focusRejVol) or na(focusAvgVol) or focusAvgVol == 0 ? na :
     focusRejVol / focusAvgVol

string effortText =
     na(focusEffortRatio) ? "--" :
     focusEffortRatio >= 1.5 ? "HIGH" :
     focusEffortRatio >= 0.85 ? "AVG" : "LOW"

// Quality Score / 8.
bool q1Location = not na(focusInvalid)
bool q2Sweep = focusSwept
bool q3Closed = focusLevel >= 1
bool q4CloseBack = focusLevel >= 1
bool q5AwayExtreme =
     na(focusClosePos) ? false :
     focusDir == 1 ? focusClosePos >= 35.0 :
     focusDir == -1 ? focusClosePos <= 65.0 : false
bool q6Follow = focusLevel >= 2
bool q7Structure = focusLevel >= 3
bool q8Space = focusSpaceOk

int qualityScore =
     (q1Location ? 1 : 0) +
     (q2Sweep ? 1 : 0) +
     (q3Closed ? 1 : 0) +
     (q4CloseBack ? 1 : 0) +
     (q5AwayExtreme ? 1 : 0) +
     (q6Follow ? 1 : 0) +
     (q7Structure ? 1 : 0) +
     (q8Space ? 1 : 0)

// LIVE 4-step progress.
bool liveStep1 = q1Location
bool liveStep2 = focusLevel >= 1
bool liveStep3 = focusLevel >= 2
bool liveStep4 = focusLevel >= 2 and focusSpaceOk

int liveStepsClear =
     (liveStep1 ? 1 : 0) +
     (liveStep2 ? 1 : 0) +
     (liveStep3 ? 1 : 0) +
     (liveStep4 ? 1 : 0)

string step1State = liveStep1 ? "✓" : "○"
string step2State = liveStep2 ? "✓" : "○"
string step3State = liveStep3 ? "✓" : "○"
string step4State =
     focusLevel < 2 ? "WAIT" :
     liveStep4 ? "✓" : "✕"

// Zone Strength Score.
// This is intentionally named SCORE, not probability/win-rate.
float zoneStrengthRaw =
     (qualityScore / 8.0) * 70.0 +
     (focusLevel / 4.0) * 30.0
int zoneStrengthPct = int(math.round(math.min(100.0, math.max(0.0, zoneStrengthRaw))))
int zoneStarCount =
     zoneStrengthPct >= 90 ? 5 :
     zoneStrengthPct >= 75 ? 4 :
     zoneStrengthPct >= 60 ? 3 :
     zoneStrengthPct >= 40 ? 2 :
     zoneStrengthPct > 0 ? 1 : 0

string zoneStars =
     zoneStarCount == 5 ? "★★★★★" :
     zoneStarCount == 4 ? "★★★★☆" :
     zoneStarCount == 3 ? "★★★☆☆" :
     zoneStarCount == 2 ? "★★☆☆☆" :
     zoneStarCount == 1 ? "★☆☆☆☆" : "☆☆☆☆☆"

string zoneGrade =
     zoneStrengthPct >= 90 ? "VERY STRONG" :
     zoneStrengthPct >= 75 ? "STRONG" :
     zoneStrengthPct >= 60 ? "GOOD" :
     zoneStrengthPct >= 40 ? "MEDIUM" : "WEAK"

string decisionText = masterDecisionText
color decisionColor = masterDecisionColor

string mtfRow1 =
     "1M " + f_mtfTxt(mtf1DirUi, mtf1LvlUi) +
     "  •  5M " + f_mtfTxt(mtf5DirUi, mtf5LvlUi) +
     "  •  15M " + f_mtfTxt(mtf15DirUi, mtf15LvlUi)

string mtfRow2 =
     "30M " + f_mtfTxt(mtf30DirUi, mtf30LvlUi) +
     "  •  H1 " + f_mtfTxt(mtf1hDirUi, mtf1hLvlUi) +
     "  •  H4 " + f_mtfTxt(mtf4hDirUi, mtf4hLvlUi) +
     "  •  D1 " + f_mtfTxt(mtfD1DirUi, mtfD1LvlUi)

string latestEvent = "NO REJECTION EVENT"
if array.size(recentEvtTime) > 0
    int eDir = array.get(recentEvtDir, 0)
    string eSide = eDir == 1 ? "BULL" : "BEAR"
    string eTime = str.format_time(array.get(recentEvtTime, 0), "HH:mm", "Europe/London")
    float eLvl = array.get(recentEvtLevel, 0)
    float ePos = array.get(recentEvtClosePos, 0)
    float eEff = array.get(recentEvtEffort, 0)
    latestEvent := eTime + " " + eSide + " @" + str.tostring(eLvl, format.mintick) +
         " • " + str.tostring(ePos, "#") + "% • " + str.tostring(eEff, "#.00") + "×"

//=============================================================================
// SFA 🐋 WHALE ZONES STIKE — V7 SIGNAL-SYNC DASHBOARD
//
// The member can now read four independent states with no contradiction:
// 1. FLIGHT SIGNAL
// 2. TRADE STATUS
// 3. LAST REAL SIGNAL
// 4. CURRENT SETUP
//=============================================================================
bool dashMobile = dashboardLayoutOpt == "Mobile" and showMobileDashboard
bool dashFull = dashboardLayoutOpt == "Full" or (dashboardLayoutOpt == "Mobile" and not showMobileDashboard)

string mobileBuyMain =
     na(mapBuyTop) ? "BUY • --" :
     buyConfluence ?
         "BUY CONFLUENCE • " + buyDisplayTF + " • " +
         str.tostring(buyDisplayStrength) + "% " + buyDisplayStars :
         "BUY 1 • " + mapBuyTF + " • " +
         str.tostring(mapBuyStrength) + "% " + mapBuyStars

string mobileBuyNext =
     buyConfluence ? "BUY 2 • MERGED" :
     na(mapBuy2Top) ? "NEXT BUY • --" :
     "NEXT BUY • " + mapBuy2TF + " • " +
     str.tostring(mapBuy2Strength) + "% " + mapBuy2Stars

string mobileSellMain =
     na(mapSellTop) ? "SELL • --" :
     sellConfluence ?
         "SELL CONFLUENCE • " + sellDisplayTF + " • " +
         str.tostring(sellDisplayStrength) + "% " + sellDisplayStars :
         "SELL 1 • " + mapSellTF + " • " +
         str.tostring(mapSellStrength) + "% " + mapSellStars

string mobileSellNext =
     sellConfluence ? "SELL 2 • MERGED" :
     na(mapSell2Top) ? "NEXT SELL • --" :
     "NEXT SELL • " + mapSell2TF + " • " +
     str.tostring(mapSell2Strength) + "% " + mapSell2Stars

string mobileSteps =
     "1 ZONE " + step1State +
     "  •  2 REJ " + step2State +
     "  •  3 L2 " + step3State +
     "  •  4 RR " + step4State

string mobileTradeLine =
     "ENTRY " + (na(rejTradeEntry) ? "--" : str.tostring(rejTradeEntry, format.mintick)) +
     "  •  INVALID " + (na(focusInvalid) ? "--" : str.tostring(focusInvalid, format.mintick))

string mobileTargetLine =
     (focusDir == -1 ? "TARGET S1 " : "TARGET R1 ") +
     (na(focusNextLevel) ? "--" : str.tostring(focusNextLevel, format.mintick)) +
     "  •  RR " + (na(focusRR) ? "--" : str.tostring(focusRR, "#.##")) +
     (na(focusRR) ? "" : focusSpaceOk ? " ✓" : " POOR")

string mobileManageLine =
     "P/L " + rejPlText +
     "  •  BE " + rejBeText +
     "  •  " + (persistentAlerts ? "PERMANENT ALERTS ON 🔔" : "ALERTS OFF")

string mobileMtf1 =
     "1M " + f_mtfTxt(mtf1DirUi, mtf1LvlUi) +
     "  •  5M " + f_mtfTxt(mtf5DirUi, mtf5LvlUi) +
     "  •  15M " + f_mtfTxt(mtf15DirUi, mtf15LvlUi)

string mobileMtf2 =
     "30M " + f_mtfTxt(mtf30DirUi, mtf30LvlUi) +
     "  •  H1 " + f_mtfTxt(mtf1hDirUi, mtf1hLvlUi) +
     "  •  H4 " + f_mtfTxt(mtf4hDirUi, mtf4hLvlUi) +
     "  •  D1 " + f_mtfTxt(mtfD1DirUi, mtfD1LvlUi)

string fullStrengthLine =
     zoneStars + "  " + str.tostring(zoneStrengthPct) + "% • " + zoneGrade +
     "  |  QUALITY " + str.tostring(qualityScore) + "/8" +
     "  |  VSA " + effortText

// V15 compact Mobile-only display strings.
string mobileFlightShort =
     radarDir == 1 ?
         "✈ FLIGHT BUY • " + str.tostring(radarConfidence, "#") + "% • " + runningAge :
     radarDir == -1 ?
         "✈ FLIGHT SELL • " + str.tostring(radarConfidence, "#") + "% • " + runningAge :
     "✈ FLIGHT WAIT"

string mobileSetupShort =
     rejTradeDir != 0 and decisionTargetIsConflict and decisionTargetFresh ? "CONFLICT • WAIT OUTSIDE" :
     rejTradeDir == -1 and decisionTargetFresh ? "SELL • BUY ZONE • DECIDE" :
     rejTradeDir == 1 and decisionTargetFresh ? "BUY • SELL ZONE • DECIDE" :
     rejTradeDir == -1 ? "SELL ACTIVE • HOLD" :
     rejTradeDir == 1 ? "BUY ACTIVE • HOLD" :
     idleBuyArmed ? "BUY ZONE LOCKED" :
     idleSellArmed ? "SELL ZONE LOCKED" :
     "SETUP • WAIT FOR ZONE"

string mobileConfirmShort =
     rejTradeDir != 0 and decisionTargetIsConflict and decisionTargetFresh ?
          "CONFLICT • EXIT CLUSTER FIRST" :
     rejTradeDir != 0 and decisionTargetFresh ? "TARGET • REJECT = REVERSE • BREAK = CONTINUE" :
     rejTradeDir != 0 ? rejTradeDir == -1 ? "WAIT • CURRENT BUY BOX" : "WAIT • CURRENT SELL BOX" :
     idleBuyArmed ? "ENTRY • BODY 100% ABOVE BUY BOX" :
     idleSellArmed ? "ENTRY • BODY 100% BELOW SELL BOX" :
     "ENTRY • FIRST 100% OUTSIDE CANDLE"

string mobileStrengthShort =
     "ZONE " + str.tostring(zoneStrengthPct) + "% " + zoneStars +
     " • Q " + str.tostring(qualityScore) + "/8"

string mobileAdxShort =
     "ADX 5M " + str.tostring(adx5, "#.0") +
     " • " + adxStatus +
     " • " + adxTradeIdea

string mobileEntryShort =
     "ENTRY " + (na(rejTradeEntry) ? "--" : str.tostring(rejTradeEntry, format.mintick)) +
     " • " + decisionEntryTimeText +
     " • AGE " + decisionTradeAgeText

string mobileExitWatchShort =
     decisionExitWatchText

string mobileTargetShort =
     (focusDir == -1 ? "NEXT S1 " : "NEXT R1 ") +
     (na(focusNextLevel) ? "--" : str.tostring(focusNextLevel, format.mintick)) +
     " • INV " + (na(decisionInvalidDisplay) ? "--" : str.tostring(decisionInvalidDisplay, format.mintick)) +
     " • RR " + (na(focusRR) ? "--" : str.tostring(focusRR, "#.##"))

string mobileManageShort =
     "P/L " + rejPlText +
     " • " + (rejTradeDir != 0 ? "ZONE HOLD ACTIVE" : "WAIT") +
     " • " + (persistentAlerts ? "ALERTS ON 🔔" : "ALERTS OFF")

//=============================================================================
// V20.2 FIXED MAJOR TARGET REACH — CARD DISPLAY ONLY
//=============================================================================
if not decisionContinueEvent and not rejBuyEntryEvent and not rejSellEntryEvent
    if rejTradeDir == 1 and cardLockedDir == 1 and not cardTargetReached and not na(cardTargetBot)
        if high >= cardTargetBot
            cardTargetReached := true
            cardTargetReachedBar := bar_index
    if rejTradeDir == -1 and cardLockedDir == -1 and not cardTargetReached and not na(cardTargetTop)
        if low <= cardTargetTop
            cardTargetReached := true
            cardTargetReachedBar := bar_index

//=============================================================================
// V20 PREMIUM TRADE CARD — DISPLAY ONLY
//=============================================================================
f_cardRange(float bot, float top) =>
    na(bot) or na(top) ? "--" :
     str.tostring(bot, format.mintick) + " — " + str.tostring(top, format.mintick)

f_cardProgress(float r) =>
    float safe = na(r) ? 0.0 : math.max(0.0, math.min(5.0, r))
    int filled = int(math.round(safe / 5.0 * 10.0))
    string s = ""
    for i = 0 to 9
        s += i < filled ? "█" : "░"
    s

float cardRisk =
     rejTradeDir == 0 or na(rejTradeEntry) ? na :
     not na(rejTradeStop) ? math.abs(rejTradeEntry - rejTradeStop) :
     not na(rejTradeZoneInvalid) ? math.abs(rejTradeEntry - rejTradeZoneInvalid) :
     na

float cardLiveR =
     rejTradeDir == 0 or na(cardRisk) or cardRisk <= 0 ? na :
     (close - rejTradeEntry) * rejTradeDir / cardRisk

float cardTarget1 =
     rejTradeDir == 1 and cardLockedDir == 1 ? cardTargetBot :
     rejTradeDir == -1 and cardLockedDir == -1 ? cardTargetTop : na

float cardTarget2 =
     rejTradeDir == 1 and cardLockedDir == 1 ? cardTargetTop :
     rejTradeDir == -1 and cardLockedDir == -1 ? cardTargetBot : na

float cardTarget1R =
     rejTradeDir == 0 or na(cardTarget1) or na(cardRisk) or cardRisk <= 0 ? na :
     (cardTarget1 - rejTradeEntry) * rejTradeDir / cardRisk

//=============================================================================
// V20.6 PRE-ENTRY ZONE READY
//=============================================================================
f_zoneDistance(float bot, float top) =>
    na(bot) or na(top) ? na :
     close > top ? close - top :
     close < bot ? bot - close :
     0.0

bool readyBuyAvailable =
     rejTradeDir == 0 and
     not na(marketBuyVisualTop) and not na(marketBuyVisualBot)

bool readySellAvailable =
     rejTradeDir == 0 and
     not na(marketSellVisualTop) and not na(marketSellVisualBot)

float readyBuyDistance =
     readyBuyAvailable ? f_zoneDistance(marketBuyVisualBot, marketBuyVisualTop) : na

float readySellDistance =
     readySellAvailable ? f_zoneDistance(marketSellVisualBot, marketSellVisualTop) : na

int readyZoneSide =
     idleBuyArmed ? 1 :
     idleSellArmed ? -1 :
     radarDir == 1 and readyBuyAvailable ? 1 :
     radarDir == -1 and readySellAvailable ? -1 :
     readyBuyAvailable and readySellAvailable ?
          (readyBuyDistance <= readySellDistance ? 1 : -1) :
     readyBuyAvailable ? 1 :
     readySellAvailable ? -1 : 0

bool readyZoneTouched =
     readyZoneSide == 1 ? idleBuyArmed :
     readyZoneSide == -1 ? idleSellArmed :
     false

float readyZoneTop =
     readyZoneSide == 1 ?
          (idleBuyArmed ? decisionBuyTouchTop : marketBuyVisualTop) :
     readyZoneSide == -1 ?
          (idleSellArmed ? decisionSellTouchTop : marketSellVisualTop) :
     na

float readyZoneBot =
     readyZoneSide == 1 ?
          (idleBuyArmed ? decisionBuyTouchBot : marketBuyVisualBot) :
     readyZoneSide == -1 ?
          (idleSellArmed ? decisionSellTouchBot : marketSellVisualBot) :
     na

string readyZoneTf =
     readyZoneSide == 1 ? buyDisplayTF :
     readyZoneSide == -1 ? sellDisplayTF :
     "--"

float readyDistance = f_zoneDistance(readyZoneBot, readyZoneTop)

float readyDistanceAtr =
     na(readyDistance) or na(mapAtrNow) or mapAtrNow <= 0 ? na :
     readyDistance / mapAtrNow

float readyTrigger =
     readyZoneSide == 1 ? readyZoneTop :
     readyZoneSide == -1 ? readyZoneBot :
     na

float readyInvalid =
     readyZoneSide == 1 ? readyZoneBot :
     readyZoneSide == -1 ? readyZoneTop :
     na

[readyBuyMajorTop, readyBuyMajorBot, readyBuyMajorTf] =
     f_cardMajorSellTarget(readyZoneSide == 1 ? readyTrigger : na)

[readySellMajorTop, readySellMajorBot, readySellMajorTf] =
     f_cardMajorBuyTarget(readyZoneSide == -1 ? readyTrigger : na)

float readyMajorTop =
     readyZoneSide == 1 ? readyBuyMajorTop :
     readyZoneSide == -1 ? readySellMajorTop :
     na

float readyMajorBot =
     readyZoneSide == 1 ? readyBuyMajorBot :
     readyZoneSide == -1 ? readySellMajorBot :
     na

string readyMajorTf =
     readyZoneSide == 1 ? readyBuyMajorTf :
     readyZoneSide == -1 ? readySellMajorTf :
     "--"

[readyBuyStepTop, readyBuyStepBot, readyBuyStepTf] =
     f_cardStepSellTarget(
          readyZoneSide == 1 ? readyTrigger : na,
          readyZoneSide == 1 ? readyMajorBot : na)

[readySellStepTop, readySellStepBot, readySellStepTf] =
     f_cardStepBuyTarget(
          readyZoneSide == -1 ? readyTrigger : na,
          readyZoneSide == -1 ? readyMajorTop : na)

float readyStepTop =
     readyZoneSide == 1 ? readyBuyStepTop :
     readyZoneSide == -1 ? readySellStepTop :
     na

float readyStepBot =
     readyZoneSide == 1 ? readyBuyStepBot :
     readyZoneSide == -1 ? readySellStepBot :
     na

string readyStepTf =
     readyZoneSide == 1 ? readyBuyStepTf :
     readyZoneSide == -1 ? readySellStepTf :
     "--"

bool cardAtRisk =
     rejTradeDir == 1 ? buyTradeAtRisk :
     rejTradeDir == -1 ? sellTradeAtRisk :
     false

string cardDistanceText =
     na(readyDistance) ? "--" :
     readyZoneTouched ? "0.0 ATR • TOUCHED" :
     showDistanceAtr and not na(readyDistanceAtr) ?
          str.tostring(readyDistanceAtr, "#.##") + "x ATR • " +
          str.tostring(readyDistance, format.mintick) :
     str.tostring(readyDistance, format.mintick)

string cardDirection =
     rejTradeDir == 1 ? "BUY" :
     rejTradeDir == -1 ? "SELL" :
     readyZoneSide == 1 ? (readyZoneTouched ? "BUY TOUCH" : "BUY ZONE") :
     readyZoneSide == -1 ? (readyZoneTouched ? "SELL TOUCH" : "SELL ZONE") :
     "WAIT"

string cardTf =
     rejTradeDir != 0 ? cardOriginTf :
     readyZoneSide != 0 ? readyZoneTf :
     f_chartTfText()

string cardTargetTfText =
     rejTradeDir != 0 and cardLockedDir == rejTradeDir ? cardTargetTf : "--"

string cardStepRange =
     rejTradeDir != 0 and cardStepDir == rejTradeDir and not na(cardStepTop) ?
          f_cardRange(cardStepBot, cardStepTop) : "--"

string cardStepText =
     cardStepReached ? "STEP " + cardStepTf + " REACHED" :
     rejTradeDir != 0 and cardStepDir == rejTradeDir and not na(cardStepTop) ?
          "STEP " + cardStepTf + " 🔒" :
     rejTradeDir != 0 ? "NO SMALL STEP" :
     "WAIT"

string cardZoneLockText =
     cardTargetReached ? "MAJOR " + cardTargetTf + " REACHED 🎯" :
     rejTradeDir != 0 and cardLockedDir == rejTradeDir and not na(cardTargetTop) ?
          "MAJOR " + cardTargetTf + " 🔒" :
     rejTradeDir != 0 ? "NO VALID MAJOR TARGET" :
     "LIVE WATCH"

string cardHeat = zoneStrengthPct >= 75 ? " 🔥" : zoneStrengthPct >= 60 ? " ⚡" : ""

string cardTradeBar =
     rejTradeDir != 0 ?
          (cardAtRisk ? "⚠ ACTIVE • AT RISK" : "● TRADE ACTIVE") :
     readyZoneTouched ? "● TOUCHED • WAIT CLOSE" :
     showZoneReadyCard and readyZoneSide != 0 ? "● ZONE READY" :
     sfaInLiveRebuildWindow ? "● WAIT LIVE SETUP" :
     "● HISTORY"

string cardZoneRange =
     rejTradeDir != 0 ? f_cardRange(cardOriginBot, cardOriginTop) :
     readyZoneSide != 0 ? f_cardRange(readyZoneBot, readyZoneTop) :
     "--"

string cardStop =
     slDisplayMode == "Off" ?
          (na(rejTradeZoneInvalid) ? "--" : str.tostring(rejTradeZoneInvalid, format.mintick) + " INV") :
     na(rejTradeStop) ? "--" : str.tostring(rejTradeStop, format.mintick)

string cardRR = na(cardTarget1R) ? "--" : "1 : " + str.tostring(cardTarget1R, "#.##")

string cardConfirm =
     rejTradeDir == 1 ?
          (cardAtRisk ?
               "AT RISK • price crossed BUY invalidation • WAIT CURRENT CANDLE CLOSE" :
               "CONFIRMED • closed 100% above BUY box • entry valid") :
     rejTradeDir == -1 ?
          (cardAtRisk ?
               "AT RISK • price crossed SELL invalidation • WAIT CURRENT CANDLE CLOSE" :
               "CONFIRMED • closed 100% below SELL box • entry valid") :
     readyZoneSide == 1 and readyZoneTouched ?
          "TOUCHED • candle must CLOSE 100% above BUY box • otherwise NO ENTRY" :
     readyZoneSide == -1 and readyZoneTouched ?
          "TOUCHED • candle must CLOSE 100% below SELL box • otherwise NO ENTRY" :
     readyZoneSide == 1 ?
          "ZONE READY • wait for BUY-zone touch • then wait CLOSED confirmation" :
     readyZoneSide == -1 ?
          "ZONE READY • wait for SELL-zone touch • then wait CLOSED confirmation" :
     "WAIT • no valid current zone ready"

string cardAction =
     rejTradeDir == 1 ?
          (cardAtRisk ? "BUY • WAIT CLOSE" :
           cardStepReached ? "BUY • DECIDE STEP" :
           cardTargetReached ? "BUY • DECIDE MAJOR" : "BUY • HOLD") :
     rejTradeDir == -1 ?
          (cardAtRisk ? "SELL • WAIT CLOSE" :
           cardStepReached ? "SELL • DECIDE STEP" :
           cardTargetReached ? "SELL • DECIDE MAJOR" : "SELL • HOLD") :
     readyZoneSide == 1 ?
          (readyZoneTouched ? "BUY • CONFIRM?" : "BUY • READY") :
     readyZoneSide == -1 ?
          (readyZoneTouched ? "SELL • CONFIRM?" : "SELL • READY") :
     "WAIT"

string cardManage =
     rejTradeDir == 0 ?
          (readyZoneSide == 0 ?
               (sfaInLiveRebuildWindow ? "WAIT • no current zone ready" : "HISTORY • rebuilding live state") :
           readyZoneTouched ?
               "WAIT CONFIRMATION • touch alone is NOT an entry" :
               "ZONE DETECTED • wait for touch • no active trade yet") :
     cardAtRisk ?
          "AT RISK • do not flip intrabar • WAIT CLOSED CANDLE" :
     cardStepReached ?
          "STEP DECISION • REJECT = reverse • BREAK = next step" :
     cardTargetReached ?
          "MAJOR DECISION • REJECT = reverse • BREAK = next major" :
     not na(cardStepTop) ?
          "STEP-BY-STEP • next " + cardStepTf + " checkpoint • major " + cardTargetTf :
     not na(cardTargetTop) ?
          "NO SMALL STEP • hold directly to major " + cardTargetTf :
     "WAIT • no valid opposite zone ahead"

string cardPL = na(rejTradePl) ? "--" : "$" + str.tostring(rejTradePl, "#.00")
string cardRText = na(cardLiveR) ? "--" : str.tostring(cardLiveR, "#.##") + "R"
string cardBar = f_cardProgress(cardLiveR)

//=============================================================================
// V20 ELITE PRO DASHBOARD
// Premium spacing + clean hierarchy.
// Trading logic is intentionally untouched.
//=============================================================================

// -----------------------------------------------------------------------------
// PREMIUM PALETTE
// -----------------------------------------------------------------------------
// V20.8 DIGITAL TERMINAL PALETTE
color proBg       = color.rgb(3, 8, 14)
color proHeader   = color.rgb(5, 15, 25)
color proLabelBg  = color.rgb(8, 20, 31)
color proValueBg  = color.rgb(4, 12, 20)
color proSection  = color.rgb(4, 11, 18)
color proBlueBg   = color.rgb(7, 30, 45)

color proGold     = color.rgb(255, 193, 47)
color proWhite    = color.rgb(238, 244, 248)
color proMuted    = color.rgb(112, 139, 157)

color proBuyBg    = color.rgb(4, 58, 43)
color proSellBg   = color.rgb(71, 17, 28)
color proWarnBg   = color.rgb(76, 48, 8)

// -----------------------------------------------------------------------------
// SHORT DISPLAY HELPERS
// -----------------------------------------------------------------------------
f_proRange(float bot, float top) =>
    na(bot) or na(top) ? "--" :
     str.tostring(bot, format.mintick) + " – " + str.tostring(top, format.mintick)

f_proStrength(int pct) =>
    pct >= 80 ? str.tostring(pct) + "% • ELITE" :
     pct >= 65 ? str.tostring(pct) + "% • STRONG" :
     pct >= 45 ? str.tostring(pct) + "% • GOOD" :
     str.tostring(pct) + "% • WEAK"

f_proMtf(string tf, int dir, int lvl) =>
    tf + " " +
     (lvl >= 2 ? (dir == 1 ? "BUY" : dir == -1 ? "SELL" : "WAIT") :
      lvl == 1 ? (dir == 1 ? "B-WATCH" : dir == -1 ? "S-WATCH" : "WAIT") :
      "WAIT")

string proAction =
     decisionTargetIsConflict and decisionTargetFresh ? "WAIT OUTSIDE" :
     rejTradeDir == 1 and decisionTargetFresh ? "BUY • DECIDE" :
     rejTradeDir == -1 and decisionTargetFresh ? "SELL • DECIDE" :
     rejTradeDir == 1 ? "BUY • HOLD" :
     rejTradeDir == -1 ? "SELL • HOLD" :
     idleBuyArmed ? "WATCH BUY" :
     idleSellArmed ? "WATCH SELL" :
     "WAIT"

string proState =
     rejTradeDir == 1 ? "BUY ACTIVE" :
     rejTradeDir == -1 ? "SELL ACTIVE" :
     "NO TRADE"

string proDecision =
     decisionTargetIsConflict and decisionTargetFresh ? "CONFLICT • WAIT" :
     rejTradeDir == -1 and decisionTargetFresh ? "BUY BOX • REJECT / BREAK" :
     rejTradeDir == 1 and decisionTargetFresh ? "SELL BOX • REJECT / BREAK" :
     rejTradeDir == -1 ? "NEXT BUY BOX" :
     rejTradeDir == 1 ? "NEXT SELL BOX" :
     idleBuyArmed ? "WAIT 100% ABOVE" :
     idleSellArmed ? "WAIT 100% BELOW" :
     "WAIT ZONE"

string proAdx =
     str.tostring(adx5, "#.0") + " • " +
     (adx5 >= adxReadyLevel ? "STRONG" :
      adx5 >= adxCautionLevel ? "BUILDING" : "SIDEWAY")

string proBuyBox =
     f_proRange(marketBuyVisualBot, marketBuyVisualTop) + " • " + buyDisplayTF

string proSellBox =
     f_proRange(marketSellVisualBot, marketSellVisualTop) + " • " + sellDisplayTF

string proEntry =
     na(rejTradeEntry) ? "--" : str.tostring(rejTradeEntry, format.mintick)

string proAge =
     rejTradeDir == 0 ? "--" : decisionTradeAgeText

string proNext =
     decisionTargetFresh ? f_proRange(decisionTargetBot, decisionTargetTop) :
     rejTradeDir == -1 ? f_proRange(marketBuyVisualBot, marketBuyVisualTop) :
     rejTradeDir == 1 ? f_proRange(marketSellVisualBot, marketSellVisualTop) :
     "--"

string proNextName =
     decisionTargetIsConflict and decisionTargetFresh ? "CONFLICT" :
     "NEXT"

string proFresh =
     decisionTargetFresh ?
          str.tostring(decisionTargetAge) + "/" + str.tostring(targetDecisionBars) :
     "--"

string proConflict =
     decisionTargetIsConflict and decisionTargetFresh ? "ACTIVE • WAIT" :
     decisionZoneConflict ? "NEAR" :
     "CLEAR"

string proRR =
     na(focusRR) ? "--" : str.tostring(focusRR, "#.##")

string proPL = rejPlText

string proQuality =
     str.tostring(zoneStrengthPct) + "% • Q" + str.tostring(qualityScore)

string proFlight =
     radarDir == 1 ? "BUY " + str.tostring(radarConfidence, "#") + "%" :
     radarDir == -1 ? "SELL " + str.tostring(radarConfidence, "#") + "%" :
     "WAIT"

string proAlert =
     persistentAlerts ? "ON 🔔" : "OFF"

string proCandle =
     barstate.isconfirmed ? "CLOSED ✓" : "LIVE"

string proMtf1  = f_proMtf("1M",  mtf1DirUi,  mtf1LvlUi)
string proMtf5  = f_proMtf("5M",  mtf5DirUi,  mtf5LvlUi)
string proMtf15 = f_proMtf("15M", mtf15DirUi, mtf15LvlUi)
string proMtf30 = f_proMtf("30M", mtf30DirUi, mtf30LvlUi)
string proMtfH1 = f_proMtf("H1",  mtf1hDirUi, mtf1hLvlUi)
string proMtfH4 = f_proMtf("H4",  mtf4hDirUi, mtf4hLvlUi)
string proMtfD1 = f_proMtf("D1",  mtfD1DirUi,  mtfD1LvlUi)

// Phone-specific ultra-short strings for the auto-sized card.
string mobileAction =
     decisionTargetIsConflict and decisionTargetFresh ? "WAIT OUTSIDE" :
     rejTradeDir == 1 and decisionTargetFresh ? "BUY DECIDE" :
     rejTradeDir == -1 and decisionTargetFresh ? "SELL DECIDE" :
     rejTradeDir == 1 ? "BUY HOLD" :
     rejTradeDir == -1 ? "SELL HOLD" :
     idleBuyArmed ? "WATCH BUY" :
     idleSellArmed ? "WATCH SELL" :
     "WAIT"

string mobileDecision =
     decisionTargetIsConflict and decisionTargetFresh ? "CONFLICT • WAIT" :
     rejTradeDir == -1 and decisionTargetFresh ? "BUY BOX • R/B" :
     rejTradeDir == 1 and decisionTargetFresh ? "SELL BOX • R/B" :
     rejTradeDir == -1 ? "NEXT BUY BOX" :
     rejTradeDir == 1 ? "NEXT SELL BOX" :
     idleBuyArmed ? "100% ABOVE BUY" :
     idleSellArmed ? "100% BELOW SELL" :
     "WAIT ZONE"

string mobileAdx =
     str.tostring(adx5, "#.0") + " " +
     (adx5 >= adxReadyLevel ? "STRONG" :
      adx5 >= adxCautionLevel ? "BUILD" : "SIDEWAY")

string mobileEntry =
     proEntry + (rejTradeDir == 0 ? "" : " • " + proAge)

string mobileNext = proNext

string mobileZone =
     "Q" + str.tostring(qualityScore) +
     " • " + str.tostring(zoneStrengthPct) + "%" +
     " • " + (decisionZoneConflict ? "CONFLICT" : "CLEAR")

string mobilePL =
     proPL + " • " + (persistentAlerts ? "ALERT ON" : "ALERT OFF")

// -----------------------------------------------------------------------------
// COLOR STATES
// -----------------------------------------------------------------------------
color proActionColor =
     decisionTargetIsConflict and decisionTargetFresh ? proGold :
     rejTradeDir == 1 ? bullColor :
     rejTradeDir == -1 ? bearColor :
     neutralColor

color proActionBg =
     decisionTargetIsConflict and decisionTargetFresh ? proWarnBg :
     rejTradeDir == 1 ? proBuyBg :
     rejTradeDir == -1 ? proSellBg :
     proValueBg

color proDecisionColor =
     decisionTargetFresh ? proGold : proWhite

color proAdxColor =
     adx5 >= adxReadyLevel ? bullColor :
     adx5 >= adxCautionLevel ? proGold :
     bearColor

// -----------------------------------------------------------------------------
// SFA 🐋 WHALE ZONES STIKE — PREMIUM DIGITAL DASHBOARD V2.7 BTC ADAPTIVE HOLD
// UI ONLY. The locked Zone engine and locked WHALE signal engine above are untouched.
// P/L is always calculated from WHALE signal ENTRY -> EXIT / LIVE PRICE, never
// zone-to-zone. Fixed SFA money logic remains unchanged (Gold 0.10 basis, etc.).
// Full history stores up to 100 trades and uses 25-trade pages because Pine tables
// do not provide an interactive scrollbar.
// -----------------------------------------------------------------------------
int whaleHistoryRows =
     whaleHistoryRowsOpt == "25" ? 25 :
     whaleHistoryRowsOpt == "50" ? 50 : 100

int whaleHistoryPage =
     whaleHistoryPageOpt == "2" ? 2 :
     whaleHistoryPageOpt == "3" ? 3 :
     whaleHistoryPageOpt == "4" ? 4 : 1

int whaleHistoryMaxPage = int(math.ceil(whaleHistoryRows / 25.0))
int whaleHistoryPageSafe = math.min(whaleHistoryPage, whaleHistoryMaxPage)
int whaleHistoryPageStart = (whaleHistoryPageSafe - 1) * 25

var table whaleMainPanel = table.new(
     f_dashboardPos(desktopPosOpt), 6, 17,
     bgcolor=proBg,
     frame_color=proGold,
     frame_width=1,
     border_color=color.new(infoBlue, 82),
     border_width=1)

var table whaleHistoryPanel = table.new(
     f_dashboardPos(flightMonthPanelPosOpt), 7, 28,
     bgcolor=proBg,
     frame_color=proGold,
     frame_width=1,
     border_color=color.new(infoBlue, 84),
     border_width=1)

// Separate compact DIGITAL signal strip. V2.7 keeps ADX / MARKET and makes all DIGITAL text true bold.
var table whaleDigitalStrip = table.new(
     f_dashboardPos(digitalStripPosOpt), 6, 3,
     bgcolor=color.rgb(5, 17, 24),
     frame_color=proGold,
     frame_width=2,
     border_color=color.new(infoBlue, 72),
     border_width=1)

f_digitalStripTextSize() =>
    digitalStripSizeOpt == "Tiny" ? size.tiny :
     digitalStripSizeOpt == "Small" ? size.small :
     digitalStripSizeOpt == "Normal" ? size.normal : size.large

f_digitalStripCell(int col, int row, string txt, color txtColor, color bgColor) =>
    table.cell(
         whaleDigitalStrip, col, row, txt,
         text_color=txtColor,
         bgcolor=bgColor,
         text_size=f_digitalStripTextSize(),
         text_formatting=text.format_bold,
         text_halign=text.align_center,
         text_valign=text.align_center)

f_renderDigitalSignalStrip() =>
    table.set_position(whaleDigitalStrip, f_dashboardPos(digitalStripPosOpt))
    table.clear(whaleDigitalStrip, 0, 0, 5, 2)

    bool stripTradeOpen = flightLedgerTradeDir != 0 and not na(flightLedgerTradeEntry)
    bool stripHeldTrade = flightLedgerUseHold and stripTradeOpen
    int stripDir = stripHeldTrade ? flightLedgerTradeDir : radarDir
    float stripEntry = stripHeldTrade ? flightLedgerTradeEntry : radarEntry
    float stripLot = stripHeldTrade ?
         (na(flightLedgerTradeLot) ? dashboardLotSize : flightLedgerTradeLot) :
         (na(radarEntryLot) ? dashboardLotSize : radarEntryLot)

    float stripLivePl = stripDir != 0 and not na(stripEntry) ?
         f_dashboardPlLot(stripEntry, close, stripDir, stripLot) : na
    float stripLivePct = stripDir != 0 and not na(stripEntry) and stripEntry != 0 ?
         (close - stripEntry) * stripDir / stripEntry * 100.0 : na

    string stripAge = stripHeldTrade and not na(flightLedgerTradeEntryTime) ?
         f_ageText(flightLedgerTradeEntryTime) : radarDir == 0 ? "--" : runningAge
    string stripSide = stripDir == 1 ? "🐋 WHALE BUY" : stripDir == -1 ? "🐋 WHALE SELL" : "🐋 WHALE WAIT"
    string stripRun = stripDir == 0 ? "WAIT" : "⚡ RUNNING"
    color stripSignalBg = stripDir == 1 ? color.rgb(0, 82, 54) : stripDir == -1 ? color.rgb(104, 38, 47) : color.rgb(19, 36, 46)
    color stripLiveColor = na(stripLivePl) ? proMuted : stripLivePl >= 0 ? bullColor : bearColor
    string stripPl = na(stripLivePl) ? "--" : f_moneyText(stripLivePl)
    string stripPct = na(stripLivePct) ? "--" : (stripLivePct >= 0 ? "+" : "") + str.tostring(stripLivePct, "#.00") + "%"

    // Header row — intentionally clean and high contrast.
    f_digitalStripCell(0, 0, "SFA 🐋", proGold, color.rgb(5, 17, 24))
    f_digitalStripCell(1, 0, "WHALE ZONES", proWhite, color.rgb(5, 17, 24))
    f_digitalStripCell(2, 0, syminfo.ticker, infoBlue, color.rgb(5, 17, 24))
    f_digitalStripCell(3, 0, f_chartTfText(), proWhite, color.rgb(5, 17, 24))
    f_digitalStripCell(4, 0, "PREMIUM", proGold, color.rgb(5, 17, 24))
    f_digitalStripCell(5, 0, "V2.7", bullColor, color.rgb(5, 17, 24))

    // Main signal row — larger DIGITAL writing.
    f_digitalStripCell(0, 1, stripRun, color.white, stripSignalBg)
    f_digitalStripCell(1, 1, stripSide, color.white, stripSignalBg)
    f_digitalStripCell(2, 1, "LIVE P/L\n" + stripPl + "\n" + stripPct, stripLiveColor, color.rgb(5, 28, 27))
    f_digitalStripCell(3, 1, "CONF\n" + str.tostring(radarConfidence, "#") + "%", proWhite, color.rgb(5, 17, 24))
    f_digitalStripCell(4, 1, "AGE\n" + stripAge, proGold, color.rgb(5, 17, 24))
    f_digitalStripCell(5, 1, "ALERT\n" + (persistentAlerts ? "ON" : "OFF"), persistentAlerts ? bullColor : bearColor, color.rgb(5, 17, 24))

    // V2.7 DIGITAL row — ADX + MARKET retained; all DIGITAL cells are bold. Logic is untouched.
    string stripMarketText =
         marketSideways or adx5 < adxCautionLevel ? "SIDEWAY" :
         stripDir == 1 ? "TREND UP" :
         stripDir == -1 ? "TREND DOWN" : "WAIT"
    color stripMarketColor =
         stripMarketText == "SIDEWAY" ? proGold :
         stripMarketText == "TREND UP" ? bullColor :
         stripMarketText == "TREND DOWN" ? bearColor : proMuted

    f_digitalStripCell(0, 2, "ADX 5M", proMuted, color.rgb(8, 24, 31))
    f_digitalStripCell(1, 2, str.tostring(adx5, "#.0"), proAdxColor, color.rgb(8, 24, 31))
    f_digitalStripCell(2, 2, adxStatus, proAdxColor, color.rgb(8, 24, 31))
    f_digitalStripCell(3, 2, "MARKET", proMuted, color.rgb(8, 24, 31))
    f_digitalStripCell(4, 2, stripMarketText, stripMarketColor, color.rgb(8, 24, 31))
    f_digitalStripCell(5, 2, adxTradeIdea, adxTradeIdeaColor, color.rgb(8, 24, 31))

// V2.7: DIGITAL text-formatting update only. GOLD/SILVER keep V2.4 hold + protected-profit ladder.
// BTC: HOLD through neutral/same-side continuation + adaptive closed-candle protection.
// BTC: +$500→+$100, +$1,000→+$500, +$1,500→+$750, +$2,000→+$1,000, then 60% of peak.
// ETH / FOREX remain V2.1.
// No merged cells are used. Every visible dashboard cell contains useful information.
// Zone engine, WHALE signal engine, entries, confirmations, EMA200, ADX and history logic remain unchanged.
// IMPORTANT: no artificial hard stop is added before the instrument-specific protection trigger.

f_whaleBodySize() =>
    desktopSizeOpt == "Tiny" ? size.tiny :
     desktopSizeOpt == "Small" ? size.tiny :
     desktopSizeOpt == "Normal" ? size.small : size.normal

f_whaleHeaderSize() =>
    desktopSizeOpt == "Tiny" ? size.tiny :
     desktopSizeOpt == "Small" ? size.small :
     desktopSizeOpt == "Normal" ? size.normal : size.large

f_whaleHistoryBodySize() =>
    flightMonthPanelSizeOpt == "Normal" ? size.small : size.tiny

f_whaleHistoryHeaderSize() =>
    flightMonthPanelSizeOpt == "Tiny" ? size.tiny :
     flightMonthPanelSizeOpt == "Small" ? size.small : size.normal

f_whaleCell(int col, int row, string txt, color txtColor, color bgColor, bool header) =>
    table.cell(
         whaleMainPanel, col, row, txt,
         text_color=txtColor,
         bgcolor=bgColor,
         text_size=header ? f_whaleHeaderSize() : f_whaleBodySize(),
         text_halign=text.align_center,
         text_valign=text.align_center)

f_whaleHistoryCell(int col, int row, string txt, color txtColor, color bgColor, bool header) =>
    table.cell(
         whaleHistoryPanel, col, row, txt,
         text_color=txtColor,
         bgcolor=bgColor,
         text_size=header ? f_whaleHistoryHeaderSize() : f_whaleHistoryBodySize(),
         text_halign=text.align_center,
         text_valign=text.align_center)

f_renderWhaleMain() =>
    table.set_position(whaleMainPanel, f_dashboardPos(desktopPosOpt))
    table.clear(whaleMainPanel, 0, 0, 5, 16)

    bool whaleTradeOpen = flightLedgerTradeDir != 0 and not na(flightLedgerTradeEntry)

    // V2.5 dashboard: Gold/Silver + BTC display the HELD ledger direction and
    // original ledger entry through a neutral radar phase. Signal engine is untouched.
    bool heldTrade = flightLedgerUseHold and whaleTradeOpen
    int whaleDisplayDir = heldTrade ? flightLedgerTradeDir : radarDir
    float whaleDisplayEntry = heldTrade ? flightLedgerTradeEntry : radarEntry
    float signalLot = heldTrade ?
         (na(flightLedgerTradeLot) ? dashboardLotSize : flightLedgerTradeLot) :
         (na(radarEntryLot) ? dashboardLotSize : radarEntryLot)

    float livePl = whaleDisplayDir != 0 and not na(whaleDisplayEntry) ?
         f_dashboardPlLot(whaleDisplayEntry, close, whaleDisplayDir, signalLot) : na
    color livePlColor = na(livePl) ? proMuted : livePl >= 0 ? bullColor : bearColor

    float livePlPct = na
    if whaleDisplayDir != 0 and not na(whaleDisplayEntry) and whaleDisplayEntry != 0
        livePlPct := (close - whaleDisplayEntry) * whaleDisplayDir / whaleDisplayEntry * 100.0

    string livePlText = f_moneyText(livePl)
    string livePlPctText = na(livePlPct) ? "--" : (livePlPct >= 0 ? "+" : "") + str.tostring(livePlPct, "#.00") + "%"

    bool whaleSignalActive = whaleDisplayDir != 0
    bool whaleFlashOn = whaleSignalActive and (int(timenow / 650) % 2 == 0)

    color whaleFlashBg =
         not whaleSignalActive ? proValueBg :
         whaleDisplayDir == 1 ? (whaleFlashOn ? color.new(color.lime, 68) : color.new(color.lime, 86)) :
         whaleDisplayDir == -1 ? (whaleFlashOn ? color.new(color.red, 66) : color.new(color.red, 86)) :
         proValueBg

    color whaleFlashText = whaleSignalActive ? color.white : proGold
    string whaleSideText = whaleDisplayDir == 1 ? "🐋 WHALE BUY" : whaleDisplayDir == -1 ? "🐋 WHALE SELL" : "🐋 WHALE WAIT"
    string runningText = whaleDisplayDir == 0 ? "WAIT" : "⚡ RUNNING"

    string entryText = whaleTradeOpen ? str.tostring(flightLedgerTradeEntry, format.mintick) : whaleDisplayDir == 0 or na(whaleDisplayEntry) ? "--" : str.tostring(whaleDisplayEntry, format.mintick)
    string currentText = str.tostring(close, format.mintick)
    string ageText = heldTrade and not na(flightLedgerTradeEntryTime) ? f_ageText(flightLedgerTradeEntryTime) : radarDir == 0 ? "--" : runningAge

    string marketText =
         marketSideways or adx5 < adxCautionLevel ? "SIDEWAY" :
         whaleDisplayDir == 1 ? "TREND UP" :
         whaleDisplayDir == -1 ? "TREND DOWN" : "WAIT"

    color marketColor =
         marketText == "SIDEWAY" ? proGold :
         marketText == "TREND UP" ? bullColor :
         marketText == "TREND DOWN" ? bearColor : proMuted

    float emaDist = close - ema200
    float emaDistPct = not na(ema200) and ema200 != 0 ? emaDist / ema200 * 100.0 : na
    string emaPosText = close >= ema200 ? "ABOVE ↑" : "BELOW ↓"
    color emaPosColor = close >= ema200 ? bullColor : bearColor

    string lockedText =
         not whaleTradeOpen ? (radarDir != 0 ? "TRADE CLOSED" : "WAIT") :
         flightLedgerUseBtcAdaptiveHold ?
              (flightLedgerTrailSteps <= 0 ? "BTC HOLD" :
               "PROTECT " + f_moneyText(flightLedgerLockedUsd)) :
         flightLedgerUseMetalProfitLock ?
              (flightLedgerTrailSteps <= 0 ? "WAIT +$100" :
               "+$" + str.tostring(flightLedgerLockedUsd, "#.0")) :
         flightLedgerTrailSteps <= 0 ? "WAIT +$100 BE" :
         flightLedgerTrailSteps == 1 ? "BE LOCK" :
         "+$" + str.tostring(flightLedgerLockedUsd, "#.0")

    float nextMetalLockTriggerUsd =
         flightLedgerTrailSteps <= 0 ? flightMetalProtectTrigger1Usd :
         flightLedgerTrailSteps == 1 ? flightMetalProtectTrigger2Usd :
         flightLedgerTrailSteps == 2 ? flightMetalProtectTrigger3Usd :
         flightLedgerTrailSteps == 3 ? flightMetalProtectTrigger4Usd :
         flightMetalProtectTrigger5Usd + math.max(0, flightLedgerTrailSteps - 4) * flightMetalProtectStepUsd

    float nextStandardLockTriggerUsd =
         flightLedgerTrailSteps <= 0 ? flightLedgerBeTriggerUsd :
         flightLedgerTrailSteps == 1 ? flightLedgerFirstProfitLockTriggerUsd :
         flightLedgerFirstProfitLockTriggerUsd + (flightLedgerTrailSteps - 1) * flightLedgerLockStepUsd

    float btcPeakForDash = na(flightLedgerPeakUsd) ? 0.0 : flightLedgerPeakUsd
    float nextBtcProtectTriggerUsd =
         btcPeakForDash < flightBtcProtectTrigger1Usd ? flightBtcProtectTrigger1Usd :
         btcPeakForDash < flightBtcProtectTrigger2Usd ? flightBtcProtectTrigger2Usd :
         btcPeakForDash < flightBtcProtectTrigger3Usd ? flightBtcProtectTrigger3Usd :
         btcPeakForDash < flightBtcProtectTrigger4Usd ? flightBtcProtectTrigger4Usd : na

    float nextLockTriggerUsd =
         flightLedgerUseBtcAdaptiveHold ? nextBtcProtectTriggerUsd :
         flightLedgerUseMetalProfitLock ? nextMetalLockTriggerUsd : nextStandardLockTriggerUsd

    string nextLockText =
         not whaleTradeOpen ? "--" :
         flightLedgerUseBtcAdaptiveHold and btcPeakForDash >= flightBtcProtectTrigger4Usd ? "60% PEAK" :
         na(nextLockTriggerUsd) ? "--" : "+$" + str.tostring(nextLockTriggerUsd, "#.0")
    string trailStopText = whaleTradeOpen and not na(flightLedgerTrailStopPrice) ? str.tostring(flightLedgerTrailStopPrice, format.mintick) : "--"
    string bePriceText = whaleTradeOpen ? str.tostring(flightLedgerTradeEntry, format.mintick) : entryText
    string managementRefText =
         flightLedgerUseBtcAdaptiveHold ?
              (whaleTradeOpen ? f_moneyText(btcPeakForDash) : "--") : bePriceText

    float winRate = flightMonthTradeCount > 0 ? flightMonthWinCount * 100.0 / flightMonthTradeCount : na
    float lossRate = flightMonthTradeCount > 0 ? flightMonthLossCount * 100.0 / flightMonthTradeCount : na
    float beRate = flightMonthTradeCount > 0 ? flightMonthBeCount * 100.0 / flightMonthTradeCount : na
    float safeRate = flightMonthTradeCount > 0 ? (flightMonthWinCount + flightMonthBeCount) * 100.0 / flightMonthTradeCount : na

    // Row 0 — brand/header. Every box is used.
    f_whaleCell(0, 0, "SFA 🐋", proGold, proHeader, true)
    f_whaleCell(1, 0, "WHALE ZONES", proWhite, proHeader, true)
    f_whaleCell(2, 0, syminfo.ticker, infoBlue, proHeader, true)
    f_whaleCell(3, 0, f_chartTfText(), proWhite, proHeader, true)
    f_whaleCell(4, 0, "PREMIUM", proGold, proHeader, true)
    f_whaleCell(5, 0, "V2.5", bullColor, proHeader, true)

    // Row 1 — running signal + live P/L + confidence + age + alert. No empty space.
    f_whaleCell(0, 1, runningText, whaleFlashText, whaleFlashBg, true)
    f_whaleCell(1, 1, whaleSideText, whaleFlashText, whaleFlashBg, true)
    f_whaleCell(2, 1, "LIVE P/L\n" + livePlText + "\n" + livePlPctText, livePlColor, proValueBg, true)
    f_whaleCell(3, 1, "CONF\n" + str.tostring(radarConfidence, "#") + "%", proWhite, proValueBg, true)
    f_whaleCell(4, 1, "AGE\n" + ageText, proGold, proValueBg, true)
    f_whaleCell(5, 1, "ALERT\n" + (persistentAlerts ? "ON" : "OFF"), persistentAlerts ? bullColor : bearColor, proValueBg, true)

    // Rows 2-3 — live trade data.
    f_whaleCell(0, 2, "ENTRY", proMuted, proLabelBg, false)
    f_whaleCell(1, 2, "LIVE", proMuted, proLabelBg, false)
    f_whaleCell(2, 2, "LOCK", proMuted, proLabelBg, false)
    f_whaleCell(3, 2, "TRAIL SL", proMuted, proLabelBg, false)
    f_whaleCell(4, 2, "ADX 5M", proMuted, proLabelBg, false)
    f_whaleCell(5, 2, "MARKET", proMuted, proLabelBg, false)

    f_whaleCell(0, 3, entryText, proWhite, proValueBg, true)
    f_whaleCell(1, 3, currentText, proWhite, proValueBg, true)
    f_whaleCell(2, 3, lockedText, flightLedgerTrailSteps > 0 ? bullColor : proGold, proValueBg, true)
    f_whaleCell(3, 3, trailStopText, flightLedgerTrailSteps > 0 ? bullColor : proMuted, proValueBg, true)
    f_whaleCell(4, 3, str.tostring(adx5, "#.0"), proAdxColor, proValueBg, true)
    f_whaleCell(5, 3, marketText, marketColor, proValueBg, true)

    // Rows 4-5 — EMA200 / lock management.
    f_whaleCell(0, 4, "EMA200", proMuted, proLabelBg, false)
    f_whaleCell(1, 4, "DIST", proMuted, proLabelBg, false)
    f_whaleCell(2, 4, "DIST %", proMuted, proLabelBg, false)
    f_whaleCell(3, 4, flightLedgerUseBtcAdaptiveHold ? "PEAK P/L" : flightLedgerUseMetalProfitLock ? "ENTRY REF" : "BE PRICE", proMuted, proLabelBg, false)
    f_whaleCell(4, 4, "NEXT LOCK", proMuted, proLabelBg, false)
    f_whaleCell(5, 4, "POSITION", proMuted, proLabelBg, false)

    f_whaleCell(0, 5, str.tostring(ema200, format.mintick), infoBlue, proValueBg, true)
    f_whaleCell(1, 5, (emaDist >= 0 ? "+" : "") + str.tostring(emaDist, format.mintick), emaPosColor, proValueBg, true)
    f_whaleCell(2, 5, na(emaDistPct) ? "--" : (emaDistPct >= 0 ? "+" : "") + str.tostring(emaDistPct, "#.00") + "%", emaPosColor, proValueBg, true)
    f_whaleCell(3, 5, managementRefText, flightLedgerUseBtcAdaptiveHold ? bullColor : proWhite, proValueBg, true)
    f_whaleCell(4, 5, nextLockText, proGold, proValueBg, true)
    f_whaleCell(5, 5, emaPosText, emaPosColor, proValueBg, true)

    // Rows 6-7 — monthly performance.
    f_whaleCell(0, 6, "MONTH", proGold, proSection, true)
    f_whaleCell(1, 6, "WIN", proGold, proSection, true)
    f_whaleCell(2, 6, "LOSS", proGold, proSection, true)
    f_whaleCell(3, 6, "BE", proGold, proSection, true)
    f_whaleCell(4, 6, "SAFE %", proGold, proSection, true)
    f_whaleCell(5, 6, "NET P/L", proGold, proSection, true)

    f_whaleCell(0, 7, str.tostring(flightMonthSignalCount), proWhite, proValueBg, true)
    f_whaleCell(1, 7, str.tostring(flightMonthWinCount) + (na(winRate) ? "" : " • " + str.tostring(winRate, "0.0") + "%"), bullColor, proValueBg, true)
    f_whaleCell(2, 7, str.tostring(flightMonthLossCount) + (na(lossRate) ? "" : " • " + str.tostring(lossRate, "0.0") + "%"), bearColor, proValueBg, true)
    f_whaleCell(3, 7, str.tostring(flightMonthBeCount) + (na(beRate) ? "" : " • " + str.tostring(beRate, "0.0") + "%"), proGold, proValueBg, true)
    f_whaleCell(4, 7, na(safeRate) ? "--" : str.tostring(safeRate, "0.0") + "%", na(safeRate) ? proMuted : safeRate >= 80 ? bullColor : safeRate >= 60 ? proGold : bearColor, proValueBg, true)
    f_whaleCell(5, 7, f_moneyText(flightMonthNetPl), flightMonthNetPl > 0 ? bullColor : flightMonthNetPl < 0 ? bearColor : proWhite, proValueBg, true)

    // Row 8 — section bar split into useful boxes, no blanks.
    f_whaleCell(0, 8, "LAST 5", proGold, proSection, true)
    f_whaleCell(1, 8, "WHALE", proWhite, proSection, true)
    f_whaleCell(2, 8, "TRADE", proWhite, proSection, true)
    f_whaleCell(3, 8, "HISTORY", proWhite, proSection, true)
    f_whaleCell(4, 8, "ENTRY→EXIT", infoBlue, proSection, true)
    f_whaleCell(5, 8, showFlightMonthPanel ? "FULL ON" : "FULL OFF", showFlightMonthPanel ? bullColor : proMuted, proSection, true)

    // Row 9 — history headings.
    f_whaleCell(0, 9, "DATE/TIME", proGold, proLabelBg, true)
    f_whaleCell(1, 9, "SIDE", proGold, proLabelBg, true)
    f_whaleCell(2, 9, "ENTRY", proGold, proLabelBg, true)
    f_whaleCell(3, 9, "EXIT", proGold, proLabelBg, true)
    f_whaleCell(4, 9, "P/L", proGold, proLabelBg, true)
    f_whaleCell(5, 9, "RESULT", proGold, proLabelBg, true)

    int ledgerSize = array.size(flightLedgerPls)
    for rowOffset = 0 to 4
        int row = 10 + rowOffset
        int idx = ledgerSize - 1 - rowOffset
        if idx >= 0
            int closeTime = array.get(flightLedgerCloseTimes, idx)
            int closeDir = array.get(flightLedgerDirs, idx)
            float closePl = array.get(flightLedgerPls, idx)
            float closeEntry = array.get(flightLedgerEntries, idx)
            float closeExit = array.get(flightLedgerExits, idx)
            string resultText = closePl > 0 ? "WIN" : closePl < 0 ? "LOSS" : "BE"
            color resultColor = closePl > 0 ? bullColor : closePl < 0 ? bearColor : proGold

            f_whaleCell(0, row, str.format_time(closeTime, "dd MMM HH:mm", flightLedgerTimezone), proWhite, proValueBg, false)
            f_whaleCell(1, row, closeDir == 1 ? "BUY" : "SELL", closeDir == 1 ? bullColor : bearColor, proValueBg, false)
            f_whaleCell(2, row, str.tostring(closeEntry, format.mintick), proWhite, proValueBg, false)
            f_whaleCell(3, row, str.tostring(closeExit, format.mintick), proWhite, proValueBg, false)
            f_whaleCell(4, row, f_moneyText(closePl), resultColor, proValueBg, true)
            f_whaleCell(5, row, resultText, resultColor, proValueBg, true)
        else
            for col = 0 to 5
                f_whaleCell(col, row, "--", proMuted, proValueBg, false)

    // Rows 15-16 — compact footer, all cells used.
    f_whaleCell(0, 15, "FULL HIST", proGold, proSection, true)
    f_whaleCell(1, 15, showFlightMonthPanel ? "ON" : "OFF", showFlightMonthPanel ? bullColor : proMuted, proSection, true)
    f_whaleCell(2, 15, "MAX 100", proWhite, proSection, true)
    f_whaleCell(3, 15, flightLedgerUseBtcAdaptiveHold ? "BTC HOLD +$500" : flightLedgerUseMetalProfitLock ? "PROTECT +$100" : "BE +$100", proGold, proSection, true)
    f_whaleCell(4, 15, flightLedgerUseBtcAdaptiveHold ? "TRAIL 60% PEAK" : flightLedgerUseMetalProfitLock ? "LOCK +$25" : "LOCK +$250", proGold, proSection, true)
    f_whaleCell(5, 15, "ONE ALERT", persistentAlerts ? bullColor : proMuted, proSection, true)

    f_whaleCell(0, 16, "SFA 🐋", proGold, proValueBg, false)
    f_whaleCell(1, 16, "WHALE", proWhite, proValueBg, false)
    f_whaleCell(2, 16, "PREMIUM", proGold, proValueBg, false)
    f_whaleCell(3, 16, "EMA200", infoBlue, proValueBg, false)
    f_whaleCell(4, 16, "ADX 5M", proAdxColor, proValueBg, false)
    f_whaleCell(5, 16, "ENGINE LOCKED", bullColor, proValueBg, false)

f_renderWhaleHistory() =>
    table.set_position(whaleHistoryPanel, f_dashboardPos(flightMonthPanelPosOpt))
    table.clear(whaleHistoryPanel, 0, 0, 6, 27)

    int ledgerSize = array.size(flightLedgerPls)
    int availableRequested = math.min(ledgerSize, whaleHistoryRows)
    int firstNumber = whaleHistoryPageStart + 1
    int lastNumber = math.min(whaleHistoryPageStart + 25, availableRequested)

    f_whaleHistoryCell(0, 0, "🐋", proGold, proHeader, true)
    f_whaleHistoryCell(1, 0, "WHALE HISTORY", proWhite, proHeader, true)
    f_whaleHistoryCell(2, 0, syminfo.ticker, infoBlue, proHeader, true)
    f_whaleHistoryCell(3, 0, "PAGE " + str.tostring(whaleHistoryPageSafe) + "/" + str.tostring(whaleHistoryMaxPage), proGold, proHeader, true)
    f_whaleHistoryCell(4, 0, "25 / PAGE", proWhite, proHeader, false)
    f_whaleHistoryCell(5, 0, "MAX " + str.tostring(whaleHistoryRows), proMuted, proHeader, false)
    f_whaleHistoryCell(6, 0, "NEWEST FIRST", infoBlue, proHeader, false)

    f_whaleHistoryCell(0, 1, "#", proGold, proLabelBg, true)
    f_whaleHistoryCell(1, 1, "DATE/TIME", proGold, proLabelBg, true)
    f_whaleHistoryCell(2, 1, "SIDE", proGold, proLabelBg, true)
    f_whaleHistoryCell(3, 1, "ENTRY", proGold, proLabelBg, true)
    f_whaleHistoryCell(4, 1, "EXIT", proGold, proLabelBg, true)
    f_whaleHistoryCell(5, 1, "P/L", proGold, proLabelBg, true)
    f_whaleHistoryCell(6, 1, "RESULT", proGold, proLabelBg, true)

    for rowOffset = 0 to 24
        int row = 2 + rowOffset
        int historyNumber = whaleHistoryPageStart + rowOffset + 1
        int idx = ledgerSize - 1 - (whaleHistoryPageStart + rowOffset)
        bool allowedRow = historyNumber <= whaleHistoryRows and idx >= 0
        if allowedRow
            int closeTime = array.get(flightLedgerCloseTimes, idx)
            int closeDir = array.get(flightLedgerDirs, idx)
            float closePl = array.get(flightLedgerPls, idx)
            float closeEntry = array.get(flightLedgerEntries, idx)
            float closeExit = array.get(flightLedgerExits, idx)
            string resultText = closePl > 0 ? "WIN" : closePl < 0 ? "LOSS" : "BE"
            color resultColor = closePl > 0 ? bullColor : closePl < 0 ? bearColor : proGold

            f_whaleHistoryCell(0, row, str.tostring(historyNumber), proMuted, proValueBg, false)
            f_whaleHistoryCell(1, row, str.format_time(closeTime, "dd MMM HH:mm", flightLedgerTimezone), proWhite, proValueBg, false)
            f_whaleHistoryCell(2, row, closeDir == 1 ? "BUY" : "SELL", closeDir == 1 ? bullColor : bearColor, proValueBg, false)
            f_whaleHistoryCell(3, row, str.tostring(closeEntry, format.mintick), proWhite, proValueBg, false)
            f_whaleHistoryCell(4, row, str.tostring(closeExit, format.mintick), proWhite, proValueBg, false)
            f_whaleHistoryCell(5, row, f_moneyText(closePl), resultColor, proValueBg, true)
            f_whaleHistoryCell(6, row, resultText, resultColor, proValueBg, true)
        else
            for col = 0 to 6
                f_whaleHistoryCell(col, row, "--", proMuted, proValueBg, false)

    string rangeText = availableRequested <= 0 ? "NO CLOSED TRADES" : lastNumber < firstNumber ? "NO TRADES ON PAGE" : "SHOWING " + str.tostring(firstNumber) + "-" + str.tostring(lastNumber) + " OF " + str.tostring(availableRequested)
    f_whaleHistoryCell(0, 27, "SFA 🐋", proGold, proHeader, true)
    f_whaleHistoryCell(1, 27, rangeText, proWhite, proHeader, true)
    f_whaleHistoryCell(2, 27, "", proWhite, proHeader, false)
    f_whaleHistoryCell(3, 27, "PAGE IN SETTINGS", infoBlue, proHeader, false)
    f_whaleHistoryCell(4, 27, "", proWhite, proHeader, false)
    f_whaleHistoryCell(5, 27, "ENTRY→EXIT", infoBlue, proHeader, false)
    f_whaleHistoryCell(6, 27, "NOT ZONE→ZONE", proGold, proHeader, false)

f_renderDashboards() =>
    table.clear(whaleMainPanel, 0, 0, 5, 16)
    table.clear(whaleDigitalStrip, 0, 0, 5, 2)

    if showDesktopDashboard
        f_renderWhaleMain()

    if showDigitalSignalStrip
        f_renderDigitalSignalStrip()

    if showFlightMonthPanel
        f_renderWhaleHistory()
    else
        table.clear(whaleHistoryPanel, 0, 0, 6, 27)

if barstate.islast
    f_renderDashboards()

//=============================================================================
// SFA 🐋 WHALE — ONE ALERT / ONE NOTIFICATION PER NEW SIGNAL
//=============================================================================
// TradingView setup:
// Create ONE alert using "Any alert() function call".
// That single TradingView alert remains active until the member stops/deletes it.
// Each NEW WHALE BUY sends ONE notification. Each NEW WHALE SELL sends ONE notification.
// No repeated candle reminders. No Zone-engine alerts. No BE/lock-step alert spam.

if persistentAlerts and flightBuySignalEvent
    alert("SFA 🐋 WHALE ZONES STIKE\n" + syminfo.ticker + " • " + f_chartTfText() +
         "\n🐋 WHALE BUY" +
         "\nENTRY: " + str.tostring(radarEntry, format.mintick) +
         "\nCONFIDENCE: " + str.tostring(radarConfidence, "#") + "%" +
         "\nTIME: " + str.format_time(time, "dd MMM yyyy HH:mm", "Europe/London"),
         alert.freq_once_per_bar_close)

if persistentAlerts and flightSellSignalEvent
    alert("SFA 🐋 WHALE ZONES STIKE\n" + syminfo.ticker + " • " + f_chartTfText() +
         "\n🐋 WHALE SELL" +
         "\nENTRY: " + str.tostring(radarEntry, format.mintick) +
         "\nCONFIDENCE: " + str.tostring(radarConfidence, "#") + "%" +
         "\nTIME: " + str.format_time(time, "dd MMM yyyy HH:mm", "Europe/London"),
         alert.freq_once_per_bar_close)

alertcondition(flightBuySignalEvent, "SFA 🐋 WHALE BUY",
     "SFA WHALE ZONES STIKE: WHALE BUY on {{ticker}} / {{interval}}")
alertcondition(flightSellSignalEvent, "SFA 🐋 WHALE SELL",
     "SFA WHALE ZONES STIKE: WHALE SELL on {{ticker}} / {{interval}}")

//-----------------------------------------------------------------------------
// ALERTS — LEVELS ONLY, NO TRADE SIGNALS
//-----------------------------------------------------------------------------
alertcondition(showPDH and ta.crossover(close, pdh), "SFA PDH Break", "XAUUSD crossed above Previous Day High")
alertcondition(showPDL and ta.crossunder(close, pdl), "SFA PDL Break", "XAUUSD crossed below Previous Day Low")
alertcondition(showSessionHL and not na(activeSessionHigh) and ta.crossover(close, activeSessionHigh), "SFA Active Session High Break", "XAUUSD crossed active session high")
alertcondition(showSessionHL and not na(activeSessionLow) and ta.crossunder(close, activeSessionLow), "SFA Active Session Low Break", "XAUUSD crossed active session low")


//-----------------------------------------------------------------------------