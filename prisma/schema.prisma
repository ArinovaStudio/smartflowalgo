// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccType {
  PAID
  FREE
}

enum PaymentProvider {
  SUMUP
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}
enum UserType {
  CLIENT
  INFULENCER
  ADMIN
}

model User {
  id            String    @id @default(nanoid())
  srn           Int       @unique @default(autoincrement())
  name          String?
  tradingViewId String?   @unique
  mobile        String?   @unique
  email         String    @unique
  password      String?
  image         String?
  experience    String?
  interest      String?
  planType      AccType?
  version       String?   @default("Latest")
  userType      UserType  @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  discount      Int?
  accounts      Account[]
  sessions      Session[]
  payments      Payment[] @relation("PaymentClient")
  referrals     Payment[] @relation("PaymentPromoter")

  @@index([email])
  @@index([mobile])
  @@index([tradingViewId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Payment {
  id                String        @id @default(cuid())
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String
  checkoutId        String?       @unique
  checkoutReference String        @unique
  merchantCode      String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  userId            String?
  user              User?         @relation("PaymentClient", fields: [userId], references: [id])

  promoterId        String?
  promoter          User?         @relation("PaymentPromoter", fields: [promoterId], references: [id])

  @@index([userId])
  @@index([promoterId])
}

model Plan {
  id                String   @id @default(cuid())
  name              String
  subtitle          String?
  badge             String?
  isHighlight       Boolean  @default(false)

  // Pricing mode
  hasCycles         Boolean  @default(false)

  // Single price fields (used when hasCycles = false)
  price             Int?
  billingPeriod     String?  // e.g., "3 days access" or "month"

  // Multi-cycle pricing fields (used when hasCycles = true)
  monthlyPrice      Int?     // e.g. 3499
  quarterlyPrice    Int?     // e.g. 9000
  quarterlyDiscount String?  // e.g. "Save ₹1,497"
  yearlyPrice       Int?     // e.g. 29499
  yearlyDiscount    String?  // e.g. "Save ₹12,489"

  // Features list
  features          String[]

  // Custom CTA text
  buttonText        String?

  // Order & Status
  order             Int      @default(0)
  isActive          Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}